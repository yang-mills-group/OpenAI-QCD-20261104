            let V(j:ℕ):ℝ:= (vθ j)^(E' i); have hV(j):0 < V j:=pow_pos (fan_pos ..) _
            let Φ'(j:ℕ):ℂ:= (V j:ℂ) * (F₁ i j); have ha(j:ℕ):Φ' j • (Asset.tileD (G i) (E' i) (vθ j) [] (Nc j))= Zx i j:=by change Φ' j • ((↑(Asset.game (E' i) (vθ j)):ℂ) • (G i) (Nc j))=_; rw[smul_smul]; change (((V j:ℂ)* F₁ i j)*(↑((V j)⁻¹):ℂ)) • (G i) (Nc j)=_; rw[Complex.ofReal_inv,mul_comm (↑(V j):ℂ),mul_assoc, mul_inv_cancel₀ (show (V j:ℂ) ≠0 by exact_mod_cast (hV j).ne'),mul_one]; try rfl
            let Uv':= ‖Φ i‖*(‖v‖*B); let J:= Uv'+1; have hUv : 0≤Uv':=by unfold Uv'; have hi:0≤B:=zero_le_one.trans hB; positivity
