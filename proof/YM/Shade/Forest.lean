            obtain ⟨Z,H⟩:= meeds P₀ A X E LL Θ Uv i0 ξ Fu ν Δ hθ Y hp hτ sym M N₀ K0 W' hm hM hN hK Gℓ π hVec d hPil base PV hL hOrder (G i) (E' i) (hsL i) (hZe i) Jz hD₀ hDv hKB Φ' J hJ hv
            exact ⟨Z,(show (fun j=>Φ' j • Asset.tileD (G i) (E' i) (vθ j) [] (Nc j))=Zx i from funext ha) ▸ H⟩
       have h0 : Massive.Needle.Weave ZP LΘ Θ (base d) Jz 0 (0:ℕ→Massive.UV.Label d):=by
