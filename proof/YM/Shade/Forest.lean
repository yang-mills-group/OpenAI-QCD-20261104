            have hv:∀ᶠ j in atTop, ‖Φ' j‖ ≤ J*κ j:=by
                 let θ':ℝ:=1/32; filter_upwards [h,hb.and (hp.ship.β_path.uv.tendsto_atTop.eventually (faded P₀ A hg (E' i) θ' (by unfold θ'; norm_num)))] with j hj hh -- replace
                 obtain ⟨hh,hv⟩:=hh; have hf:=yMeasure P₀ A (Y.mark j); have hj':=hj v; unfold Φ'; rw [norm_mul,Complex.norm_real,Real.norm_of_nonneg (hV j).le]; unfold F₁; rw [norm_mul]; have he:= (Φ i).le_opNorm (y j); apply le_trans (mul_le_mul (show V j ≤Real.exp (θ'* f j) from hv) (mul_le_mul hh (he.trans (mul_le_mul_of_nonneg_left hj' (norm_nonneg _))) (norm_nonneg _) (Real.exp_nonneg _)) (mul_nonneg (norm_nonneg _) (norm_nonneg _)) (Real.exp_nonneg _)); let e:= Real.exp (θ'*f j+ (u*f j+((D':ℝ)/2+1/32)*f j)); have h_:e≤ κ j:=Real.exp_monotone (by unfold θ'; nlinarith only [mul_le_mul_of_nonneg_right hz hf]);
                 calc _ = Uv'*e:= by unfold e Uv'; rw [Real.exp_add, Real.exp_add]; ring
