       let Φ(i:PlaneG.Raw D'):= (Ψb.basic.coord i).toContinuousLinearMap; let y(i:ℕ):= PV D' Vb1 i v; let F₁ (i:PlaneG.Raw D')(j:ℕ):= (α j)*(Φ i (y j)); let Zx(i:PlaneG.Raw D')(j:ℕ):= F₁ i j • (G i) (Nc j)
