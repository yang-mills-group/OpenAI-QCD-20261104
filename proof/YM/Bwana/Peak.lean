lemma stool (j:ℕ): Γt j j=1:=by simp [tollF]
lemma stepZ(m j:ℕ): (Kit.slope (A.spacing j))^Gn*Γt m (j+1)=Γt m j* (Rp (A.node j)):=by
     rw [Blazar.runway]; unfold tollF; let u:= Real.log ((A.spacing j).val:ℝ); let f:= Rp (A.node j); have hh:0<f:=zero_lt_one.trans_le (Blazar.bigT ..)
     rw [← Real.exp_add, show Gq (j+1) = Gq j +Real.log f from sum_range_succ .., Track.era]; change _ =_*f; conv_rhs=> rhs; rw [← Real.exp_log hh]
     rw [←Real.exp_add]; unfold f; congr 1; ring
include hp hh he hC hi hP hPz hGz hLZ hw hX hB hTol
lemma march_T (hm:m≤ i)(ht:j≤ m): Wχ i (p i) ≤ Wχ m (p m)*Γt m i:=by
     induction hm with
     | refl=> rw[stool,mul_one]
     | @step i h ih=>
        have hC0:=tallR P₀ A X B T Z V U W F hp hX E M₀ he Y hh C Ht O L1 hC Θ Uv i0 Gn ξ Ξ (hP i (ht.trans h)) (hLZ i (ht.trans h)) (hPz _ (ht.trans h) (Nat.le_trans (Nat.le_succ i) hi)) (hGz _ (ht.trans h) hi) v q b p hw hB hTol (ht.trans h) hi; have hg:=slight P₀ A Θ Uv i0 Gn ξ Ξ i (p (i+1)) (p i) hC0 -- variable hi `i+1 ≤ n` coerces. (Nat.le_trans (Nat.le_succ i) hi)?
        apply le_of_mul_le_mul_left _ (pow_pos (Kit.slope_pos (A.spacing i)) Gn); rw [mul_left_comm, stepZ]; exact hg.trans ((mul_le_mul_of_nonneg_left (ih (Nat.le_trans (Nat.le_succ i) hi)) (zero_le_one.trans (Blazar.bigT ..))).trans_eq (by ring))
omit hp hh he hC hi hP hPz hGz hLZ hw hX hB hTol
variable (h_:∀ᶠ i in atTop, Blazar.Wins P₀ Θ Uv i0 Gn ξ Ξ (A.node i) (A.spacing i))
include h_
open Asymptotics
lemma cruise (ε:ℝ)(he:0<ε):∀ᶠ m in atTop,∀ k, m ≤ k→ Gq k-Gq m ≤ ε * (μp k - μp m):=by
     have hX: Tendsto (fun i:ℕ=>Blazar.ℓγ (A.node i)) atTop (𝓝 0):= tendsto_inv_atTop_zero.comp (tendsto_atTop_add_const_right _ (1:ℝ) (tendsto_natCast_atTop_atTop.comp A.free))
     obtain ⟨N,hp⟩:= eventually_atTop.mp ((hX.eventually_le_const he).and h_)
     filter_upwards [eventually_ge_atTop N] with i hi k hk; induction hk with
     | refl=>simp
     | @step j hj ih=>
           let t:=Real.log ((A.spacing j).val:ℝ); have hS0:0 ≤ t:= by unfold t; exact Real.log_nonneg ((show 1 ≤ (2:ℝ) by norm_num).trans (A.per_len _)); -- semicolon triggers? fix
           have hC:Real.log (Rp (A.node j)) ≤ ε*t:= (hp _ (hi.trans hj)).2.high.trans (mul_le_mul_of_nonneg_right (hp _ (hi.trans hj)).1 hS0); rw [show Gq (j+1)= _ from (show Gq (j+1)=Gq j+Real.log (Rp (A.node j)) from Finset.sum_range_succ _ _),Track.era]; linarith only [ih,hC]
lemma draws (ε:ℝ)(he:0<ε):∀ᶠ m in atTop,∀ k, m ≤ k→ Γt m k ≤ Real.exp (((Gn:ℝ)/2+ε)*(μp k-μp m)):=by
     filter_upwards [cruise P₀ A Θ Uv i0 Gn ξ Ξ h_ ε he] with i hi j h; unfold tollF; apply Real.exp_monotone; exact (add_le_add_right (hi _ h) _).trans_eq (by ring)
lemma ransoms (m:ℕ) (ε:ℝ)(he:0<ε): ∀ᶠ i in atTop, Γt m i ≤ Real.exp (((Gn:ℝ)/2+ε)*μp i):=by
     filter_upwards [Blazar.ahead P₀ A Θ Uv i0 Gn ξ Ξ ε he h_] with i hi; unfold tollF; apply Real.exp_monotone; nlinarith only [hi, Blazar.gross_l P₀ A Θ Uv i0 Gn ξ Ξ m, Track.measure_nn A m, show 0 ≤ (Gn:ℝ) from Nat.cast_nonneg _]
