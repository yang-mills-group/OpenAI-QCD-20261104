      refine ⟨h.marked,h.posK,Off.drafted b h.border v' ht,fun L hL=>?_⟩
      obtain ⟨p,hp,hf⟩:=h.earns L hL; obtain ⟨x,hx⟩:= tenants (m:=M) P₀ A b v' L; rw [hx]; refine ⟨p,⟨hp.nameK,fun i hi=>hp.hiK i (ht.trans hi),fun i hi h z=>?_⟩,hf⟩; unfold crowns Off.carrier; rw [lank _ _ _ M z x hi h]; exact hp.priced i (ht.trans hi) h z -- arg order
