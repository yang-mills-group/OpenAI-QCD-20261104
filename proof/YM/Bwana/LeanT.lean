      have hW(t:ℕ)(ht:m ≤ t)(h:t ≤ n): Wager Aim Θ (Bloom Uv Gn) Bs t:=itinerant P₀ A X B T Z V U W F hp hX hc E M₀ he Y hh C Ht O L1 hC Θ Uv i0 Gn ξ Ξ hTol (fun i h=> hPz i (ht.trans h)) (fun i h _=>hPX.paid i (ht.trans h)) h ha0 (fun i h _=>hPX.base _ (ht.trans h)) (fun i h=> hGX i (ht.trans h)) hYt
      refine ⟨hv,hz,hb,fun l hl=>?_⟩
      let A0:=Hub.spine sym Ar l; let x0:=Off.sawC b l; have hy:= Hub.toured sym Ar qs hv l hX'
      obtain ⟨p,hP⟩:= vigilant P₀ A X B T V U W E M₀ he Y C Ht O L1 hC Θ Uv i0 Gn ξ Ξ A0 qs x0 hAim sym hf (Off.bordered b hb l) hy.1 hy.2 (hW m le_rfl (hi.trans he')) -- W
      have hz:= hP.priced j hi he' (x0 j); have hY:= hW j hi he'; let Yc:= Off.carrier (Aim) (Bloom Uv Gn) x0 j (x0 j) A0; let u:=Hub.spine sym Lo l; have hFV:= hY.journey.furnished (x0 j) (p j) qs j le_rfl he' (⇑Yc) (show Bs j (x0 j) (p j) qs Yc from ⟨he',hz⟩); have hOp:= Off.flagsV Aim Θ sym (Bloom Uv Gn) hf hAim Bs hY b Ar Lo l hx ht
      exact ⟨p,hP,Canvas.consensus Θ (x0 j) _ hFV u hOp|>.symm ▸ hw l hl⟩
