lemma tenants(L:List Axis) : ∃ x:Cover, Off.sawC (lineC (ladder P₀ A) b m v') L=lineC (ladder P₀ A) (Off.sawC b L) m x:=by
      induction L with
      | nil=> exact ⟨v',rfl⟩
      | cons u l ih=>
         obtain ⟨y,hy⟩:=ih; refine ⟨(Signed.mirror u).act y,?_⟩; unfold Off.sawC; rw [hy]; ext1 i; change (Signed.mirror u).act (_+_)= _+_; rw [Signed.act_add, Off.act_times]; rfl
lemma lank (γ:ℕ) (x:Cover)(t:Cover)(ht: γ ≤ i)(hf:i ≤ n): Off.lup (ladder P₀ A) (lineC (ladder P₀ A) b γ t) n i x=Off.lup (ladder P₀ A) b n i x:=by
      unfold Off.lup Off.lineC; rw [Off.ruler ht hf,mul_smul,show x-(b i+_)=x-b i-(ratioTo (ladder P₀ A) i γ) • t from (by abel), smul_sub]; abel
