lemma pyg (hf0:ℓ ≤ j)(hg:j ≤ i+1)(ht:j ≤ n)(u3:I): ((pY (PΨ)) j 1 fun _=>u3)= strum P₀ A B V U W M₀ Uv Gn (n:=n) (fun i=>P1 i u3) (fun i=>P2 i u3) (b u3) (k:=k) (w:=w) (s:=s) j (Bt! j u3):=by
      let P:= paintK P₀ A B Ψ1 (plusE I); unfold pathK; rw[show soloK P₀ A B (PΨ) 1 (fun _=>u3)= P u3 from (by simp [soloK,P]), show P u3=_ from beads P₀ A B Uv Gn ℓ P1 P2 b χ0 u3,mul_sub,map_sub]; unfold strum crowns Off.carrier
      let P1v(t:ℕ):=pits P₀ A ℓ χ0 t u3; have hu:P1v j=lineC (ladder P₀ A) (b u3) ℓ (χ0 u3) j:=by unfold P1v pits; rw [lineC,lineC,hb u3 _ hg]
      rw [show lup Qv 0 n j (P1v j)=Bv n (u3,false) from ledger 0 (χ0 u3) hf0 ht]
      rw [show lup Qv (b u3) n j (P1v j)=Bv n (u3,true) from (by rw [hu]; exact ledger _ _ hf0 ht)]
      suffices h :∀ c f:Side,∀ h:c=f,∀ x y:Insertion c 6, transit h (⇑(x-y))= transit h x-transit h y by exact h _ _ _ _ _
