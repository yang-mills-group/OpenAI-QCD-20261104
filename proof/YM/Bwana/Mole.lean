      unfold soloK; rw [h m q,mul_smul_comm,map_smul]
      suffices hx: ∀ c f:Side,∀ h:c=f,∀ z:ℂ,∀ F₀:Insertion c 6, transit h (⇑(z • F₀))=z • transit h F₀ by exact hx _ _ _ _ _
