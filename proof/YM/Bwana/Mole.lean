lemma scaler (ρ:I→ℝ): pathK P₀ A B V U W M₀ (n:=n) (k:=k) (s:=s) (w:=w) (fun x=>(ρ x:ℂ) • Ψ x) i=Talent.scale ρ ((uP Ψ) i):=by
