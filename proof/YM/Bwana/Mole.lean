      rw [he]; refine sum_congr rfl (fun b _=>?_); rw [mul_smul_comm,map_smul, show ∀ (Z:ℂ) (F:Fᴹ), transit (RH i) (⇑(Z • AllAt Aim i F))=Z • transit (RH i) (AllAt Aim i F) from ?_]; swap
