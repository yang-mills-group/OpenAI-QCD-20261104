lemma sp_yes(h:j ≤ i)(ht:i < n)(b c:ℕ→ Cover)(hB:Borders Qv j n b)(hĈ:Borders Qv j n c)(hm:(Pt i).B^2 ≤ Lattice.separation (wrap (cN i) (b i)) (wrap (cN i) (c i))): (Pt (i+1)).B^2 ≤ Lattice.separation (wrap (cN (i+1)) (b (i+1))) (wrap (cN (i+1)) (c (i+1))):=by
      let R:= ((A.flight i).visit Kz (A.next (B.n k) i)).ratio; let L:= (A.spacing i).val; have ho : Odd R.count.val:= (A.flight i).odd
      let p:= wrap (cN i) (b i); let q:= wrap (cN i) (c i); let P':= wrap (cN (i+1)) (b (i+1)); let Q':=wrap (cN (i+1)) (c (i+1)); have hy:=YM.Intag.Film.chin R ho P' Q'; rw[show R.parent P'= p from ?_,show R.parent Q'=q from ?_] at hy
      · have hv(i:ℕ):(Pt i).B=(radiusB (Track.scale A x i)):=by rw[(waking P₀ A (hX i)).ball]; exact congr_arg radiusB (augmented ..)
        have hh:= (Counter.evolves P₀ A hY i).1; rw [← hv,← hv] at hh; apply hh.trans; let k:=(Pt i).B^2; change 2*k ≤ _; have he: L*k≤ L + separation P' Q':=(Nat.mul_le_mul_left L hm).trans hy; have hβ:32 ≤ (Pt i).B:= (waking P₀ A (hX i)).ball ▸ (hY i).budget
        have hm:3 ≤ k:=le_trans (by norm_num : 3≤32^2) (Nat.pow_le_pow_left hβ _); have hf:3 ≤L:= (A.flight i).coarse
        have h':2*k+L ≤ L*k:=by nlinarith only [hf,hm]
        exact Nat.le_of_add_le_add_left (le_trans ((add_comm L (2*k)).le.trans h') he)
      · rw [show Q'=wrap (cN (i+1)) (c (i+1)) from rfl,Streets.owner]; exact congr_arg _ (hĈ _ h ht)
      rw [show P'=wrap (cN (i+1)) (b (i+1)) from rfl,Streets.owner]; exact congr_arg _ (hB _ h ht)
