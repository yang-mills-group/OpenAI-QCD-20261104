lemma takes (M:ℕ→ℕ)(h:∀ x:I,Borders (ladder P₀ A) ℓ n (fun i=>p i x))(hz:Fires (Φ ℓ) m)(ht:∀ i:ℕ,ℓ ≤ i→i ≤ n→ m ≤ M i)(hp:∀ s∈Q,Spaced (Φ ℓ) s (Pt ℓ).B):Croft P₀ A B p M Q ℓ n (Pt:=Pt) (k:=k):=by
       refine ⟨h,fun i h' hi s hS=>?_,fun i ht' hi j=> le_trans (fires_yes P₀ A B p ℓ h hz ht' hi j) (ht i ht' hi)⟩ -- Kζ hist A implicitly K? 
       induction h' with
       | refl=> exact hp _ hS
       | @step i hι ih=>
          have hu:= ih (Nat.le_of_lt hi); intro x hx y hy h'; rw[←sq]; exact sp_yes P₀ A B (k:=k) hX hY hι hi (fun i=>p i x) (fun i=>p i y) (h x) (h y) (by rw[sq]; exact hu x hx y hy h') -- sig
