lemma fires_yes (h:∀ x:I,Borders Qv ℓ n (fun i=> p i x))(hf:Fires (Φ ℓ) m)(he:ℓ ≤ i)(hi:i ≤ n) : Fires (Φ i) m:=by
      induction he with
      | refl=> exact hf
      | @step i hι ih=>
         have hP:= ih (Nat.le_of_lt hi); intro u
         let R:= ((A.flight i).visit Kz (A.next (B.n k) i)).ratio; let v:= R.parent u; refine le_trans ?_ (hP v); refine card_le_card (fun x hx=> mem_filter.mpr ⟨mem_univ _,?_⟩); have heq: R.parent (wrap (cN (i+1)) (p (i+1) x))= wrap (cN i) (p i x):=by rw [Streets.owner]; exact congr_arg _ (h x _ hι hi)
         exact heq.symm.trans (congr_arg _ (mem_filter.mp hx).2)
