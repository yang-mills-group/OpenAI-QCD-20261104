variable {I:Type} [Fintype I] (q:I→Bool) (x:I)
local notation "YI"=> I × Bool
abbrev vines (I:Type): Set (Finset (I×Bool)) := {s | Set.InjOn Prod.fst (↑s : Set (I × Bool))}
abbrev stems (I:Type)(x:I×Bool)(y:I):Prop:= x.1=y
lemma promise : Pledge (q∘Prod.fst) q (stems I) (Tiler.square I) (vines I):=by
      have hh: Hyp (stems I) (Tiler.square I):=⟨Set.mem_univ _,fun _ j _ _=>Set.mem_univ _,fun _ i j k _ _ _ h1 h2=> h1.symm.trans h2⟩
      refine ⟨hh,fun i j h=>congr_arg q h,?_⟩
      intro s u h; intro x hx y hy he
      let T:=findV (stems I) u
      obtain ⟨z,hz⟩:= Option.ne_none_iff_exists'.1 (h.2.1.2 _ hx); obtain ⟨t,ht⟩:= Option.ne_none_iff_exists'.1 (h.2.1.2 _ hy)
      have hp:= (findG _ hh _ _ h.1).1 hz; have hv:= (findG _ hh _ _ h.1).1 ht; refine h.2.1.1 hx hy ?_
      change T x=T y; change T x=_ at hz; change T y=_ at ht; rw [hz,ht]; exact congr_arg some (hp.2.symm.trans (he.trans hv.2))
@[simp] lemma base0 :∅∈ vines I:=by simp [vines]
@[simp] lemma base1 (x:YI): {x}∈vines I:=by simp [vines]
lemma growV (s t:Finset YI)(h:s∈vines I)(ht:t ⊆ s) : t∈ vines I:= (h:Set.InjOn _ _).mono ht
lemma quotaT (j:YI): (opts (stems I) j).card≤1:=by unfold opts; exact card_le_one.mpr (fun x hx y hy=> ((mem_filter.mp hx).2).symm.trans (mem_filter.mp hy).2)
noncomputable def emerge : Bool≃MassiveQCD.Sample.LoomT.To (stems I) x:={ toFun:=fun b=> ⟨(x,b),rfl⟩, invFun:= fun y=> y.val.2,left_inv:= fun _=>rfl,right_inv:=fun y=> Subtype.ext (Prod.ext y.property.symm rfl)}
