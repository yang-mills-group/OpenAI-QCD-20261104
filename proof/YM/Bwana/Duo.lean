-- charge required 2*Fi.K Boot voter
lemma lagV (t:I→Site c)(q:ℕ) (h:Fires t q) : Fires (t∘ (Prod.fst:I ×Bool → I)) (2*q):=by
      intro i; let s:= univ.filter (fun j:I=> t j=i); have hx:= h i
      have hh:(Finset.univ.filter (fun j:I ×Bool=>t j.1=i))=s×ˢ(Finset.univ):= by ext x; simp [s]; -- ext unfolds prod?
      change (Finset.univ.filter (fun j:I×Bool=>t j.1=i)).card ≤ _; rw[hh,card_product, card_univ,Fintype.card_bool,Nat.mul_comm s.card]; gcongr
-- geometry.Clock.
include hF
lemma goals1 (hc:∀ v:YI, Carrier.cellar (A.spacing i) (p₁ v)=p v.1)(hpM:2*M ≤j) (hb:Spaced (OP) Finset.univ m) : Fires (OP) j ∧ Fires (OP₁) j∧ Fires ((S★).ratio.parent ∘ OP₁) j ∧ (∀ s∈ vines I,Spaced ((S★).ratio.parent ∘ OP₁) s m) ∧ (∀ s∈Tiler.square I,Spaced (OP) s m) ∧∀ v:YI,∀ t:I, stems I v t→ separation ((S★).ratio.parent ((OP₁) v)) ((OP) t) ≤ i0 ∧ Laurent.size (Carrier.cellar (A.spacing i) (p₁ v)-p t)≤ i0:=by
      have he : (S★).ratio.parent∘ OP₁= (OP) ∘ (Prod.fst):=funext fun x=> (Streets.owner (S★).ratio _).trans (congr_arg _ (hc x))
      have h: Fires ((S★).ratio.parent∘ OP₁) j:=by rw[he]; exact fun i=> (lagV _ _ hF i).trans hpM
      refine ⟨fun u=>(hF u).trans (le_trans (by omega) hpM),fun v=>?_,h,fun s hs=> ?_,fun _ _ t _ u _ h=> hb _ (mem_univ _) _ (mem_univ _) h,fun v t he'=>?_⟩
      · apply le_trans _ (h ((S★).ratio.parent v)); exact card_le_card (fun x hx=> mem_filter.mpr ⟨mem_univ _,congr_arg _ (mem_filter.mp hx).2⟩)
      · rw [he]; exact fun v hv t ht he => hb _ (mem_univ _) _ (mem_univ _) (fun hp=> he ((hs:Set.InjOn _ _) hv ht hp))
      change v.1=t at he'; subst t; refine ⟨?_,?_⟩
      · have ht:(S★).ratio.parent ((OP₁) v)= (OP) v.1:= congr_fun he v; rw [ht,separation_self]; omega
      rw [hc v,sub_self]; simp [Laurent.size]
end
