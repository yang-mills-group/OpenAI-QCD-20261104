    let z:= Comet.shadeM S h xiY yi p q t; let j0:= Comet.veto (x₀:=xᵃ) S h xiY
    have hh:= hV _ I E₁ X g {x₁} (fieldD xiY yi) j0 z (singleton_nonempty _) (tin S h K xiY yi p q hV₂ hV₃ hV₁ B.Pq pF t αH τ.t (τ.alpha+1) X hWW Z A hO ht)
    obtain ⟨D₁,D₂,h₁,h₂,D,hζ,hρ,H⟩:=hh
    refine ⟨D₁,D₂,h₁,h₂,D,?_, hρ,⟨fun i U s=> H i U s⟩⟩
