namespace ClaimP
variable {G:Set (Rank→Insertion c N)} {W W' Y':Rank→ Insertion c N}{u v u' v':ℝ}
lemma boxed (h:0 ≤u)(hv:0≤v):ClaimP G Y' 0 u v:=⟨0,0,by simpa, Worth.nothing _ hv,by simp⟩
lemma place (h:ClaimP G Y' W u v)(hs:ClaimP G Y' W' u' v'): ClaimP G Y' (W+W') (u+u') (v+v'):=by
    obtain ⟨x,U,ha,hp,h⟩:=h.costP; obtain ⟨y,V,hb,hq,he⟩:=hs.costP; exact ⟨x+y,U+V,(norm_add_le ..).trans (add_le_add ha hb),Worth.added hp hq,by rw [h,he,add_smul]; abel⟩
lemma era (h:ClaimP G Y' W u v)(he:u≤u')(hf:v ≤ v'): ClaimP G Y' W u' v':=by obtain ⟨p,Z,hp,hq,h⟩:=h.costP; exact ⟨p,Z,hp.trans he,hq.fuel hf,h⟩
lemma plat (X:I→ Rank→ Insertion c N)(u v:I→ℝ)(S:Finset I)(h:∀ i∈S,ClaimP G Y' (X i) (u i) (v i)): ClaimP G Y' (∑ i∈S,X i) (∑ i∈S,u i) (∑ i∈S,v i):=by
    induction S using Finset.induction_on with
    | empty=> simp only [sum_empty]; exact boxed le_rfl le_rfl
    | insert i S he ih=> rw [sum_insert he,sum_insert he,sum_insert he]; exact ClaimP.place (h i (mem_insert_self ..)) (ih fun j hj=> h j (mem_insert_of_mem hj))
lemma singleB (z:ℂ)(hz:‖z‖≤ u): ClaimP G Y' (z • Y') u 0:=⟨z,0,hz,Worth.nothing _ le_rfl,(add_zero _).symm⟩
lemma replen (H:ClaimP G Y' W u v) (z:ℂ): ClaimP G Y' (z • W) (‖z‖ *u) (‖z‖*v):=by obtain ⟨x,V,hX,hV,hf⟩:= H.costP; exact ⟨z*x,z • V,by rw [norm_mul]; exact mul_le_mul_of_nonneg_left hX (norm_nonneg _), Worth.rotate z hV,by rw [hf,smul_add,mul_smul]⟩
end ClaimP
-- floor affine approximate space. union measure gift. Includes all lanes inv in backend.
structure Invoice (D:DeckV c N)(M:PCAC.Deck c N)(a:ℕ)(A:TokenP)(X:Insertion c N)(α:ℂ)(p q:ℝ):Prop where
    scope:∀ x y,a< separation x y→∀ i j:Dye N,cargo M x y i j=0
    income:∀ x y:Site c,separation x y ≤ a →∀ i j:Dye N, ClaimP (aisle A D x y α) (performance X x y) (cargo M x y i j) p q
variable {M:PCAC.Deck f N}{u v:ℝ} (X₀:Grass.Ward.Sour (Modes c N)) (i j':Dye N)(s:Rank)
-- onsite coefficient require diagonal in SITE and color.Currency.We.P.
variable (Z:Spike)(a b:Flavor N) (uB:ℝ)(hZ:∀ i j, ‖Z i j‖ ≤ uB)
lemma self_apo (W:Grid c): apogee x x W=1:=by
    have he: cord x x=[]:= List.length_eq_zero_iff.mp (show _=0 from Nat.le_zero.mp (cord_len (m:=0) x x (by simp)|>.trans_eq (mul_zero _))); unfold apogee; rw [he,travel]; exact su.mat_one
local notation "Γp"=> flavorW Z a b c
lemma stake_bore (U:Grid c): cargo (bore (Γp) Y) x y i j' s U= if x=y then (Z i.1 j'.1 * ((1:Mat) s.1 s.2) * spot a b i.2 j'.2) • Y U else 0:=by
     change flavorW Z a b c _ _ • Y U=_; unfold flavorW onSpin; by_cases he:x=y
     · subst y; rw [if_pos rfl]; apply congr_arg (· • Y U); change (Lat.rides _ _) _ _ * spot _ _ _ _ = _; rw [rr]; change (if x=x then _ else (0:ℂ))*spot a b i.2 j'.2 = _; rw [if_pos rfl]; rfl
     rw[if_neg he]; change ((Lat.rides _ _ (x,_) (y,_) :ℂ)*_) • Y U=0; rw [rr]; change ((if x=y then _ else (0:ℂ))*spot a b i.2 j'.2) • Y U = _; rw [if_neg he, zero_mul,zero_smul]
lemma emptyB (he:x≠y): cargo (bore (Γp) Y) x y i j'=0:=funext fun i'=>ContinuousMap.ext fun U=>(stake_bore Y x y i j' i' Z a b U).trans (if_neg he)
lemma closeB (i' : Dye N): cargo (bore (Γp) Y) x x i i'= (Z i.1 i'.1 * spot a b i.2 i'.2) • performance Y x x:=by
    ext1 s; refine ContinuousMap.ext ?_; intro U; rw [stake_bore,if_pos rfl]; change _=(Z i.1 i'.1* spot a b i.2 i'.2) • (apogee x x U s.1 s.2 • Y U); rw [self_apo,smul_smul]; apply congr_arg (· • Y U); ring
include hZ
lemma budget_bore : ClaimP Zr sR (cargo (bore (Γp) Y) x y i j') uB 0:=by
    by_cases h:x=y; swap; · rw [emptyB _ _ _ _ _ _ _ _ h]; exact ClaimP.boxed ((norm_nonneg _).trans (hZ 0 0)) le_rfl
    subst y; rw [closeB]; apply ClaimP.singleB; rw [norm_mul]; unfold spot; split; rw [norm_one,mul_one]; exact hZ ..; rw [norm_zero,mul_zero]; exact (norm_nonneg _).trans (hZ 0 0)
omit hZ
local notation "ζr"=> (r:ℂ)⁻¹^2
local notation "Aq"=> toward L K d β r hk (Γp) Y M
local notation "Θv"=> choiceV L d K x y
local notation "Jk"=> berthD j
variable (hM:Invoice D' M (berthD j) V₀ X α u v)
-- for ANY previous borne Book.Concert normalized input LBulse. Norm grants universal End.Tick.Fe.State. Work.W.R.G.
variable (he:Y= (Transfer.blockMap L K d β r hk) X) (hp:∀ i,X i=α • D'.density i)
variable (hv:2*L.patch.radius<f.val)
include hM hk
lemma wit : cargo (Aq) x y i j'= ζr • (cargo (bore (Γp) Y) x y i j'+ ∑ k∈ Θv, billow L d K r β hk x y k.1 k.2 (cargo M k.1 k.2 i j')):=by
   rw [← quiltV L d K β r hk x y i j' M hM.scope]; rfl
omit hM hk
variable (Z₁ Z₂:ℂ)(h1: Z₁≠0)(h2: Z₂≠0)
noncomputable abbrev strideL (j:ℕ)(L0:Side):= (arctic L0 j+arctic L0 j+1)^4*(berthD j+berthD j+1)^4
local notation "M₀"=> (scale L.L)
local notation "s'"=> (strideL j L.L : ℝ)
include hM hZ hk he hv h1 h2
variable (hA:∀ (x y:Site c)(p:Site f×Site f),p∈ choiceV L d K x y →∀ F∈ aisle V₀ D' p.1 p.2 α, Z₁ • (billow L d K r β hk x y p.1 p.2 F)∈ aisle V D x y (α*C))
variable (hB:∀ (x y:Site c)(p:Site f×Site f),p∈ choiceV L d K x y→(fun i=> rebirth L d K r β hk X x y p.1 p.2 Z₂ i)∈ aisle V D x y (α*C))
include hA hB
lemma rendez (hu:0≤u)(hv':0 ≤ v) (hu₀ : ‖ζr‖*(uB+s'*(u*M₀^2)) ≤ u)(hv₀: ‖ζr‖* (s'*(u*‖Z₂⁻¹‖+v*‖Z₁⁻¹‖))≤ v): Invoice D Aq Jk V Y (α*C) u v:=by
     constructor
     · intro x y hh i j'; rw [wit D' L d K r β hk X Y x y α V₀ i j' Z a b hM,faded L d K x y hh,sum_empty, emptyB Y x y i j' Z a b (fun hp=>by subst y; simp at hh), add_zero, smul_zero]
     intro x y Hq i j'
     have hx(p)(h:p∈ choiceV L d K x y):=noted D D' L d K r β hk X Y x y p.1 p.2 C α V V₀ Z₂ Z₁ u v (cargo M p.1 p.2 i j') (hM.income p.1 p.2 ((Finset.mem_filter.mp h).2.1) i j') he (hA x y p h) (hB x y p h) h2 h1 hv
     have hz := budget_bore D Y x y C α V i j' Z a b uB hZ; let w':= scale L.L; let ε:=u* ‖Z₂⁻¹‖+v*‖Z₁⁻¹‖
     let p:= choiceV L d K x y
     have h: (p.card:ℝ) ≤ (strideL j L.L:ℕ):= Nat.cast_le.mpr (census L d K x y)
     rw [wit D' L d K r β hk X Y x y α V₀ i j' Z a b hM]
     refine ClaimP.era (ClaimP.replen (ClaimP.place hz (ClaimP.plat _ (fun _=>u*w'^2) (fun _=>ε) p hx)) _) (?_) (?_); · rw [sum_const,nsmul_eq_mul]; exact le_trans (mul_le_mul_of_nonneg_left (add_le_add_right (mul_le_mul_of_nonneg_right h (mul_nonneg hu (sq_nonneg _))) _) (norm_nonneg _)) hu₀
     rw [sum_const,nsmul_eq_mul,zero_add]; exact (mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right h (add_nonneg (mul_nonneg hu (norm_nonneg _)) (mul_nonneg hv' (norm_nonneg _)))) (norm_nonneg _)).trans hv₀
end YM.QCD.Comet
