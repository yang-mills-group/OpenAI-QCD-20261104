       let L:=L0; let F:=Fσ; let G:=fun x=> Tψ x; let A:= ‖VtP.toContinuousLinearMap‖*(Fintype.card (Stokes 10)*Vk.J)
       obtain ⟨a,hp⟩:=k_rateF P₀ Θ Uv i0 ξ Fu Q Vτ Ω C₁ B₁ S₀ εr -- check E unused
       obtain ⟨b,d,a,h,hX⟩:=MintV.pocketF L Vτ F G A Cν a_ hp hP hσ_; refine ⟨b,d,a,h,?_⟩
       have hz:Tendsto (fun x=>(Wtℓ x)⁻¹) atTop (𝓝 0):=tendsto_inv_atTop_zero.comp (tonicV L0 (show 1<(L0).val from lt_of_lt_of_le (by norm_num:1<3) (Q.fixed 0).flight.coarse) (show 0<Vτ.e from Nat.lt_of_lt_of_le (by norm_num) Vτ.extent))
       filter_upwards [hX,(hz.const_mul 2).eventually_le_const (show _< Vk.l from (by rw [mul_zero]; exact Vk.breadth : (2:ℝ)*0<Vk.l)), (hz.const_mul 200).eventually (gt_mem_nhds (show _<Vk.e from (by rw [mul_zero]; exact Vk.far : (200:ℝ)*0<Vk.e))),vintageP L Vτ,Kites.framesC L θ (P₀ K1).lead,aheadΩ L _ (Delay.shift_pos su L)] with x hx hg ht hh hz' hp; refine ⟨hx.2.1,hx.1, ⟨hg,ht⟩,hz'.2.1,hh,mul_nonneg (by norm_num) (hp _).le,?_ ,hx.2.2.1,(le_of_eq ?_).trans hx.2.2.2⟩
       · have hL: Pressure.betaF su x L >0:=by simpa only [riseV,Nat.cast_zero,zero_mul,add_zero] using hp 0
         have hh:0< Pressure.fiery su x L:=Work.E09.temp_pos hL -- name
