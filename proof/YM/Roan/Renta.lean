lemma k_rateF :∃ a:ℝ,Rate su L0 a (fun x=> Tψ x):=by
    let L:= L0; let F:= quaT P₀ Q Vτ; have hX : Rate su L 1 (fun x=> 2*(run L (Qμ x))):=(roseR L Rate.hat (fun x=>Vζ x) ((vintageP L0 Vτ).mono fun i h=> Nat.le_step h)).mul_left 2
    have hB: Rate su L 1 (fun x=> Real.sqrt (βp x)):=by
         have hh:Tendsto (fun x=> run L (Qμ x)) atTop atTop:=tendsto_atTop.2 (fun _=> (aheadΩ L _ ((Work.E09.betaF_growth su L).eventually_ge_atTop _)).mono fun i h=>h _)
         refine hX.compare ?_; filter_upwards [hh.eventually_ge_atTop 1] with x hx; have hp:1 ≤ βp x:= by
             linarith only [show (1:ℝ)≤run L0 (Qμ x) from hx]
         change |Real.sqrt _|≤ |βp x|; let u:=βp x; rw [abs_of_nonneg (Real.sqrt_nonneg _),abs_of_nonneg (zero_le_one.trans hp)]; change Real.sqrt u≤ u; exact Real.sqrt_le_iff.mpr ⟨zero_le_one.trans hp,by nlinarith only [show 1 ≤u from hp]⟩ -- name
    have hT:Rate su L 0 (fun x=> Tq x):= roseR L (Rate.rpow_monitor θ) (fun x=>Vζ x) ((vintageP L0 Vτ).mono fun i h=>Nat.le_step h)
    have hΓ:Rate su L 0 (fun x=>Γℓ x):=((rateMeasure L Vτ.ν).pow Vτ.H).weaken (by norm_num)
    have hF (X:Glyph Dd) : Rate su L (X.gauge:ℝ) (fun x=>|F X x|):=by
         have h:Rate su L (X.gauge:ℝ) (F X):= (((hΓ.pow _).mul (hB.pow _)).mul (hT.pow _)).weaken (by norm_num)
         refine h.compare (Eventually.of_forall fun i=>by simp)
    have hsum(Ω:Finset (Glyph Dd)): ∃ a,Rate su L a (fun x=>∑ X∈ Ω,|F X x|):=by
          induction Ω using Finset.induction_on with
          | empty=> simp only [Finset.sum_empty]; exact ⟨_,Rate.const _⟩
          | @insert v u h ih => obtain ⟨b,hp⟩:=ih; simp_rw[Finset.sum_insert h]; exact ⟨max b v.gauge, ((hF v).weaken (le_max_right ..)).add (hp.weaken (le_max_left ..))⟩
    obtain ⟨a,h⟩:= hsum Ω; obtain ⟨a',ht,hp⟩:= riches (d:=10) (L:=L0); exact ⟨_,h.mul ((((hp.mul_left S₀).mul ((bootPrice L0 Vτ (cutκ)).mul_right B₁))).mul_right _)⟩
