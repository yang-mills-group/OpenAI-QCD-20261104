lemma sfere :∀ᶠ x in atTop,∃ (ηN Mn:ℕ)(wΦ At T0 M0 vT C₁ B₁ S₀ bPd bQd:ℝ)(Lψ: (Axis→Massive.UV.Label 10)→ₗ[ℂ](Axis→Massive.UV.Label 10))(D' Ct:ℝ)(i₁ i₂ i₃:ℕ)(Fz:ℕ→ℝ)(F₁ T₁ X₁:Flavor 6→ℝ), GoldPlan P₀ E Θ Uv i0 ξ Fu Q sy M Ue α ηN Mn wΦ At T0 M0 vT Vτ Ω₀ Hb Vk C₁ B₁ S₀ bPd bQd εr Lψ D' Ct i₁ i₂ i₃ Fz F₁ T₁ X₁ kv x:=by
        obtain ⟨At,hAt,hΨ⟩:=Tantra.leafB (J dV) (ξ 10).n (ξ 10).k; let V:=(Q.fixed 0).fare; obtain ⟨Mn,hMn⟩:=hΨ V _ (Q.fixed 0).supporting.applause.rates; obtain ⟨wξ,hξ,hSt⟩:= Oren.honest (ξ 10).n (ξ 10).k; obtain ⟨M₀,hM₀⟩:= Surge.scaleT (ξ 10).n (ξ 10).k
        obtain ⟨T,hT⟩:= sines_K P₀ Θ Uv i0 ξ Fu Q α; let L:= L0; obtain ⟨vT,hvt,hAff⟩:= QCD.Entr.Meridian.hires (σ:=25/256) L (J dV) (Q.fixed 0).supporting.applause.rates (ξ 10).n (ξ 10).k (by norm_num) -- args
        let A:= α 10 K1; let C₀:= Kπ; let k:=Kit.slope L; have hp:0 ≤ C₀:=by unfold C₀; positivity [(Ξ).award.funds,(Ξ).award.light,(Fu8).funds K1]
        choose T₁ F₁ X₁ h₁ using fun i:Flavor 6 => boughtB (rank dV) (J dV) Θ.T i; have hθ:= (P₀ K1).lead; have h₀ := zero_le_one.trans hAt
        obtain ⟨F,hF,hN,hFare⟩:= costsF P₀ E Θ Uv ξ Q M wξ At T M₀ vT hvt h₀ hM₀.nng hT.p hθ; have hk := hT.p; let s:=Signature; obtain ⟨C',D',hS⟩:= Stair.lodging; have hx:3 ≤ (L.val:ℝ):= by exact_mod_cast (Q.fixed 0).flight.coarse
        obtain ⟨i₂,hK₂⟩:= (giftX k A C₀ L.val C' D' F (Kit.slope_pos _) (zero_le_one.trans ha) hp hx hF (Eventually.of_forall hN) hS).exists; obtain ⟨i₃,hK₃⟩:= hK₂.exists; obtain ⟨i₁,hK₁⟩:=hK₃.exists; obtain ⟨ηN,Hη,hR⟩:= (hK₁.and (eventually_ge_atTop 2)).exists
        obtain ⟨C,B,S₀,hq⟩:= lunat Ω₀; obtain ⟨Lψ,hL⟩:= Onyx.starP; obtain ⟨hXp,hzp⟩:= abilityV P₀ Q D' (zero_lt_one.trans_le hS.ng) i₁
        let p':= allowance_v P₀ Q D' i₁
        obtain ⟨b,d₀,a,hb,hκ⟩:= dynes P₀ Θ Uv i0 ξ Fu Q sy Vτ Ω₀ Hb Vk C B S₀ εr ‖Lψ.toContinuousLinearMap‖ hq.heavy hq.tall hq.pay he VtP 0 p' hzp hXp -- order
        let Tz:=fun i=> ℓ★ i
        have ht : ∀ᶠ x in atTop,Tz x ≤ distV L0 (Vτ.ν+1) x:= (massΘ L Vτ).mono (fun x hx=> le_trans ((Nat.sub_le _ _).trans (Nat.le_succ _)) hx)
        let u:=fun x=> skimP L b x
        have hd:=risesX P₀ E Θ Uv ξ Q M wξ At T M₀ vT hvt h₀ hM₀.nng hk hθ a kv u Tz Vτ.e (Vτ.ν+1) (hκ.mono fun i hi=> hi.opens) hb ht -- syntax
        have H(i:Flavor 6):= ((cost_press P₀ E Q hθ bail1 (F₁ i) (X₁ i) i₁).and ((cost_press P₀ E Q hθ gain2 (F₁ i) (X₁ i) i₁).and (cost_press P₀ E Q hθ 16 (F₁ i) (X₁ i) i₁))) -- order
        have htE:Tendsto (fun x=> nz! x) atTop atTop:= tendsto_atTop_mono (fun x=>Nat.le_succ _) (Work.E01.radiusB_tendsto.comp (Work.E09.betaF_growth su L))
        have HH :∀ᶠ x in atTop, (U! x) ≤1:= (ratio_v L hθ 0 le_rfl).mono fun i hi=> hi.2.2.1
        have hpN:∀ᶠ i in atTop, 20* (ep ηN i)≤1/4:=by
               filter_upwards [(MintV.notable L ηN hR).eventually_le_const (show (0:ℝ)<1/80 from by norm_num)] with i hX
               let p:=ep ηN i; have ht:p ≤1/80:= (le_mul_of_one_le_left (show 0 ≤p from (by unfold p; unfold Stair.costB; positivity)) (show 1 ≤(↑(nz! i):ℝ) from by simp)).trans hX; linarith only [show ep ηN i≤1/80 from ht]
        filter_upwards [htE.eventually Hη,hFare,hd,hκ,aheadΩ L _ hAff,bold_quell P₀ Θ Uv i0 ξ Fu Q M Ue α ηN Mn At T hT (hMn L) hR hθ,wealthPost P₀ E Θ Uv ξ Q M wξ At T M₀ vT hvt h₀ hM₀.nng hk hθ,aheadΩ L _ (Basal.bakeAble L),eventually_all.mpr H,MintV.treaties (θ:=θ) L ηN,hpN,Calendar.letsV P₀ Q ηN,HH] with x hη hF ht hD hAff hpY hW hW₁ hX hp hM hU hTg
        have hw: (U! x)* (ep i₁ x) ≤ ep i₁ x:=mul_le_of_le_one_left (hη.cal.le) hTg
        refine ⟨ηN,Mn,wξ,At,T,M₀,vT,C,B,S₀,b,d₀,Lψ,D',C',i₁,i₂,i₃,F,F₁,T₁,X₁,h₁,hη, fun i=> (?_),hF,hW,hT,hpY,hW₁ _,hL,ht,hD,hq,hM,(fun i h=> hp i (h.trans (Nat.le_succ _))),hU, ⟨(hX (0:Flavor 6)).1.1,(hX (0:Flavor 6)).1.2.1⟩,hAff _,hvt,hAt,hM₀,hξ,fun V c p t h1 h2=>hSt V t h2 h1 c p⟩ -- order he.post halo
        obtain ⟨h,h₁,h₂⟩:=hX i; exact ⟨h.2.2.trans_le hw, h₁.2.2.trans_le hw,h₂.2.2.le⟩
