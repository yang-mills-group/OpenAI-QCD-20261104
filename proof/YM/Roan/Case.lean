       change U∞ *((|u*v^2|+1)*_) ≤ U∞*((r+1)*T0^10)*v^2; rw [abs_mul,abs_of_nonneg (sq_nonneg v)]; apply le_trans (mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right (add_le_add (mul_le_mul_of_nonneg_right hz (sq_nonneg _)) hw) (by positivity)) hu.le); exact le_of_eq (by ring)
