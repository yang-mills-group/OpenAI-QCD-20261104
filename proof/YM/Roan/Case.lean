       let F(i:ℕ):ℝ:= U∞ *((C*(8*i)^N+1)*T0^10); have hu:0 <U∞:=by positivity [Kit.slope_pos L0]
       refine ⟨F,(?_ ),fun i=> (?_), ?_⟩
