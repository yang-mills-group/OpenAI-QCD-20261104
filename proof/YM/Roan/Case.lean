       let L:=L0; let n:=fun x=> nz! x; let Y':= fun x=> riseV L x (n x); let Q:=fun x=> (n x:ℝ)^kX; have ht:Rate su L 0 Q:= ((opusR L).pow _).weaken (by norm_num)
       have hv:Rate su L (-(1/2)) (fun x=> U! x):= roseR L Rate.flame _ (Eventually.of_forall fun _=> le_rfl)
       let f(x:ℝ):ℝ:= (fan L θ x)⁻¹ ^2*BΛ*(G1*(6*((highR L x:ℝ)+1)) * (Cpρ*Jets.Touch.chip L x)); have hf:Rate su L (-1) f:=by
            have hPi:Rate su L 0 (fun x=> G1*(6*((highR L x:ℝ)+1))):=((((opusR L).congr (v:=fun x=>(highR L x:ℝ)+1) (Eventually.of_forall fun x=>by simp)).mul_left 6).mul_left _)
            have hx:Rate su L 0 (fun x=>(fan L θ x)⁻¹):=(Rate.rpow_monitor (-θ)).congr (Eventually.of_forall fun i=> (Real.rpow_neg (Delay.monitor_pos ..).le _).symm)
            exact (((hx.pow 2).mul_right _).mul (hPi.mul ((Jets.Touch.chip_rate _).mul_left _))).weaken (by norm_num)
       have he:= roseR L hf (fun x=> nz! x) (Eventually.of_forall fun _=> le_rfl); have h : Rate su L (1/2) (fun x=>(U! x)⁻¹):= (city_b L (θ:=θ)).2.2.2; let e:=(1/2:ℝ); filter_upwards [(hv.mul ht).below (by norm_num) e (by positivity), (((he.mul_left F1).mul ht).mul h).below (by norm_num) e (by positivity), ((Rate.flame).mul ht).below (by norm_num) e (by positivity),MintV.ratio_v L hVt 0 le_rfl] with x hv ht h hx
       have he: e<1:=by unfold e; norm_num
       have hP:0 < Q x:=by unfold Q n; positivity
       let w:=U! x; have hw:0 < w:=hx.2.1
       have hf:∀ a:ℝ, |a* Q x|≤ e → a< Stair.costB kX (n x):=fun x h=> (lt_div_iff₀ hP).mpr (((le_abs_self _).trans h).trans_lt he)
       refine ⟨⟨hw,hf w hv⟩,hf _ h,?_⟩; let p:=f (Y' x); have hT: F1*p*Q x*w⁻¹ ≤ e := (le_abs_self _).trans ht; change F1*p< w*(1/Q x); rw[←mul_div_assoc,mul_one]; apply (lt_div_iff₀ hP).mpr; apply (_root_.div_lt_one hw).mp; rw [div_eq_mul_inv]; exact hT.trans_lt he
