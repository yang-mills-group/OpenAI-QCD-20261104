       · unfold F; positivity
       filter_upwards [ratio_v L0 hVt 0 le_rfl,heightR L0] with x hx hp; let b:= Lμ x; let n:=nz! x; let v:=W! x; let r:ℝ:=C*(8*n)^N; have hp': (↑b:ℝ)+1 ≤8*n:= (hp n le_rfl).2; have ht:1 ≤ v:=hx.1; have hw:1≤ v^2:=one_le_pow₀ ht
