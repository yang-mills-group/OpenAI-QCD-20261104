lemma crownsV (j:ℕ) : Tendsto (fun i:ℕ=> uθ (Y.mark i)*(αq j (Y.mark i) (Ar.D))) atTop (𝓝 0):=by
    let h(n):= Counter.Hymn.damping P₀ A d n j*((1+2*Gℓ d (A.node n))*Ar.D); let k:=(LifeT.salary P₀ A (x:=x) j)⁻¹*Real.exp ((Track.scale A x j)^(1/2:ℝ)); let f(i:ℕ):= uθ i*h i
    have ht :∀ᶠ i in atTop,Bounce.Ticket (Gℓ d (A.node i)) (Gℓ d (A.node (i+1))) (Kit.slope (A.spacing i)):= (eventually_ge_atTop (base d)).mono fun i hi=> ((hVec.stock _ _ (hL d i hi)).1.earns (A.node (i+1)) rfl)
    have hz:Tendsto f atTop (𝓝 0):= Counter.Hymn.vanish P₀ A (fun i=>Gℓ d (A.node i)) ht j Ar.D Ar.paid; have hv0:Tendsto (fun i=> f (Y.mark i)*k) atTop (𝓝 0):=by simpa only [zero_mul,Function.comp_apply] using (hz.comp (show Tendsto Y.mark atTop atTop from hp.ship.β_path.uv.tendsto_atTop)).mul_const k
    exact hv0.congr' (Eventually.of_forall fun i=> by unfold f h k solar; ring)
