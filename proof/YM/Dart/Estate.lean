lemma holdings :∃ y:ℕ→Massive.UV.Label d,(∀ᶠ i:ℕ in atTop,Ψ (j' i) (PV d none i (y i)) ≤2*Ar.D)∧∀ᶠ j in atTop,∃ L:ℕ→ℝ,Tendsto (fun i:ℕ=> uθ (Y.mark i)*L i) atTop (𝓝 0) ∧ ∀ᶠ i:ℕ in atTop,0 ≤ L i∧FocusK (Cq) i j ((pS i) [] (Nc i)-(Γ₁ i) (y i)) (L i) :=by
    obtain ⟨p,hP⟩:= Ar.glow.supplier Uv d; obtain ⟨n,hN⟩:=eventually_atTop.mp (glued P₀ A X E LL Θ Uv i0 ξ Fu ν Δ hθ Y hp hτ sym M N₀ K0 W' hm hM hN hK Gℓ π hVec d hPil base PV hL hOrder Zc c' Ar hAr p hP); choose! y hσ h1 h2 using hN
    refine ⟨y,eventually_atTop.mpr ⟨n,h1⟩,?_⟩; filter_upwards [eventually_ge_atTop (base d)] with m hm'; let j:= cK m; refine ⟨fun i=>αq j (Y.mark i) Ar.D,crownsV P₀ A X E LL Θ Uv i0 ξ Fu ν Δ Y hp M N₀ Gℓ π hVec d base hL Zc c' Ar j,?_⟩ -- hL sig
    filter_upwards [hp.ship.β_path.uv.tendsto_atTop.eventually_ge_atTop j,(stamp_big hp.ship.β_path m).eventually_ge_atTop (2*p),eventually_ge_atTop n] with i hi hp hV
    have hJ:2*p ≤ratioTo (Cq).S (j' i) m:=hp; refine ⟨?_,h2 i hV m j hm' rfl hi (by omega)⟩; exact mul_nonneg (mul_nonneg (inv_pos.mpr (hm.force j).cave.shape.1).le (mul_nonneg (Real.exp_nonneg _) (mul_nonneg (show 0≤1+2*Gℓ d (A.node (Y.mark i)) by linarith only [(hPil d (A.node (Y.mark i))).tall]) (zero_le_one.trans Ar.paid)))) (Real.exp_nonneg _)
