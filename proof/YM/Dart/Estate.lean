lemma buyers (f:ℕ→ℂ)(B:ℝ)(hx:0<B)(hf:∀ᶠ i:ℕ in atTop,‖f i‖ ≤ B*Real.exp (((d:ℝ)/2+1/16)*(Track.measure A (Y.mark i)))):∃ Z:ℕ→Massive.UV.Label d, Massive.Needle.Arc Kn (fun i=> f i• (pS i) [] (Nc i)) Z:=by
   obtain ⟨y,h1,h2⟩:= holdings P₀ A X E LL Θ Uv i0 ξ Fu ν Δ hθ Y hp hτ sym M N₀ K0 W' hm hM hN hK Gℓ π hVec d hPil base PV hL hOrder Zc c' Ar hAr
   refine ⟨fun i=> f i • y i,⟨B*(2*Ar.D),mul_pos hx (mul_pos (by norm_num) (zero_lt_one.trans_le Ar.paid)),?_⟩,?_⟩; filter_upwards [hf,h1] with i hi hp; rw[Kn.dimM,hKn,hΩ]; apply le_trans (mul_le_mul_of_nonneg_left hp (norm_nonneg (f i))); exact ((mul_le_mul_of_nonneg_right hi (mul_nonneg (by norm_num:0≤(2:ℝ)) (zero_le_one.trans Ar.paid))).trans_eq (by ring))
   filter_upwards [h2] with j h; obtain ⟨L,hF,h⟩:=h; let V(i):=uθ (Y.mark i); refine ⟨fun i=> B*(V i * L i),by simpa only[mul_zero] using hF.const_mul B,?_⟩; filter_upwards [hf,h] with i hi h; refine ⟨mul_nonneg hx.le (mul_nonneg (Real.exp_nonneg _) h.1),?_⟩; change FocusK Cq _ _ (f i • _ - (Γ₁ i) (f i • y i)) _; rw[map_smul, ← smul_sub]; exact FocusK.mono (FocusK.smul h.2 (f i)) ((mul_le_mul_of_nonneg_right hi h.1).trans_eq (mul_assoc ..))
