lemma slowR (ht:D'≤ d):∃ Z:ℕ→Massive.UV.Label d, Massive.Needle.Arc Kn (fun i=> Massive.Needle.stem ZP D' i v) Z:=by
    let h0: (0:Cover)∈ Lattice.box 1:=center_box _; obtain ⟨Z,hZ⟩:=sigils P₀ A X E LL Θ Uv i0 ξ Fu ν Δ hθ Y hp hτ sym M N₀ K0 W' hm hM hN hK Gℓ π hVec d hPil base PV hL hOrder Qκ Kn hKn hΩ hg D' Ψb 0 v (gR _ h0) (hZR _ h0) (fun _=> (1:ℂ)) 0 ht (by rw[zero_add]; gcongr) (Eventually.of_forall fun i=>by simp); exact ⟨Z,(show (fun i=> (1:ℂ) • Massive.Needle.shifting (Cq) i 0 (Massive.Needle.stem ZP D' i v))=(fun i=>Massive.Needle.stem ZP D' i v) from funext fun i=>by rw [one_smul]; unfold Massive.Needle.shifting; simp) ▸ hZ⟩
lemma silks (ht:D'+2≤ d) (b:Axis):∃ Z:ℕ→Massive.UV.Label d, Massive.Needle.Arc Kn (fun i=> Massive.Needle.lDer (Cq) i b (Massive.Needle.stem ZP D' i v)) Z:=by
    have h:D'+0≤d:=by omega
    have hz: 1+(D':ℝ)/2 ≤ (d:ℝ)/2:=by linarith only [show (D':ℝ)+2 ≤ d by exact_mod_cast ht]
    let u(i:ℕ):ℂ:= ((λq i): ℂ)⁻¹; have hu(i:ℕ): ‖u i‖ ≤ Real.exp (1*f i):=by rw [one_mul,timeD P₀ A, show ‖u i‖= ((λq i):ℝ)⁻¹ from (by unfold u; rw [norm_inv,Complex.norm_real, Real.norm_of_nonneg (space0 _ _).le])]
    have hs: (Lattice.step b:Cover)∈Lattice.box 1:=by rw [box_test]; constructor <;> intro i <;> simp [Lattice.step, Pi.single_apply] <;> split <;> omega
    have h0: (0:Cover)∈ Lattice.box 1:=center_box _
    obtain ⟨Z,hZ⟩:=sigils P₀ A X E LL Θ Uv i0 ξ Fu ν Δ hθ Y hp hτ sym M N₀ K0 W' hm hM hN hK Gℓ π hVec d hPil base PV hL hOrder Qκ Kn hKn hΩ hg D' Ψb 0 v (gR _ h0) (hZR _ h0) (fun i=> -(u i)) 1 h hz (Eventually.of_forall fun i=>by rw [norm_neg]; exact hu i)
    obtain ⟨W,hW⟩:=sigils P₀ A X E LL Θ Uv i0 ξ Fu ν Δ hθ Y hp hτ sym M N₀ K0 W' hm hM hN hK Gℓ π hVec d hPil base PV hL hOrder Qκ Kn hKn hΩ hg D' Ψb _ v (gR _ hs) (hZR _ hs) u 1 h hz (Eventually.of_forall hu)
    have hh:= Massive.Needle.Arc.together hW hZ; refine ⟨W+Z,?_⟩; suffices he:(fun i=> Massive.Needle.lDer (Cq) i b (Massive.Needle.stem ZP D' i v))= (fun i=> u i • shifting (Cq) i (step b) (F₀ i))+(fun i=> -(u i) • shifting (Cq) i 0 (F₀ i)) from he.symm ▸ hh; funext i
    change u i • (shifting (Cq) i (step b) (F₀ i) - (F₀ i))= _; rw[Pi.add_apply, smul_sub,neg_smul, sub_eq_add_neg]; unfold Massive.Needle.shifting; simp
