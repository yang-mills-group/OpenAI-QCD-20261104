lemma faded (t:ℕ)(s:ℝ)(hs:0<s) : ∀ᶠ i in atTop,(fan (A.spacing i) θ (clockQ P₀ A x i))^t ≤ Real.exp (s* A.measure i):=by
     have h:= paleV P₀ A (x:=x) t s hs; filter_upwards [h.eventually_le_const zero_lt_one,hg] with i hi hp; rw [Real.exp_neg,mul_inv_le_iff₀ (Real.exp_pos _),one_mul] at hi; exact (pow_le_pow_left₀ (fan_pos ..).le (hp.1.trans_eq (Suburb.augmented P₀ A i x)) t).trans hi
open Massive.Poised.Plans.Stamp
lemma wasting (s:ℝ)(hs:0<s) : ∀ᶠ i in atTop, Stair.feeS d (Pressure.fiery su (clockQ P₀ A x i) (A.spacing i))⁻¹ ≤ Real.exp (s*Track.measure A i):=by
    let A0(i:ℕ):= (Pressure.fiery su (clockQ P₀ A x i) (A.spacing i))⁻¹; let C:= Rings d; let Lm(i:ℕ):=(Track.scale A x i); let f(k:C)(i:ℕ):= Lm i ^ (life k.val.1+k.val.2.card);
    let l(i:ℕ):=Real.exp (-(s*Track.measure A i)); have h1 : Tendsto l atTop (𝓝 0):= by simpa only [l,pow_zero,one_mul] using paleV P₀ A (x:=x) 0 s hs
    have hx:=tendsto_finsetSum univ (fun k:C=> fun _=> (show Tendsto (fun i=> f k i * l i) atTop (𝓝 0) from paleV P₀ A (x:=x) _ s hs)); have h :Tendsto (fun i=>(1+∑ k:C,f k i)*l i) atTop (𝓝 0):=by simpa only [add_mul,one_mul,Finset.sum_mul,Finset.sum_const_zero,add_zero] using h1.add hx
    filter_upwards [h.eventually_le_const zero_lt_one,hg] with i hi hh; unfold l at hi; rw [Real.exp_neg, mul_inv_le_iff₀ (Real.exp_pos _),one_mul] at hi; change Stair.feeS d (A0 i) ≤ _; refine le_trans ?_ hi; apply add_le_add le_rfl; apply sum_le_sum; intro j _; rw [←pow_add]; apply pow_le_pow_left₀ _ (hh.2.trans_eq (Suburb.augmented P₀ A i x)); exact inv_nonneg.mpr (mul_nonneg (inv_nonneg.mpr (Real.sqrt_nonneg _)) (Delay.monitor_pos ..).le)
