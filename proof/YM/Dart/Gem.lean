lemma shadowG (θ:ℝ)(L:Side):∀ᶠ x:ℝ in atTop, 1≤run L x∧ fan L θ x≤run L x ∧ (Pressure.fiery su x L)⁻¹ ≤ run L x:=by
    have hF:Rate su L 0 (fan L θ):= Jets.Touch.Seat.ruled (L:=L) (f:=fan L θ) Jets.Touch.Seat.keeps
    have h:=inverse_mist su L
    filter_upwards [(Work.E09.betaF_growth su L).eventually_ge_atTop 1,hF 1 zero_lt_one,h (show ℝ from 1) (by norm_num)] with x hx h1 h2; rw [Real.rpow_one] at h1 h2; exact ⟨hx,(le_abs_self _).trans h1,(le_abs_self _).trans h2⟩ -- API probably
lemma paleV (t:ℕ)(s:ℝ)(hs:0 < s) : Tendsto (fun i:ℕ=>(Track.scale A x i)^t * Real.exp (-(s*Track.measure A i))) atTop (𝓝 0):=by
    let f:= fun y:ℝ=> (x+su.slopeConstant*y)^t * Real.exp (-(s*y)); apply Tendsto.comp (g:=f) _ (Track.long A)
    have h:∀ n:ℕ, Tendsto (fun y:ℝ=> y^n*Real.exp (-(s*y))) atTop (𝓝 0):= fun n=>by simpa only [Real.rpow_natCast, neg_mul] using tendsto_rpow_mul_exp_neg_mul_atTop_nhds_zero (n:ℝ) s hs
    -- expand bin
    suffices h:∀ n t:ℕ,Tendsto (fun y:ℝ=> (x+su.slopeConstant*y)^t*y^n*Real.exp (-(s*y))) atTop (𝓝 0) by simpa only [pow_zero,mul_one,f] using h 0 t
    intro n t; induction t generalizing n with
    | zero=> simp only [pow_zero,one_mul]; exact h n
    | succ t ih=> have hx := (ih n).const_mul x; have hy := (ih (n+1)).const_mul su.slopeConstant
                  simpa only [mul_zero,zero_add] using! (hx.add hy).congr (fun i=>by simp only [pow_succ]; ring)
