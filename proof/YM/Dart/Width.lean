lemma wax : ∃ B:ℝ,1 ≤ B∧∀ᶠ i:ℕ in atTop,∀ p:Massive.UV.Label d,‖PV d none i p‖ ≤ ‖p‖*(B*Real.exp (((d:ℝ)/2+1/32)* A.measure (Y.mark i))):=by
    obtain ⟨T,hT,h⟩:=pilferLow P₀ A X E LL Θ Uv i0 ξ Fu ν Δ hθ Y hp hτ sym M N₀ K0 W' hm d base PV hL hOrder
    let s:ℝ:=1/64; obtain ⟨V,hV,hP⟩:= rawV P₀ A X E LL Θ Uv i0 ξ Fu ν M N₀ K0 W' hm d base hL hg s (by unfold s; norm_num) -- arg
    refine ⟨V*T,one_le_mul_of_one_le_of_one_le hV hT,?_⟩; filter_upwards [h,hp.ship.β_path.uv.tendsto_atTop.eventually hP] with i hi h q
    let w:=Mθ (Y.mark i); let e:=(d:ℝ)/2; let f:=PV d none i; let p:= V*T*Real.exp ((e+1/32)*w)
    have hz(x:Massive.UV.Label d)(hx:‖x‖≤1): ‖f x‖ ≤ p:=by
         apply (h (f x)).trans; have hp: 0 ≤ V*Real.exp (s*w):=mul_nonneg (zero_le_one.trans hV) (Real.exp_nonneg _)
         have hl : Ψ (Y.mark i) (f x) ≤ T*Real.exp ((e+s)*w):=hi none x hx
         refine (mul_le_mul_of_nonneg_left hl hp).trans_eq ?_; rw [show V*_*(T*_)=V*T*(Real.exp (s*w)*Real.exp ((e+s)*w)) from by ring, ← Real.exp_add]; unfold s p; ring_nf
    by_cases he:q=0; · rw[he,map_zero,norm_zero,zero_mul]
    let Z:ℂ:=(‖q‖:ℂ)⁻¹; have hp':0<‖q‖:=norm_pos_iff.mpr he; have ht:‖Z‖=‖q‖⁻¹:=by unfold Z; rw[norm_inv,Complex.norm_real,Real.norm_of_nonneg hp'.le];
    have hf:=hz (Z • q) (by rw[norm_smul,ht,inv_mul_cancel₀ hp'.ne'])
    rw[map_smul,norm_smul,ht,inv_mul_eq_div,div_le_iff₀ hp'] at hf; exact hf.trans_eq (mul_comm ..)
