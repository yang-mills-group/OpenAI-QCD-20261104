import YM.QCD.Lattice.Gamma
import YM.Mink.Poincare
import YM.Mink.Boost
import Mathlib.Topology.Covering.Basic

/-!
# Conventions on the spin lifts

Use matrix groups generated by the usual lifted rotations, reflection (Pin+
Euclidean convention of the proof), and imaginary-angle continuation for
proper Lorentz boosts. Time last (axis 3). `closure` below denotes the
*subgroup generated*, not a topological closure. Include that these project
onto the *full* required orthogonal/Lorentz groups, with the two choices of
sign, in the target so proofs using these conventions will have to check it.
-/
set_option autoImplicit false
noncomputable section
namespace YM.TorusPCAC
open Set NormedSpace QCD QCD.Lat Mink
open scoped Topology Matrix.Norms.Frobenius BigOperators

namespace Spin
abbrev Rep := Spikeˣ

/-- Fix the generator also for the trivial `i=j` case (zero). -/
def bivector (i j : Axis) : Spike :=
  if i = j then 0 else (2:ℂ)⁻¹ • (gamma i * gamma j)

/-- Value `exp A` (type of unit contains a certified inverse). -/
def evolve (A : Spike) : Rep := by
  letI : NormedAlgebra ℚ Spike := .restrictScalars ℚ ℂ _
  exact (isUnit_exp A).unit

def mirrorMatrix (i : Axis) : Spike := -Complex.I • (gamma i * g5)

lemma mirrorMatrix_square (i : Axis) : mirrorMatrix i * mirrorMatrix i = 1 := by
  rw [mirrorMatrix, smul_mul_smul_comm]
  simp only [neg_mul_neg, Complex.I_mul_I]
  rw [Matrix.mul_assoc, show g5 * (gamma i * g5) = -gamma i by
    rw [← Matrix.mul_assoc, show g5 * gamma i = -(gamma i * g5) by rw [five, neg_neg],
      Matrix.neg_mul, Matrix.mul_assoc, g5_sq, Matrix.mul_one]]
  simp

def mirrorU (i : Axis) : Rep :=
  ⟨mirrorMatrix i,mirrorMatrix i,mirrorMatrix_square i,mirrorMatrix_square i⟩

def rotations (i j : Axis) (t : ℝ) :=
  (Ortho.oneParameter (Ortho.plane i j) t, evolve (t • bivector i j))

def mirrors (i : Axis) := (Signed.reflect i, mirrorU i)

def euclidean : Subgroup (Ortho × Rep) :=
  Subgroup.closure ({g | ∃ i j t, g = rotations i j t} ∪ {g | ∃ i, g = mirrors i})

abbrev Pin := ↥euclidean

def turn (i j : Axis) (t : ℝ) : Pin :=
  ⟨rotations i j t, Subgroup.subset_closure (Set.mem_union_left _ ⟨i,j,t,rfl⟩)⟩

def mirror (i : Axis) : Pin :=
  ⟨mirrors i, Subgroup.subset_closure (Set.mem_union_right _ ⟨i,rfl⟩)⟩

def boosts (a : SpaceAxis) (t : ℝ) :=
  ((Ray.fromAxis a).boost t,evolve (t • ((-Complex.I) • bivector timeAxis a.castSucc)))

def spacetime : Subgroup (Lorentz × Rep) :=
  Subgroup.closure
    ({g | ∃ (A : Ortho) (S : Rep) (_h : (A,S) ∈ euclidean) (hp : Lorentz.spatialTurn A),
      g = (Lorentz.room A hp,S)} ∪ {g | ∃ a t, g = boosts a t})

abbrev Proper := ↥spacetime -- proper orthochronous spin group

def room (X : Pin) (h : Lorentz.spatialTurn X.val.1) : Proper :=
  ⟨(Lorentz.room X.val.1 h,X.val.2),Subgroup.subset_closure
    (Set.mem_union_left _ ⟨X.val.1,X.val.2,X.property,h,rfl⟩)⟩

def boost (a : SpaceAxis) (t : ℝ) : Proper :=
  ⟨boosts a t,Subgroup.subset_closure (Set.mem_union_right _ ⟨a,t,rfl⟩)⟩

structure Projects : Prop where
  orthogonal (A : Ortho) : ∃ S : Rep, (A,S) ∈ euclidean ∧
    ∀ T : Rep, (A,T) ∈ euclidean ↔ T = S ∨ T = -S
  lorentz (A : Lorentz) : ∃ S : Rep, (A,S) ∈ spacetime ∧
    ∀ T : Rep, (A,T) ∈ spacetime ↔ T = S ∨ T = -S
  coverE : IsCoveringMap (fun p : Pin => p.val.1)
  coverM : IsCoveringMap (fun p : Proper => p.val.1)
  -- flipping the central sign is truly distinct
  signs (S : Rep) : - S ≠ S

end Spin
end YM.TorusPCAC
