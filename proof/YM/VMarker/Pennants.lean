        unfold sparkleB; change _ + ζ z s = (p z s-p 0 0)+ (_+ζ 0 b0); rw [hZ,hS0]; abel
    rw [hzB,exp_add,map_mul,show exp (Sp 0 b0 U')=F₀ from wind_sourceY T P₀ P₂ A i₀ B X hp he Z F Y hb0 U', show wearK c N v F₀= _ from hb,map_exp (wearK c N v) ((songT (c:=c) (N:=N) (Mq)).continuous),Algebra.mul_smul_comm, ← mul_assoc]
