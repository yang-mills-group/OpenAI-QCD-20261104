lemma wind_sourceY (U':Grid c): let a:= pSilkY T P₀ P₂ A i₀ B X Z F Y; let r:= rarity N (δ') a V.Z.page T.down P G.clip β
   exp (Sp 0 b0 U')= exp (heartS Y.R4 P.threshold r (E!) U')*exp (swarm Y.toPaymentM.X U') :=by
    intro rν a
    haveI:=Y.cnt; haveI:=Y.cntK; haveI:=Y.cntZ
    obtain ⟨J,hJ,Qz,hS,hQ⟩:= Links.known P.threshold (N:=N) U'; have hr:= Y.raw U' F J Qz
    let σ:= Matter.overhead (PhysicalNext.Repeat.Greenbelt.prism T xᵃ χ o.K U' F) (trimP T R (lowK S.L (run S.L x) T'.top.supportExponent) β 0) Q.table
    let HU:= ∑' i,(V! (frozenV X 0 b0)).honest χ U' i
    let Foto:= heartS Y.R4 P.threshold a (E!) U'
    have hσ:0 < σ:= overhead_pos _ B.Pq
    change Cove.light _ (σ • (exp HU* heartK Qz P.threshold U')) * gauss (Lat.copies N (wood P₂ 0 S.land U'))=Cove.light _ (scoreX Y.R4 Qz Y.toPaymentM.X _ a (E!) U') at hr
    let Y₂:= paleF N (wood P₂ 0 S.land U')
    unfold scoreX scoreV at hr; rw [hQ,mul_one,mul_one,show gauss ..= Cove.light _ (exp Y₂) from ?_] at hr; swap
    · rw [Cove.light_exp,QCD.Port.serviceP]; rfl
    rw [←map_mul] at hr; refine Eq.trans (b:=σ • exp HU * exp Y₂) ?_ (Subtype.ext hr); rw [sparkleB]; change exp (cb (Real.log σ)+Y₂+HU)= _
    rw [exp_add,exp_add,Coda.tripC,Real.exp_log hσ,Algebra.smul_mul_assoc,one_mul,Algebra.smul_mul_assoc,Algebra.smul_mul_assoc]; exact congr_arg _ (mul_comm ..)
