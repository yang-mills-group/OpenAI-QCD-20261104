         intro J inst F₁ hF; let Y₀:=Y.toPaymentM; have hQ:= hh.swap J F₁ hF U' β M'; let Q:=Trail V' F₁ P.threshold
         have hx : enveloped P.threshold F₁ F₀ U'= scoreX R F₁ Y₀.X P.threshold a (E!) U':= by unfold enveloped F₀ scoreX scoreV; ac_rfl
