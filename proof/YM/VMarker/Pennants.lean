    have ht:Countable (V! A).Faber:=(tenureY T P₀ P₂ A B X hp he).2.2.1
    have hS :Countable (Plot V' (TQ 0 0)):=by
        haveI:Countable (LayerQ c):=Finite.to_countable; haveI:Countable (Site c):=Finite.to_countable
        apply glazeP
    have hh := Y.crown; obtain ⟨hf,hMpl⟩:= hh.happy; let W:=zF; let D₁:=Real.exp (Real.log (W 1).det.re); have hx :0<D₁:=Real.exp_pos _; let v:=Mq; let νχ:= P•; have ht':(W 1).det=(D₁:ℂ):=priceD 1 B.D.stable
    have hs := ChairsY T P₀ P₂ A B X hp he hb0 hP
    refine ⟨Plot V' (TQ 0 0),hS,S',poured TQ V' hX hh.purse hs hf hMpl hb0, mul_pos (pow_pos hx N) (Real.exp_pos _), ⟨hf, fun z s U' hz h=>?_⟩,?_⟩
    · let M' := pSilkY T P₀ P₂ A i₀ B X Z F Y; let Q₁:= scoreX R (TQ z s) A0.X P.threshold (rarity N (δ') M' V.Z.page T.down P G.clip β) (E!) U'; let f:= ventY T P₀ P₂ A B X M z s U'
      have hΦ:= (hs.scene z s hz h); 
      have hΩ: wearK c N v (Q₁)= νχ • κGoal (P:=P) E (S' z s) V T.down G.clip (Zp) (Eqz) 0 (E!) U':=by
           have hQ:= hh.swap _ (Z! z s) hΦ.awake U' β M'; refine hQ.trans ?_; let Q:=Trail V' (TQ z s) P.threshold
           change κGoal (P:=P) E (flightK Q v) V T.down G.clip (Zp) (Eqz) (pForY T P₀ P₂ A i₀ B X Z F Y) (E!) U'= _
           apply Eq.trans (ritz (R:=P) ..); apply congr_arg (νχ • ·); unfold κGoal scoreV; rw [show heartK (S' z s) _ U'= heartK (flightK Q v) P.threshold U' from Meridians.displaced TQ (Meridians.canopyR V') hs.prag (constantArch V') _ _]; rfl
      have hzX:= plannedY T P₀ P₂ A i₀ B X hp he Z F Y z s hz h hb0 hT M hM U'; change advanceF .. = ((W 1).det^N) • Cove.light _ (exp f * Q₁) at hzX
      unfold stepGoY fortQ; dsimp only [Function.comp_apply]; rw [show advanceF ..= _ from hzX,ht',map_smul,callH,map_smul,map_mul,NormedSpace.map_exp (wearK c N (Mq)) ((songT (c:=c) (N:=N) (Mq)).continuous),show wearK c N Mq Q₁=_ from hΩ]; -- let args.M
      rw [Algebra.mul_smul_comm]; rw [← Complex.ofReal_pow]; exact (mul_smul (D₁^N) νχ _).symm -- p form
    refine ⟨fun z s hz heS=>?_⟩
