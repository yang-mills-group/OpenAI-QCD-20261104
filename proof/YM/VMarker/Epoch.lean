    obtain ⟨G0,h1,h2⟩:= Carrier.Ticket D φ π φ f g a' b' E.hx hp hZ E.desk hr.ball hv hφ.le h'F.before hM
    have hW:= Carrier.eclipse D φ π φ E.desk hr.ball E.hx hZ hv hφ.le h'F.before; have hτ:= Carrier.status D φ π φ E.desk
    obtain ⟨W',Yv,h1',h2',hΦ⟩:= (shared ξ★ Re Fi JQ R h1 (hr.ball.symm ▸ h2) R₁ hq hr' hO hA hJ hE (fan_pos ..)).budget
