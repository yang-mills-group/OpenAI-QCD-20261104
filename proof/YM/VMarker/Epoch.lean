lemma pulp (V':Grid f)(hp:(V★).Staid R.threshold V')(he:Neat (V★))(j:Finset (Spine Yp)): pluck (Keys f N) j (Ps V')=Real.exp (TI V') • (gauss (Lat.copies N ((Uα) V')) * pluck (Keys f N) j ((V★).bluff R.threshold V')):=by
    have hm:= E.mode; have hf:=hm.1; obtain ⟨hS,hX,h₄⟩:= E.capital
    have h0:φ≤1:= by rw [← Conductor.normS φ hf.le]; exact (Fused.withinL hm.2).le
    have hh := Levitate.fiscal Y hX.before h₃ E.hr.ball hA' π hπ
    have hQ: Correspond (bareRail (ξ★)) (Y.EvalK π):=by
         rw [show bareRail (ξ★)=(Y₀).EvalK π from Carrier.awakenK (Y₀) φ π hf]; exact ⟨hh.coins,hh.pays,fun i V=>(hh.governs i V).symm⟩
    rw [envoy (ξ★) Re Fi JQ _ _ hp he _ hQ]; apply pearl_ticket; rw [← Levitate.pressureLog (P:=R) Y, ← Carrier.liftExpM (Y₀) φ π E.hx (by norm_num) hf h0 hX.before E.desk E.hr.ball h₄ hπ]; rfl
omit hA' h₃ hπ E in
lemma priceTY (x:ℂ)(Z: Grass.Dirac (Modes f N))(V:Grid f) : Kit.sheath 1 (ater S h V) (x • Z) = x • Kit.sheath 1 (ater S h V) Z:=by unfold Kit.sheath; simp only [Complex.ofReal_one,inv_one,one_pow,one_smul,map_smul, smul_mul_assoc]
