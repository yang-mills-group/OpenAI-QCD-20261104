local notation "P★"=> MassiveQCD.Apron.Grove.purchase S h K (β:=β) (T:=T) (δ:=lowK S.L xᵃ T'.top.supportExponent) (b:=0) (O:=R) (X:=K₀!) (W':=U.Z.page) V★
lemma pipings (V₁:Grid f)(j:Finset (Spine Yp))(hp:(V★).Staid R.threshold V₁)(he:Neat (V★)) : P★ j V₁= Kit.sheath 1 (ater S h V₁) (pluck (Keys f N) j (Ps V₁)):=by
    rw [pulp T P₀ P₂ i₀ B Y φ Z0 E Re Fi π JQ hA' h₃ hπ V₁ hp he j]; unfold MassiveQCD.Apron.Grove.purchase
    have hp:(trimP T R (lowK S.L xᵃ T'.top.supportExponent) β 0).exponent V₁=Reggae.pulse T.up T.high R β 0 V₁:=by unfold Rep.exponent; dsimp only [trimP]; rw [Beam.windy]; unfold Reggae.pulse; ring
    let u:= Reggae.pulse T.up T'.top.clip R β 0 V₁; rw [hp,E.hw,libraryQ,Finch.scent,exert, ← Complex.ofReal_pow,mul_smul];
    let V:= (↑(Real.exp u):ℂ); let x :ℂ:= (↑((Real.exp (-Extra.Iteration.action U.Z.page V₁))^N):ℂ)
    change V • (x • _) = Kit.sheath _ _ (V • (x • _)); rw [priceTY,priceTY]; rfl
