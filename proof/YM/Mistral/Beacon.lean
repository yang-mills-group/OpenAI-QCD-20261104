      let v₀:=ε/4; have hv:0<v₀:=div_pos he (by norm_num)
      have hf:Tendsto (fun i=> Real.exp (v₀*Track.measure A i)) atTop atTop:=Real.tendsto_exp_atTop.comp (A.long.const_mul_atTop hv)
      filter_upwards [hf.eventually_ge_atTop Z, Voyage.ransoms P₀ A Θ Uv i0 d (ξ d) (Fu d) hs (base d) v₀ hv, eventually_ge_atTop (base d)] with k hvZ hP h0 ht'
      filter_upwards [hp.ship.β_path.uv.tendsto_atTop.eventually_ge_atTop k, Hk] with i hi hx
      apply paid_h P₀ A X E LL Θ Uv i0 ξ Fu ν Δ hθ Y hp sym M N₀ K0 W' hm d base hL i (base d) Z (PV d none i v) 0 q (base d) k hx _ le_rfl le_rfl h0 hi
