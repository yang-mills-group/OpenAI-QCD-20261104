lemma wageℓ : Bz ≤ ℓ∧ ℓ < Aₜ ∧((Gn:ℝ)/2+1)*(Xμ ℓ-Xμ (Bz))≤ γu :=by
      have hs:= hCv.season; have hp:= OrbitK.Voyage.Speedway.growsΩ P₀ Qv hXκ hb (Bz); rw [winX P₀ Q eD PxPad D j p₀ z₀ hR,(seasons P₀ Q eD PxPad D j p₀ z₀ hR (Bz) le_rfl (by omega)).1] at hp; have hq:=hp
      have hv:ℓ < Aₜ:= lt_of_le_of_lt hq (Nat.add_lt_add_left hs.denseM (Bz)); have hO : Bz ≤ ℓ:=(Counter.post P₀ Qv (j:=Bz) hXκ hb ℓ rfl).1
      refine ⟨hO,hv,?_⟩; rw [(pTempo P₀ Q eD PxPad D j p₀ z₀ hR _ _ le_rfl hO (by omega)).1]; exact le_trans (mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right (Nat.cast_le.mpr (show ℓ-Bz ≤ 2*hb*(highR L₀ Xc)^2 from by omega)) (Real.log_nonneg (by exact_mod_cast (L₀).pos))) (by positivity)) hs.nearM
lemma stretchK (hx0: x ≤ su.slopeConstant*(Qv).measure (Bz)): 0 ≤ Δ ∧ Δ≤ Xμ (Bz)/(20000*((Gn:ℝ)+10))∧10000*((Gn:ℝ)+10)*γu= Δ:=by
      let u:=su.slopeConstant; have hu:0<u:= Gauge.slopeConstant_pos simple
      have hw:= (augmented P₀ (Qv) (Bz) x); rw [winX P₀ Q eD PxPad D j p₀ z₀ hR,(seasons P₀ Q eD PxPad D j p₀ z₀ hR (Bz) le_rfl (by omega)).1] at hw; have hw: run L₀ Xc=Track.scale Qv x (Bz):=hw
      have hp: (run L₀ Xc)/(2*u) ≤ Xμ (Bz):= (div_le_iff₀ (by positivity)).2 (by rw [hw]; change x+u*_ ≤ _; linarith only [show x ≤ u*(Qv).measure (Bz) from hx0])
      exact ⟨mul_nonneg (by positivity) (Real.log_nonneg (by exact_mod_cast (L₀).pos)),hCv.season.pad.trans ((mul_le_mul_of_nonneg_left hp (show 0 ≤(1/(20000*((Gn:ℝ)+10))) from by positivity)).trans_eq (by ring)),(by unfold Mistral.globe; field_simp)⟩
