structure Forester (Kt:ℝ)(b:ChangeQ)(L:Side)(Z:ParcelR)(Γz s:ℝ):Prop extends Pigeon P₀ E Kt b L Z Γz s where
    test : ∀ (c:Side)(t:BudgetPoint), Now L t (P.stage b.lo) s → ∀ V: Voice c 6, Cheap V.P V.K t L s θ (outE 6 (E.eps b) (E.D b)) (outK (E.D b) (E.eps b))→∀ (U:Grid c)(v:Train (rank b.lo))(u:SunR Z)(T:PathData su), T.Bounds (P.stage b.lo).clip (P.stage b.lo).width (P.allowance b.lo) Γz → ∀ (β m:ℝ), run L s/2 ≤ β→ β≤2*run L s→|m| ≤ roofK L θ (halo₀ P₀ L b) s→ ‖NormedSpace.exp (heartS V.P t.threshold (scent u.Z.page t T (P.stage b.lo).clip β 0 6) (FieldB Z u c (haloK L s) (J b.lo) v + m • 1) U)‖ ≤ Massive.Pressure.major su c Kt (2*gaugeSize L s/strength (twist (P:=P) b).top.clip) U
lemma produceV {σ:ℝ}(L:Side)(Ω:ParcelR)(h:Ω.Rates σ)(s:ℝ):∃ W:ℝ,∀ᶠ x in atTop, Forester P₀ E W b L Ω s x:=by
    let ξ₀:= halo₀ P₀ L b; have hKt:0<ξ₀:=glowK ..; let X:= twist (P:=P) b
    obtain ⟨K,hp⟩:= Price.protoK (P:=J b.lo) X L Ω (P.stage b.lo).width (P.allowance b.lo) s ξ₀ θ h (N:=6) (P₀ b).lead hKt (outE 6 (E.eps b) (E.D b)) (outK (E.D b) (E.eps b)); refine ⟨K,?_⟩; filter_upwards [hp,Delay.shift_pos su L] with x hp hh; refine ⟨⟨fun c t ht V hV U v u T hx p m he hF hU=>?_⟩,hp⟩
    have hP:0< 2*gaugeSize L x/strength (X.top.clip):= div_pos (by exact mul_pos (by norm_num) (inv_pos.mpr (Real.sqrt_pos.mpr hh))) (strength_pos _)
    apply (hp _ t ht V hV _ _ _ _ hx _ _ he hF hU).trans; unfold Massive.Pressure.major Globe.expo; rw [neg_mul_neg]; exact Real.exp_monotone (sub_le_self _ (sum_nonneg (fun i _=>div_nonneg (Gauge.chord_nonneg ..) hP.le)))
abbrev GivenV (S:Flight b.old b.new)(p:ParcelR)(z v w g W x:ℝ): Prop:= Day (J b.lo) F₀ (twist (P:=P) b) S.patch p (halo₀ P₀ S.L b) θ x (P.stage b.lo).width (P.allowance b.lo) z v w ∧ TowerThin (J b.lo) (twist (P:=P) b) S.patch p 6 x θ (twist (P:=P) b).top.width (P.allowance b.lo) z (halo₀ P₀ S.L b) (E.eps b) (E.D b) g ∧ Forester P₀ E W b S.L p z x ∧ PostsL P₀ E LL Θ Uv i0 ξ Fu b M K0 g w W S.patch x
lemma reservesV :∃ m:ℕ,∀ p z (S:Flight b.old b.new), ParcelR.Rates p (P.width b)→ m ≤ S.L.val→∃ v w g W:ℝ,∀ᶠ x in atTop, Digit S.patch→ GivenV P₀ E LL Θ Uv i0 ξ Fu b M K0 S p z v w g W x:=by
   obtain ⟨m,B,h⟩:= Globe.coreD F₀ (J b.lo) (rank_ge _); refine ⟨m,fun Q Λ S hQ hs=>?_⟩
   by_cases H:Digit S.patch; swap; · exact ⟨0,0,0,0,Eventually.of_forall (fun i f=>False.elim (H f))⟩
   obtain ⟨a,d,ha⟩:=periodics (J b.lo) F₀ (twist (P:=P) b) Q S.patch (glowK P₀ S.L b) (P₀ b).lead hQ (h S.L · hs S.odd S.coarse) (P.stage b.lo).width (P.allowance b.lo) Λ H
   obtain ⟨w,hw⟩:= Sharp.stocking (J b.lo) (Ω:=Q) (T':=twist (P:=P) b) (J:=S.patch) (N:=6) (η:=θ) (a:=(P.stage b.lo).width) (d:=P.allowance b.lo) (Λ:=Λ) (κ:=halo₀ P₀ S.L b) (ε:=E.eps b) (D:=E.D b) hQ (P₀ b).lead (glowK ..)
   obtain ⟨X,hX⟩:=produceV P₀ E b S.L Q hQ Λ; refine ⟨a,d,w,X,?_⟩; filter_upwards [hX,hw,ha,laterP P₀ E LL Θ Uv i0 ξ Fu b M K0 w d X S.patch] with x hH ht hD hS; exact fun _=> ⟨hD,ht,hH,hS⟩
