lemma castingV (hG: delivery P₀ tol A (Rv msg tol) X x)(W:Supply P₀ A X E ν O Ht Pt):∃ (O:Paved P₀ A X x)(Ht:Uptax P₀ A E x)(Kt:ℕ→ℝ), Supply P₀ A X E ν O Ht Pt ∧ (∀ i,Pigeon P₀ E (Kt i) (A.node i) (A.spacing i) (A.beam i).fare (stanceQ P₀ A i) (clockQ P₀ A x i))∧ Mission P₀ A X E msg O Ht Kt ∧ ∀ i, PostsL P₀ E LL Θ Uv i0 ξ Fu (A.node i) M K0 (Ht.cost i) (O.Y i) (Kt i) (A.flight i).patch (clockQ P₀ A x i):=by
    have h (i:ℕ):Digit (A.flight i).patch:=by obtain ⟨j,h⟩:= A.powers i; refine ⟨j,?_⟩; change (A.spacing i).val = _; rw [show A.spacing i=_ from (A.length_eq i).trans h]; exact PNat.pow_coe _ _
    let O':Paved P₀ A X x:=⟨Mv msg.a,Mv msg.d,fun i=>((hG i).2 (h i)).1⟩; let ht:Uptax P₀ A E x:=⟨Mv msg.g,fun i=> ((hG i).2 (h i)).2.1⟩; let H:=W.head; refine ⟨O',ht,Mv msg.w,⟨⟨H.funded,H.calm,H.career,H.stock,?_⟩,W.views,W.therm⟩,(fun i=> ((hG i).2 (h i)).2.2.1.toPigeon),⟨rfl,rfl,rfl,rfl,fun i=> ((hG i).2 (h i)).2.2.1⟩,(fun i=> ((hG i).2 (h i)).2.2.2)⟩; intro n k T Δ ε he; filter_upwards [H.posture n k T Δ ε he,Suburb.boon P₀ A X O' k n] with x ht hx; obtain ⟨V⟩:=ht; exact ⟨V.V,V.vote,hx,V.cert⟩
