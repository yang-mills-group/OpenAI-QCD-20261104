lemma precursorPhiV (h0:ℕ) (h:0<tol) (hν:0<ν) (he:∀ g:Patch,g.Branches K su) (d:ChangeQ→ℕ) (f:Calls P₀ tol) (hp:∀ b S Θ σ Λ p (X:LedgerQ (P₀ b) tol S Θ σ Λ p),d b≤ S.L.val→S.patch.Branches K su→0<σ→1≤Θ→1≤Λ→p.Rates (P.width b) →∀ᶠ x in atTop,f _ _ _ _ _ _ X x):∃ (gate:ChangeQ→ℕ)(D:Borough P₀ gate) (e:Tag P J (fun b=>(P₀ b).guide.table)→ℕ) (B:ℝ) (Z:Muster tol P₀ gate), d ≤ gate ∧ Earlier P 6 gate ∧ (∀ pay, (D.track e pay).Staked B)∧ D.pillar.nth 0=h0∧∀ᶠ x in atTop,∀ pay, delivery P₀ tol (D.track e pay) f (Z.patchV tol P₀ gate (D.track e pay)) x ∧ delivery P₀ tol (D.track e pay) (UnityV tol P₀) (Z.patchV tol P₀ gate (D.track e pay)) x ∧∃ (O:Paved P₀ (D.track e pay) (Z.patchV tol P₀ gate (D.track e pay)) x)(Ht:Uptax P₀ (D.track e pay) E x)(Pt:ℕ→BudgetPoint), Supply P₀ (D.track e pay) (Z.patchV tol P₀ gate (D.track e pay)) E ν O Ht Pt:=by
   obtain ⟨a,hP⟩:= purchasingV P₀ E ν hBc (tol:=tol); obtain ⟨f',hf,hX⟩:= reproduction P₀ (fun b=>max (d b) (a b)); obtain ⟨f0,h1,Hf⟩:= high_bound P f' 6 (by exact colorN (show 6≤8 by decide));
   obtain ⟨Y,hPh⟩:= inhabiting P J f0 (fun b=>(P₀ b).guide.table_exists) he h0
   have hD(b):d b ≤ f0 b:= ((le_max_left ..).trans (hf b)).trans (h1 b)
   obtain ⟨e,B,Z,hT,H⟩:= hP f0 (fun b=> ((le_max_right ..).trans (hf b)).trans (h1 b)) (Growth.rise P₀ hX f0 h1) Hf Y h hν f (fun b S W A D p X hL=>hp b S W A D p X ((hD b).trans hL)); exact ⟨f0,Y,e,B,Z,hD,Hf,hT,hPh,H⟩
