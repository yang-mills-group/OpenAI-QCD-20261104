lemma loftV (f0:ℕ) (h:0<tol) (hν:0<ν) (he:∀ g:Patch,g.Branches K su) (d:ChangeQ→ℕ) (f:Calls P₀ tol) (hp:∀ b S Θ σ Λ p (X:LedgerQ (P₀ b) tol S Θ σ Λ p),d b≤ S.L.val→S.patch.Branches K su→0<σ→1≤Θ→1≤Λ→p.Rates (P.width b) →∀ᶠ x in atTop,f _ _ _ _ _ _ X x):∃ (gate:ChangeQ→ℕ)(D:Borough P₀ gate) (e:Tag P J (fun b=>(P₀ b).guide.table)→ℕ) (B:ℝ) (Z:Muster tol P₀ gate), d ≤ gate ∧ Earlier P 6 gate ∧ (∀ pay, (D.track e pay).Staked B ∧ (D.track e pay).level 0=f0)∧∀ᶠ x in atTop,∀ pay, delivery P₀ tol (D.track e pay) f (Z.patchV tol P₀ gate (D.track e pay)) x ∧ delivery P₀ tol (D.track e pay) (UnityV tol P₀) (Z.patchV tol P₀ gate (D.track e pay)) x ∧ delivery P₀ tol (D.track e pay) (speakingW P₀ Θ Uv i0 ξ Fu tol) (Z.patchV tol P₀ gate (D.track e pay)) x∧∃ (O:Paved P₀ (D.track e pay) (Z.patchV tol P₀ gate (D.track e pay)) x)(Ht:Uptax P₀ (D.track e pay) E x)(Pt:ℕ→BudgetPoint), Supply P₀ (D.track e pay) (Z.patchV tol P₀ gate (D.track e pay)) E ν O Ht Pt:=by
    let F:= speakingW P₀ Θ Uv i0 ξ Fu tol; let V:Calls P₀ tol:= fun b S A D E p X x=> f _ _ _ _ _ _ X x∧ F _ _ _ _ _ _ X x
    obtain ⟨t,hT⟩:=keynote P₀ Θ Uv i0 ξ Fu (tol:=tol)
    obtain ⟨gate,D,e,B,Z,hX,hY,hS,hP,hQ⟩:=precursorPhiV P₀ E ν hBc f0 h hν he (fun b=> max (d b) (t b)) V fun b S A D E p X hL hB h1 h2 h3 h4=> (hp b S A D E p X ((le_max_left ..).trans hL) hB h1 h2 h3 h4).and (hT _ S A D E p X ((le_max_right ..).trans hL) hB)
    refine ⟨gate,D,e,B,Z,fun b=>(le_max_left ..).trans (hX b),hY,fun p=>⟨hS p,?_⟩,?_⟩
    · change (D.current e p 0).node.lo=f0; rw [← show D.starts e p 0=0 from rfl,D.initial,(D.tall _).1]; exact hP
    filter_upwards [hQ] with x hx pay; obtain ⟨h,hN,hV⟩:= hx pay; exact ⟨fun i=>⟨(h i).1,(h i).2.1⟩,hN,fun i=>⟨(h i).1,(h i).2.2⟩,hV⟩

