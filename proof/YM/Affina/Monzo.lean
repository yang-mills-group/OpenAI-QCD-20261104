local notation "K0"=> (P₀ K1).κ /(8*(L0).val)
local notation "Kϵ"=> σ^2*E.eps K1/16
lemma lootPc (σ z:ℝ): F! σ z= (σ^2*E.eps K1/16)* (vφ z)∧ U! z= K0* (vφ z):=by
       unfold cashPc margPc Glint.Value Glint.money Quant.crest; refine ⟨by ring,?_⟩; unfold positiveAnswer roofK Emax speedP; change (P₀ K1).κ*Jets.Touch.chip L0 z/(2*fan L0 θ z)^2/(↑(L0).val:ℝ)*(1/2)=_; ring
lemma levelUp : Rate su L0 (-1) (U!) ∧ Rate su L0 (-1) (F! σ) ∧Rate su L0 1 (fun x=>(F! σ x)⁻¹):=by
       let L:= L0; have hf:Rate su L 0 (fan L θ):= Rate.rpow_monitor _
       have hw:Rate su L 0 (fun x=> (fan L θ x)⁻¹):= (Rate.rpow_monitor (-θ)).congr (Eventually.of_forall fun i=> (Real.rpow_neg (Delay.monitor_pos ..).le _).symm)
       have hv:Rate su L (-1) (fun x=>vφ x):= (Rate.weaken ((Jets.Touch.chip_rate _).mul (hw.pow 2)) (by simp)).congr (Eventually.of_forall fun i=> by dsimp only; unfold L; rw [_root_.inv_pow,div_eq_mul_inv])
       refine ⟨ (hv.mul_left (K0)).congr (Eventually.of_forall fun i=> (lootPc P₀ E Q σ i).2), (hv.mul_left (Kϵ)).congr (Eventually.of_forall fun i=>(lootPc P₀ E Q σ i).1),?_⟩
       let K:= Kϵ; refine ((Rate.weaken ((hf.pow 2).mul (Jets.Touch.top_chip _)) (by simp)).mul_right K⁻¹).congr ?_; filter_upwards with x; rw [(lootPc P₀ E Q σ x).1,_root_.mul_inv_rev,_root_.inv_div,div_eq_mul_inv] -- # choices
lemma rangesPc (σ:ℝ)(h:0<σ) : ∀ᶠ x in atTop,0< U! x ∧ 0 < F! σ x:=by
       have hk:= (P₀ K1).pos; have hh:= E.eps_pos K1; filter_upwards [Delay.shift_pos su L0] with x hx; obtain ⟨hv,hp⟩:= lootPc P₀ E Q σ x; rw [hp,hv]; have hq:0<vφ x:=div_pos (Jets.Touch.healthy_chip hx) (pow_pos (fan_pos ..) _); exact ⟨mul_pos (by positivity) hq, mul_pos (by positivity) hq⟩
