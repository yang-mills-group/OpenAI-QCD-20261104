lemma atPc (hx':clockQ P₀ Aq x 0=z) : F! σ z= Glint.Value (SeasonR P₀ Aq E σ x) ∧ U! z=Tp:=by
     have h:= tempoP P₀ Q eD PxPad; unfold SeasonR endQ fees cashPc StartM valueK; rw[hx',tempoX P₀ Q eD PxPad,tempoL P₀ Q eD PxPad,h]; exact ⟨rfl,rfl⟩
include hY ht hv
lemma cashUpper (b:Flavor 6)(z:ℝ)(hx':clockQ P₀ (Q.track eD PxPad) x 0=z): |s₀ b| ≤ 2* U! z:=by
       let h:= hY.ship; have hP(i:Flavor 6) :0< s₀ i:=h.mass_p.margin.trans_le (h.mass_p.pos i); rw [abs_of_pos (hP b), (atPc (σ:=σ) P₀ E Q eD PxPad hx').2]; exact le_of_tendsto' (tendsto_pi_nhds.1 h.shape b) (fun t=> ((braved P₀ (t!) ((Yq)) (accord (Y.mesh t)) (Y.listed t) E LL νP hv ht (Y.snap t) (h.mark t) (h.rich t).2).margin b).2)
omit hY ht hv
