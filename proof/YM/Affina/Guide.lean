       obtain ⟨At,hA,hΨ⟩:= Tantra.leafB (J (Q.fixed 0).node.lo) (ξ 8).n (ξ 8).k; let V:=(Q.fixed 0).fare; obtain ⟨Mn,hM⟩:=hΨ V _ (Q.fixed 0).supporting.applause.rates
