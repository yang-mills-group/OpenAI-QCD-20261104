       obtain ⟨s,hE,hA'⟩:= allowsP P₀ E Θ Uv ξ Q M wΦ At T0 hθ
       have hs:= boldsT P₀ Θ Uv i0 ξ Fu Q M Ue α s Mn At T0 hT (hM L) hE hθ
       obtain ⟨V',Wτ,h,hV₀,hV₁⟩:= YM.Sprig.pavilion; let b:= Qζ.x; let i:=Qζ.y; let l:=Qζ.axial; obtain ⟨C₁,B₁,S₀,h₁⟩:= lunette Ω
       obtain ⟨bPd,bQd,a,hrV,hdR⟩:= dinerT P₀ E Θ Uv i0 ξ Fu Q sy Vτ Ω Hk Vk C₁ B₁ S₀ oB εr (V' b i l) hr hσ h₁.heavy h₁.tall h₁.pay hε (Wτ b i l) -- arg
       obtain ⟨C2,Br,Ct,hq⟩:= boughtB (rank (K1).lo) (J (K1).lo) Θ.T Bq
       let H:=Ht★; let u:= max 1 H+1; have hu:Ht★ < u:=lt_of_le_of_lt (le_max_right ..) (lt_add_one _)
       let Tz:=fun x=>ℓ★ x; have hv:∀ᶠ x in atTop,Tz x ≤ distV L0 (Vτ.ν+1) x:=(massΘ L Vτ).mono (fun x hx=> le_trans ((Nat.sub_le _ _).trans (Nat.le_succ _)) hx) -- natural stub
       filter_upwards [sinceP P₀ Q s hE,hs,hdR,finances P₀ E Θ Uv i0 ξ Fu Q M α s wΦ At T0 Ct Br u η Qζ oB hr hV hu hσ hE hA',widerT P₀ E Θ Uv i0 ξ Fu Q M α wΦ At T0 hT Tz Vτ.e (Vτ.ν+1) kv a (fun x=> skimP L bPd x) hv (hdR.mono fun _ h=>h.opens) hrV] with x hδ hs hv hx hk; obtain ⟨c,hc⟩:= hx; obtain ⟨hV,hJ,hK,hξ⟩:=hV₁ b i l
       exact ⟨s,Mn,wΦ,At,T0,C2,Ct,Br,u,V' b i l,C₁,B₁,S₀,bPd,bQd,c,Wτ b i l,hk,hδ,h₁,hv,hc,hs,⟨hA,le_max_right ..,le_max_left ..⟩,hT,lt_of_lt_of_le (by norm_num) ((le_max_left ..).trans (le_add_of_nonneg_right (by norm_num))),hq,⟨hV,hK,hξ⟩⟩
