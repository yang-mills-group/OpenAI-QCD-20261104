lemma someK_col (hJ:ops i≠∅)(he':τ ≤ β' e0): Woven (A₀).site (A₀).support O α A₁ (valueH i (caseT N' Z O L s) (ψ₁) (p!)):=by
    let n' := deckP L s; let f₀:= fern L^5; let X':=(U₀).support
    have hθ:= hO ▸ hδ; obtain ⟨hh₁,hh₂⟩:=detailed Y G₁ hy l' hU hθ
    have hxB:coverNumber R.B X' ≤ n':=by unfold X'; rw [hU]; exact hh₁
    obtain ⟨ε,V,Q',ζ₀,ρ',hε,hR,hρ,hN,hMQ,hF,hB',hQ',hz',heX,hρ',hA,hB,hρV,hG',hv,hN',hX'⟩:= hh.law.purse
    have h₀R:R.B ≤ 2*radiusB s:= hh.harp
    let r' x := Hera.lyreFee N' x D O R L X' (Q.halo+5) s (gStep β); let H₀:=hh.planet
    have hb:0≤gStep β:=by unfold gStep; positivity
    have hΨ'(t)(ht':0≤t): r' t ≤ t*Hera.dueFee N' O n':= Hera.tern H₀ h₀R hh.hemp hb ht' _ hxB
    obtain ⟨f0,f1,v1,w1,w2,w3,w4,w5,w6,Ψ₀,hY,h0⟩:=hs
    have h'a:=hG.travel; obtain ⟨h1,h2⟩:=hh.wood.dawn _ h'a hτ; have hξ: 1≤ ξ:=ha.post
    have h'A: 4*(fingers N*φ*y)≤ x/4:= hj.trans (by linarith [ha.bud]); have hf:= islands χ Y G₁ Y₀ i l' hy U hU _ hX hW Z D hp g ha hr.le hf hu hQ hk h'A hθ (fun U V H=> gridBeam _ (hB' f U V _ _ H) hz') hN' hX' hG hz (by assumption)
    dsimp only at hf; simp only [if_neg hJ] at hf
    let b:= ∏ i∈ ops i, (μ₀) i; let p₁:= ψ₁; let x':= ∏ i'∈i,p! i'; let Z':=caseT N' Z O L s; let k:ℝ:=(ops i).card; let n:ℕ:= ( hooks (F:=N) (sliceL G H') (coreW Gz G₁ i)).card; let z' := σ/(t'/2); let D₁:= arid s
    have he': 0 ≤ b:=prod_nonneg (fun i _=>hΓ.2.2.2.2.1 (.inl i)); have hv₀: 0 ≤ x':=prod_nonneg (fun i _=>hΓ.2.2.2.2.1 i); have hP1:0<p₁:=zero_lt_one.trans_le hΦ; have hK0:0≤ k:=by unfold k; positivity
    have hZ': 2 ≤ Z':=caseN ..; let c:= τ*b; have hc: 0 ≤ c:=by unfold c; positivity; -- indent
    have hR0:c ≤ p₁⁻¹*x':=by
       have he : x'=p₁*b*(Real.exp (β' e0)-1):=by unfold x' b; rw [expensesW, invSize,hX, hy.stops]; simp only [priceSet, hX,hy.stops,sum_empty,Finset.card_empty, Nat.add_zero,Finset.card_singleton,pow_one,Nat.mul_zero,pow_zero,mul_one, prod_singleton,prod_empty]; ring
       rw [he, ←mul_assoc, ←mul_assoc,inv_mul_cancel₀ hP1.ne',one_mul]; unfold c; rw [mul_comm]; apply mul_le_mul_of_nonneg_left _ he'; linarith [Real.add_one_le_exp (β' e0)]
    have htP:1≤ Z'*(k+1):=one_le_mul_of_one_le_of_one_le (by linarith) (by linarith); have ht: 0≤ valueH i Z' p₁ (p!):=mul_nonneg (by positivity : 0 ≤ p₁⁻¹*x') (zero_le_one.trans htP)
    let V':= Hera.grandFee Z; have hV':0≤V':=sinR Z; have ht':0 ≤ D₁:=sq_nonneg _
    have hz':0≤z':=div_nonneg hN' (half_pos Y₀.positive).le
    have hu : 0 ≤ D₁*c:=mul_nonneg ht' hc; have hδ':0 ≤ (n:ℝ):=Nat.cast_nonneg _; have hx :0 ≤ D₁*c*(τ*Real.exp τ+(n*(ξ*z')+k*z')):=by positivity
    have hzψ:0≤ Hera.dueFee N' O n':=alert ..
    apply fundsL_colored Y hL he hp hO i' l' (grill Y G₁ hy hU) Ω hY h0 hZ hΨ p hP Y₂ hV hδ hf hu hx (mul_nonneg hV' hu) ht
    obtain ⟨h,hK⟩:= h2 n (Nat.cast_nonneg n) (Nat.cast_le.mpr hh₂)
    have hΓ0:f₀ ≤1:=pow_le_one₀ (fern_pos _).le (fern_one _)
    have he : D₁*c*(τ*Real.exp τ+ (n*(ξ*z')+ k*z'))*|z|+D₁*c*|p'|≤ c+k*c:=by
       apply le_trans (b:=f₀*c+k*(f₀*c)) _ (add_le_add (mul_le_of_le_one_left hc hΓ0) (mul_le_mul_of_nonneg_left (mul_le_of_le_one_left hc hΓ0) hK0))
       apply le_trans _ (show _+ _ ≤ _ from add_le_add (show (D₁*τ*(τ*Real.exp τ+n*(ξ*z'))*|z|+D₁*τ*|p'|)*b ≤ f₀*c from (mul_le_mul_of_nonneg_right h he').trans_eq (by unfold c f₀; ring)) (mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hK hc) hK0))
       apply le_of_eq; change _=(_* b)+k*(D₁*z'*|z| * c) -- edit bars
       unfold c; ring
    have hpK:= hΨ' (V'*(D₁*c)) (mul_nonneg hV' hu)
    apply (add_le_add he hpK).trans; apply le_trans _ (mul_le_mul_of_nonneg_right hR0 (zero_le_one.trans htP))
    unfold Z' caseT; change c+k*c+V'*(D₁*c)* Hera.dueFee N' O n' ≤ c*((2+D₁*V'*Hera.dueFee N' O n')*(k+1)); nlinarith [mul_nonneg (mul_nonneg (mul_nonneg hu hV') hzψ) hK0,mul_nonneg hK0 hc]
end YM.QCD.Shells
