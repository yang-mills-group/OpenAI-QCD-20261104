lemma manyK_col (hh':2 ≤ (leftE i).card): Woven (A₀).site (A₀).support O α A₁ (valueH i (caseT N' Z O L s) (ψ₁) (p!)):=by
   let p₁:= ψ₁; let x':ℝ := ∏ i'∈i,p! i'; let Z:= caseT N' Z O L s; have hp':0 < p₁:=zero_lt_one.trans_le hΦ; have hΨ':0 ≤ x':= prod_nonneg (fun i _=> hΓ.2.2.2.2.1 _); have hf':0≤p₁⁻¹*x':=by positivity
   have hz':2≤ Z:=caseN ..; have hpV:= hO ▸ hδ
   have h:= campR (O:=O) (N':=N') (D₀:=g) Y G₁ Gz i hy ha hΩ hf l' hU ht hz.le hp' (zero_lt_one.trans_le hχ) χ D le_rfl hpV
   obtain ⟨_,_,_,_,_,_,_,_,_,Ψ,hY,h0⟩:=hs
   let n:=(leftE i).card; have hρ:0 ≤ (↑(ops i).card +1:ℝ):=by positivity
   have htP:1≤ Z*((ops i).card+1:ℝ):=one_le_mul_of_one_le_of_one_le (by linarith) (by linarith only [Nat.cast_nonneg (α:=ℝ) (ops i).card]); have ht :0 ≤ valueH i Z p₁ (p!):= mul_nonneg hf' (zero_le_one.trans htP)
   apply fundsL_colored Y hL he hp hO i' l' (grill Y G₁ hy hU) Ω hY h0 hZ hΨ p hP Y₂ hV hδ h le_rfl ?b0 le_rfl ht
   case b0 => exact mul_nonneg (sq_nonneg _) (mul_nonneg (pow_nonneg (inv_nonneg.mpr hp'.le) _) hΨ')
   · simp only [Hera.lyreFee,Hera.ripple,mul_zero,zero_mul,add_zero]; change arid s*(p₁⁻¹^n*x')*|z| ≤ _
     apply le_trans _ (le_mul_of_one_le_right hf' htP); calc
       _ ≤ arid s*(p₁⁻¹^2*x')*|z|:=by
          have hx:p₁⁻¹^n ≤ p₁⁻¹^2:=pow_le_pow_of_le_one (inv_nonneg.mpr hp'.le) (inv_le_one_of_one_le₀ hΦ) hh'
          exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hx hΨ') (sq_nonneg _)) (abs_nonneg _)
       _ = (arid s*p₁⁻¹*|z|)*(p₁⁻¹*x'):=by ring
       _ ≤ _:=mul_le_of_le_one_left hf' hh.wood.swift
