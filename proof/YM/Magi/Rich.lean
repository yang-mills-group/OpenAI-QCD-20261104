lemma routingV (j m:ℕ)(hm:m ≤ n)(Q: Set (Finset Iq))(hk:j ≤ m)(p: Qm m)
   (hF:∀ i, j ≤ i→ i < m→ Fires (o i) l₁ ∧ (o i)=((stepper P₀ A X B T i).visit K (A.next (B.n k) i)).ratio.parent∘o (i+1) ∧ ShelfY (A.spacing i) θ (clockQ P₀ A x i) l₁) (hv:∀ i,j ≤ i → i ≤ m → 1≤ fan (A.spacing i) θ (clockQ P₀ A x i)) :
   ∃ q:Qm j,∀ (a:ℕ)(g:Fin a→Iq), (↑(MassiveQCD.Sample.Quills.crest g).powerset:Set (Finset Iq))⊆ Q→ titlesV P₀ A X B T V U W E M₀ he Y C Ht O L1 hC q' j (hk.trans hm) q.R q.K' g= give (gainV (Wr) j m) (MassiveQCD.Sample.Quills.crest g) • voyageW P₀ A B V W (titlesV P₀ A X B T V U W E M₀ he Y C Ht O L1 hC q' m hm p.R p.K' g) hk:=by
       have ht(i:ℕ)(hi:j≤ i)(hp':i ≤ m):∃ q:Qm i,∀ (a:ℕ)(g:Fin a→ Iq), (↑(MassiveQCD.Sample.Quills.crest g).powerset:Set (Finset Iq))⊆ Q→ Hv i (hp'.trans hm) q.R q.K' g= give (gainV (Wr) i m) (MassiveQCD.Sample.Quills.crest g) • voyageW P₀ A B V W (Hv m hm p.R p.K' g) hp':=by
            induction hp' using Nat.decreasingInduction with
            | self=>
                refine ⟨p,fun a g hx=>?_⟩; have heQ:give (gainV (Wr) m m) (MassiveQCD.Sample.Quills.crest g)=1:=by simp [give,gainV]
                let p':= Hv m hm p.R p.K' g; rw [heQ,one_smul,show voyageW P₀ A B V W p' (le_refl m)=p' from Nat.decreasingInduction_self (motive:=fun i _=> Massive.Density (A.ring (B.n k) i) 6) (fun i _ D=> (Tx i) D) p'] -- lookup simp
            | of_succ i hx ih=>
                have hh':= hi.trans (Nat.le_succ i); obtain ⟨q,hZ⟩:= ih hh'
                obtain ⟨ha,hf,htS⟩:= hF i hi hx; have hQ:= (hO i).2
                obtain ⟨q0,hV'⟩:= possiblesV P₀ A X B T Z V U W F hp E M₀ he Y C Ht O L1 hC l₁ o q' ht hQ.1 (hx.trans_le hm) q htS ha hf.symm Q -- order?
                refine ⟨q0,fun a g he0=>?_⟩; let v:=MassiveQCD.Sample.Quills.crest g; have hL:=sanctify P₀ A X B T V U W F hX E M₀ he Y hh C Ht O L1 hC q0.R q0.K' (o i) q' q0.fee q0.live _ _ q.R q.K' Q (o (i+1)) q.fee q.live hV' (hv i hi hx.le) (hv _ hh' hx) (he0 (mem_powerset.mpr (empty_subset ..))) g he0; rw [hL,hZ a g he0,Rails.scalar_transfer]; let H:= Hv m hm p.R p.K' g; let y:= voyageW P₀ A B V W H hx
                have he' : voyageW P₀ A B V W H hx.le=(Tx i) y:=Nat.decreasingInduction_succ_left (motive:=fun i _=> Massive.Density (A.ring (B.n k) i) 6) (fun i _ D=> (Tx i) D) H hx hx.le
                change _= _ • voyageW P₀ A B V W H hx.le; rw [he',jumpV (Wr) m hx,mul_smul]
       exact ht j le_rfl hk
