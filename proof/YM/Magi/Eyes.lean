-- param progress.stamps.V independent heights.Clock.Path.
structure AtmosV (L:Side)(r b c:ℕ)(z:ℝ) :Prop where
       strong : 1 ≤ run L z
       lights : ∀ i≤distV L r z,run L z≤run L (riseV L z i)
       life : ∀ i<distV L r z, let s:=riseV L z (i+1); filmsK L b z i ≤ freshS L (rentA b r) s ∧ measureV L 1 s*(fiery su s L + filmsK L b z i) ≤ filmsK L b z (i+1)
       forecast (k:ℕ): k≤ distV L r z→∀ i<k, let t:=riseV L z (i+1); let d:=rentD b c r; pitchG L c z k (i+1)≤ measureV L d t ∧ pitchG L c z k (i+1)*measureV L 1 t ≤ pitchG L c z k i ∧ pitchG L c z k i ≤ measureV L d t
       earns (k:ℕ) (h:k≤distV L r z) : ∀ i≤ k,let d:=rentD b c r; 0 ≤ slipsG L d z k i ∧ slipsG L d z k i ≤ cutOffV L (1/320) z ∧ cutOffV L (1/320) z≤1
       tight (k:ℕ)(h:k≤ distV L r z) : ∀ i<k,let t:=riseV L z (i+1); let d:=rentD b c r; spendsK L d t (slipsG L d z k (i+1)) ≤ slipsG L d z k i
-- chooses after-L receipts. Pearl for fixed arc only; not changing P.l.
lemma futureV (L:Side)(r b c:ℕ)(h:1<L.val)(hb:4 ≤ b):∀ᶠ z in atTop,AtmosV L r b c z:=by
       filter_upwards [(Work.E09.betaF_growth su L).eventually_ge_atTop 1,lapsV L r,prospectsV L h b r hb,pincerV L h b r c,pest L h (rentD b c r) r,gainingV L h (rentD b c r) r] with z ha he hv ht hw hh; exact ⟨ha,fun i hi=> (he i hi).1,hv,ht,hw,hh⟩
