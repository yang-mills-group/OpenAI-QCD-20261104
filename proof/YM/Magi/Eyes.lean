      fuel : AtmosV (Z0.fixed j).flight.L n b bP x
      review : ∀ i:ℕ,TermV P₀ E l₁ l₂ lℓ kℓ mℓ (rentA b n) (rentD b bP n) gT _ _ _ _ _ _ (M (Z0.fixed j) (Z0.resource j)) (riseV (Z0.fixed j).flight.L x i)
