lemma shiftsV (hi: Z0.Lead f pad j i) (x:ℝ)(h: TermV P₀ E l₁ l₂ lℓ kℓ mℓ t d' gT _ _ _ _ _ _ U x): Tg _ _ _ _ _ _ (G! i) x:=by
      have hj: HEq (U) (G! i):= keeper P₀ Z0 f pad j M hi
      have ht (b b':ChangeQ)(G:Flight b.old b.new)(G':Flight b'.old b'.new)(Θ Θ' σ σ' Λ Λ':ℝ)(p p':ParcelR)(Y:LedgerQ (P₀ b) tol G Θ σ Λ p)(X:LedgerQ (P₀ b') tol G' Θ' σ' Λ' p') (h:b=b')(he:HEq G G')(hx:Θ=Θ')(hy:σ=σ')(hv:Λ=Λ')(hz:p=p')(hp:HEq Y X) (hX: Tg _ _ _ _ _ _ Y x): Tg _ _ _ _ _ _ X x:=by subst b'; cases he; subst Θ' σ' Λ' p'; cases hp; exact hX
      have he := node_lead P₀ Z0 f pad j hi; exact ht _ _ _ _ _ _ _ _ _ _ _ _ U (G! i) (node_age P₀ Z0 f pad j hi).symm (dayLead P₀ Z0 f pad j hi).symm (congr_arg (fun x=> x.Θ) he.symm) (congr_arg (fun x=>x.c) he.symm) (statusLead P₀ Z0 f pad j hi).symm (congr_arg (fun x=>x.fare) he.symm) hj h
