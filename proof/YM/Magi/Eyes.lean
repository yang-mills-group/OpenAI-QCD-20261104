lemma gazesV (h:4≤ b)(he:(Z0.fixed j).flight.patch.Branches K su): ∀ᶠ x in atTop, AT x:=by
   have ht:= (Z0.fixed j).flight.coarse
   filter_upwards [futureV L' n b bP (show 1 < (L').val from by omega) h,aheadΩ L' _ (realizesV P₀ E l₁ l₂ lℓ kℓ mℓ TA DA gT (by unfold rentA; omega) (by unfold rentD; omega) _ _ he _ _ _ _ U)] with x ht hv; exact ⟨ht,hv⟩
lemma watchesV (hx: AT x) (X':ℝ) (hs: x =clockQ P₀ T X' i) (hp: Z0.Lead f pad j i)(hk: Z0.Lead f pad j (i+k)) : TG _ _ _ _ _ _ (G! (i+k)) (clockQ P₀ T X' (i+k)):=by
   have hb:= hx.review k
   refine shiftsV P₀ E _ _ _ _ _ _ _ gT Z0 f pad j M hk _ ?_; rw [ridgeV P₀ Z0 f pad j X' hp hk,← hs]; exact hb
