lemma degreeC (d:ℝ): Jets.Touch.Seat L 0 (fun x=> LampV.columnV l k b (radiusB (run L x)) 1 d):=by
     unfold LampV.columnV LampV.crewL; push_cast; let h:= (Advent.stature L).timesL (majorT l:ℕ); exact (((((h.comb h|>.comb (Jets.Touch.Seat.numbers 1)).powered 4).above (by linarith)).times k |>.times b).times 1).times _
lemma heightsV (x:ℝ)(d:ℕ) (C:ℝ)(B:ℕ): LampV.columnV l k b B x C=x*LampV.columnV l k b B 1 C:=by unfold LampV.columnV; ring
-- certified warm estimate Arm if prices of corrected on each generator are ≥.
lemma spinK (h:1<L.val)(c:ℝ)(r:ℕ):∀ᶠ z in atTop,∀ i≤distV L n z,let y:=riseV L z i; let t:=BL y; let B:=radiusB t;
    LampV.columnV l k b B (ember L z) (1/32) ≤(1/2)* budgetV L y ∧
    LampV.columnV l k b B (fee₂ L c y) (1/16+1) ≤ ash L y ∧
    Real.exp (fee₂ L 1 y) ≥ t^(r:ℕ)+1 :=by
     have hD:= degreeC L l k b (1/32); have hx:= degreeC L l k b (1/16+1); have hp: Jets.Touch.Seat L 0 (fee₂ L c):=(Advent.stature L).timesL c; have hv:= (hp.ponies hx); have h1: Jets.Touch.Seat L 2 (fun x=>4*fan L 2 x):= Jets.Touch.Seat.keeps.timesL _
     have hF: Rate su L r (fun x :ℝ=>(BL x)^r+1):=by have he: Rate su L (r:ℝ) (fun x=>(BL x)^r):=(Rate.hat.pow _|>.weaken (by norm_num)); exact he.add ((Rate.const _).weaken (Nat.cast_nonneg _))
     have ht:∀ᶠ x:ℝ in atTop,(BL x)^r+1 ≤ Real.exp (fee₂ L 1 x):=by
          filter_upwards [Reel.playability L (r:ℝ) _ (show (0:ℝ)<128 from by norm_num) hF,eventually_ge_atTop (1:ℝ)] with x hx hz; -- Reel.playability expat radiusB x NOT x⁺, need mono
          refine (le_abs_self _).trans (hx.trans ?_); apply Real.exp_monotone; rw [show (_ :ℝ) / 128=1 from (by norm_num : (128:ℝ)/128=1)]; unfold fee₂; apply mul_le_mul_of_nonneg_left (Nat.cast_le.mpr (Nat.ceil_le_ceil (pow_le_pow_left₀ (Real.log_nonneg hz) (Real.log_le_log (lt_of_lt_of_le zero_lt_one hz) (show x≤BL x from le_add_of_nonneg_right (Work.E04.shift_nonneg su L))) 2))) zero_le_one
     filter_upwards [aheadΩ L _ (hD 1 zero_lt_one),aheadΩ L _ (hv (1/8:ℝ) (by norm_num)),aheadΩ L _ (h1 3 (by norm_num)), aheadΩ L _ ht, curtailV L n 1 h,curtailV L n 3 h,goCost L 3 4 2 1 h (by norm_num)] with z hp hv hy hτ hA hB hd i hi t' b' B -- `let` binder? using filter_upwards. 
     let y:=riseV L z i; let B:=radiusB (BL y); let M:= LampV.columnV l k b B 1 (1/32)
     refine ⟨?_,?_,hτ i⟩
     · have ht: M ≤ EV 3 z:= ((le_abs_self _).trans (hp i)).trans (hA i hi); have hb :4*fan L 2 y ≤ EV 3 z:= ((le_abs_self _).trans (hy i)).trans (hB i hi); have hψ :fan L 2 y>0:=fan_pos ..; have hπ:0<EV 4 z:=χone ..
       have hK:4*fan L 2 y*M ≤ EV 4 z:=by rw [one_mul,pow_two] at hd; exact (mul_le_mul_of_nonneg_left ht (by positivity : 0 ≤ 4*fan L 2 y)).trans ((mul_le_mul_of_nonneg_right hb (χone ..|>.le)).trans hd)
       have hh:(1/2:ℝ)*budgetV L y=(4*fan L 2 y)⁻¹:=by
               unfold budgetV chipV fan; rw [Real.rpow_neg (Delay.monitor_pos su L y|>.le)]; ring
       change LampV.columnV l k b B (ember L z) (1/32) ≤ (1/2)*budgetV L y; rw [hh,heightsV l k b (ember L z) 0 _ B]; unfold ember; -- M local
       rw [inv_mul_eq_div]; field_simp; linarith only [hK,show LampV.columnV l k b B 1 (1/32)=M from rfl,congr_arg (fun a=>a*fan L 2 y) (show LampV.columnV l k b B 1 (1/32)=M from rfl)]
     rw [heightsV l k b _ 0 _ _]; exact (le_abs_self _).trans (hv i)
