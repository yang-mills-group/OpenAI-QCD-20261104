lemma dustV (hL:1<L.val)(h:ℝ)(m k:ℕ): ∀ᶠ z in atTop,∀ i≤ distV L n z,let y:= riseV L z i;
     (fan L h y)^k * ((fuelColor 6)^k * (measureV L l z^m * cutOffV L (1/320) z + (measureV L 6 z)⁻¹)) ≤ ember L z:=by
     let s x:= measureV L l x^m * cutOffV L (1/320) x; let v:= fuelColor 6; have hq:1 ≤ v:=le_max_left ..
     have hx : Rate su L (-(1/320)) (fun x=> EV 6 x * s x) := Rebus.Rift.pmul' (Rebus.Rift.pmul' (Rate.power (a:=-(1/320:ℝ))) (Rebus.Rift.powV (rateMeasure L l) _)) (rateMeasure L _)
     filter_upwards [hx.below (by norm_num) 1 zero_lt_one,goCost L 4 6 (k+1) (v^k*2) hL (by norm_num), (buysV L).eventually_ge_atTop 1,curtailV L n h hL, Delay.shift_pos su L] with z hx ht h hh hz i hi y
     let U:= EV 6 z; have hv:0< U:= χone ..; have hf:s z ≤ U⁻¹:=by
          have hp: U*s z ≤1:=(le_abs_self _).trans hx; calc
              s z ≤ 1/U:= (le_div_iff₀ hv).2 (by rw [mul_comm]; exact hp)
              _= _:= one_div _
     have hC:0≤ s z:=mul_nonneg (pow_nonneg (χone ..|>.le) _) (Real.rpow_nonneg hz.le _); let q:= EV 4 z; have hp:0<q:=χone ..
     calc
       _ ≤ q^k*(v^k*(2*U⁻¹)):=mul_le_mul (pow_le_pow_left₀ (fan_pos ..|>.le) ((hh _ hi).trans (outR L _ _ z h (by norm_num))) _) (mul_le_mul_of_nonneg_left (show s z + U⁻¹ ≤ 2*U⁻¹ from by linarith only [hf]) (pow_nonneg (zero_le_one.trans hq) _)) (mul_nonneg (pow_nonneg (zero_le_one.trans hq) _) (add_nonneg hC (inv_pos.mpr hv|>.le))) (pow_nonneg hp.le _)
       _ ≤ _:=by change _≤q⁻¹; field_simp; calc
                                     _= v^k*2*q^(k+1):=by ring
                                     _≤ _:=ht
lemma goalsV (hL:1<L.val) :∀ᶠ z in atTop,∀ i≤distV L n z,let y:=riseV L z i;
     (EV l z)^k ≤ (1/2)*bloomV L z ∧ taxK L y (15/16)*((EV l z)^k) ≤ taxK L y (31/32) ∧ 8 ≤ radiusB (run L y) ∧ 2*(EV l z)^k ≤ Real.exp ((1/32:ℝ)/64* radiusB (run L y)):=by
     have hp:= Rebus.Rift.powV (rateMeasure L l) k; have ht:∀ᶠ x in atTop,2*(EV l x)^k ≤ Real.exp ((1/32:ℝ)/64*radiusB (run L x)):=by
          filter_upwards [Reel.playability L 0 _ (show (0:ℝ)<1/16 from by norm_num) (hp.mul_left 2),eventually_ge_atTop (1:ℝ)] with x ht hx
          have h:radiusB x ≤ radiusB (run L x):= Nat.ceil_le_ceil (pow_le_pow_left₀ (Real.log_nonneg hx) (Real.log_le_log (by linarith) (show x ≤ run L x from le_add_of_nonneg_right (E04.shift_nonneg su L))) _)
          have he : 2*(EV l x)^k ≤ _:= (le_abs_self _).trans ht; refine he.trans (Real.exp_monotone ?_); have hh:(1/16:ℝ)/128=1/32/64:=by ring
          rw [hh]; exact mul_le_mul_of_nonneg_left (Nat.cast_le.mpr h) (by norm_num)
     have hh:=Jets.Touch.upperTax L (1/32) (by norm_num) _ 0 hp
     filter_upwards [hp.mul_left 2 (1/32:ℝ) (by norm_num),aheadΩ L _ hh,dollsV L n, aheadΩ L _ ht,aheadΩ L _ ((Work.E01.radiusB_tendsto.comp (Work.E09.betaF_growth su L)).eventually_ge_atTop 8)] with z hx hh ht he hy i hi y; have hp:EV l z≤ EV l y:=prizeE L (ht _ hi).1 l
     have h': (EV l z)^k≤(EV l y)^k:=pow_le_pow_left₀ (χone ..|>.le) hp _
     refine ⟨by linarith only [show 2* (EV l z)^k ≤ bloomV L z from (le_abs_self _).trans hx],?_,hy i,(mul_le_mul_of_nonneg_left h' (by norm_num)).trans (he i)⟩
     apply (mul_le_mul_of_nonneg_left (h'.trans (hh i)) (Real.exp_pos _).le).trans; unfold taxK; rw [← Real.exp_add]; apply le_of_eq; congr 1; ring
