structure RimBook (N:ℕ)(l₁ l₂ lℓ kℓ b n:ℕ)(Z:ℝ)(θ:ℝ)(z:ℝ) : Prop where
     headP : 1 ≤ BL z
     tick : 1 ≤ticksV L z
     width : RouteV L n (refuge lℓ+20) z
     post i : i ≤ distV L n z → let y:=riseV L z i; let t:=run L y; let B:=radiusB t; let s:= columnV lℓ l₁ l₂ B; let v:= fan L θ y; let A:= measureV L b z; let d:=fee₂ L 1 y;
         SchemeP L y Z ∧ s (ember L z) (1/32) ≤ (1/2)*budgetV L y ∧ s d (1/16+1) ≤ ash L y ∧ Real.exp d ≥ t^N+1 ∧ 8 ≤ B ∧ 1 ≤ v ∧ v^(lℓ*kℓ) * (fuelColor 6^(lℓ*kℓ) * (A^lℓ * cutOffV L (1/320) z+(measureV L 6 z)⁻¹))≤ ember L z ∧ A^lℓ ≤ (1/2)*bloomV L z ∧ taxK L y (15/16)*A^lℓ ≤ taxK L y (31/32) ∧ 2*A^lℓ ≤ Real.exp ((1/32:ℝ)/64*B)
lemma rentsV (hL:1<L.val)(N:ℕ)(l₁ l₂ lℓ kℓ b n:ℕ)(Z Θ:ℝ)(hZ:0 < Z)(hT:0<Θ):∀ᶠ x in atTop,RimBook L N l₁ l₂ lℓ kℓ b n Z Θ x:=by
     filter_upwards [(Work.E09.betaF_growth su L).eventually_ge_atTop 1,(buysV L).eventually_ge_atTop 1,findsV L n (refuge lℓ+20) hL,aheadΩ L _ (forestV L Z hZ),spinK L lℓ l₁ l₂ n hL 1 N,dustV L b n hL Θ lℓ (lℓ*kℓ),goalsV L b lℓ n hL,aheadΩ L _ ((Jets.Touch.Seat.your L).eventually_ge_atTop 1)] with x ht hx hY h hh hp hk hb
     refine ⟨ht,hx,hY,?_⟩; intro i hi y t B s v A d; exact ⟨h i,(hh _ hi).1,(hh _ hi).2.1,(hh _ hi).2.2,(hk _ hi).2.2.1,Real.one_le_rpow (hb i) hT.le,hp _ hi,(hk _ hi).1,(hk _ hi).2.1,(hk _ hi).2.2.2⟩
end
