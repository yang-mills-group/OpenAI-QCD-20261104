lemma restsQ (hCw:1 ≤ vT)(hi:i≤ n) (Z:Grid cp): pluck (Keys cp 6) (∅:Finset (Spine Iq)) (Lf i hi Re Fk Z)= Pn i hi Z:=by
     have heK:= fogsI P₀ A X B T V U W hX E M₀ he Y C Ht O L1 hC hi hCw
     let g:=fun i=> lift (o i); have ho:(wrap cp ∘ g)=o:= funext fun i=> wrap_lift _
     have hv:= hV.warm; refine atom_zero 6 q' o Z Re Fk ((ΛK hi).EvalK (ζl i)) (P1).threshold _ hv.book hV.heat ?_ ?_ heK -- order
     · exact flyer o q' Re hv (by norm_num) hV.cusp hCw
     · have hη:1≤taxK qS sⁱ (7/8):=Real.one_le_exp (mul_nonneg (by norm_num) (fan_pos ..).le)
       intro W; apply PayLayer.freshT g q' Fk W (Pt i) hCw hη (by norm_num: (0:ℝ) ≤ 1/32) hV.doneK; rw [ho]; exact hV.heat
