lemma sanctify (ht:1 ≤ vT)(hp:1 ≤ fan (A.spacing (i+1)) θ (clockQ P₀ A x (i+1))) (hQ:(∅:Finset Iq)∈Xq) (f:Fin n'→Iq)(he': (↑((MassiveQCD.Sample.Quills.crest f).powerset):Set (Finset Iq))⊆Xq): Hv i hi.le Re Fk f= give u (MassiveQCD.Sample.Quills.crest f) • Tx (Hv (i+1) hi R H' f):=by
     obtain ⟨C',h,Yv⟩:=hf.changeQ; let S: Finset (Spine Iq):=∅
     have hx : Tx (Pn (i+1) hi)= C' • Pn i hi.le:=by
           have ht0:ignites u S=1:=by simp [S,ignites]
           have hP : Pn i hi.le= pluck (Keys cp 6) (∅:Finset (Spine Iq)) ∘ Pc :=(funext fun Z=>restsQ P₀ A X B T V U W hX E M₀ he Y C Ht O L1 hC Re Fk o q' ω' hV ht hi.le Z
             ).symm
           have hP': Pn (i+1) hi= pluck (Keys fp 6) S ∘ Pf:=(funext fun Z=> restsQ P₀ A X B T V U W hX E M₀ he Y C Ht O L1 hC R H' v0 q' Qw hF hp hi Z).symm -- P1 support
           rw [hP,hP']; exact funext fun V=>by
                have hd:=Yv ∅ (by simpa only [Finset.powerset_empty,Finset.coe_singleton,Set.singleton_subset_iff] using hQ) S (by simp [S]) V; dsimp only at hd; rw [ht0,one_smul] at hd; exact hd -- defeq
     let f' := MassiveQCD.Sample.Quills.crest f; let K':= burst q' f'
     have hr : Ωᴮ (i+1) hi * C'=Ωᴮ i hi.le:= starP P₀ A X B T V U W F E M₀ he Y hh C Ht O L1 hC _ hi _ hx
     let L':= pluck (Keys fp 6) K'; let Λ:= pluck (Keys cp 6) K'; have hΨ : give u f' • Tx (L' ∘ Pf)= C' • (Λ ∘ Pc) :=by
          rw [← attuned u f' q'] -- args
          exact funext fun Y=> Yv f' he' K' (located q' f') Y
     unfold titlesV; rw [← hr, mul_smul,Rails.scalar_transfer,smul_comm (give ..)]; congr 1
     change C' • (signG q' f • (Λ ∘ Pc))= give u f' • Tx (signG q' f • (L' ∘ Pf)); rw [smul_comm,Rails.scalar_transfer,smul_comm (give u f'), ← hΨ]
