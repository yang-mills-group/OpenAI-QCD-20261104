lemma sphereV (hj: j0 ≤ i)(hq:i < n₀)(hi:i < n) (Φ:Quince fp 6 Iq)
   (E₁: Reel fp 6 Iq AA)(F₁: Film fp 6 Iq BB)(S₇:Finset AA)
   (hR: ArchV P₀ A B V lℓ kℓ mℓ Vf q' (i+1) (o (i+1)) Φ (Fp (i+1-j0)) (Sp! (i+1-j0)) (pK (i+1-j0)) rV E₁ F₁ S₇ (Pt:=Pt) (x:=x))(hΛ:Fires (o i) l₁)(hf:Af=o i)
   (hJ:∀ i∈Vf,i.card ≤ lℓ)(hε:∀ i,(Vf.filter (fun j=>i∈j)).card≤ l₂)(hD: Set.Subset Vf Q)(hY:∀ i∈Vf,∀ j:Finset Iq,j⊆i→ j∈Vf)
   (ha:∀ q, |wr i q| ≤ ratioCostV qS sⁱ)(hz:∀ q, wr i q ≠0):
    ∃ (G':Type)(_ :Countable G')(K':Type)(_ :Countable K')(Re': Reel cp 6 Iq G')(F':Film cp 6 Iq K')(S':Finset G'), ArchV P₀ A B V lℓ kℓ mℓ Vf q' i (o i) (epochV P₀ A X B T hi Φ (wr i)) (Fp (i-j0)) (Sp! (i-j0)) (pK (i-j0)) rV Re' F' S' (Pt:=Pt) (x:=x) ∧ WorkV P₀ A X B T V U W E M₀ Y C E₁ F₁ w Q (wr i) hi Re' F':=by
    obtain ⟨hs,hw⟩:= hQS.held i hj hq.le
    have hL:= Jv.starts i hj hq.le
    have heQ:i+1-j0=i-j0+1:=by omega
    have hi':x⁺=riseV L v0 (i+1-j0):=by rw [heQ]; exact liftDay P₀ A L Jv hj hq
    have hwL :(i-j0)<n₀-j0:=by omega
    have hb:1≤rV:= Real.one_le_rpow ρv.strong (by norm_num)
    have hR0:rV≤lantern qS x⁺:=by rw [hi',hL]; exact caughtV _ _ _ ρv.strong (ρv.lights _ (by omega))
    have hI : 1≤ pK (i+1-j0):= one_le_mul_of_one_le_of_one_le (MintV.uniformV ..) (one_le_pow₀ (MintV.uniformV ..))
    obtain ⟨hT,hKQ,hK₁⟩:=ρv.forecast _ hAge _ hwL
    obtain ⟨hKH,hM⟩:=ρv.life _ (hwL.trans_le hAge)
    obtain ⟨hjU,hJg,hJK⟩:= ρv.earns _ hAge (i+1-j0) (by omega)
    have hx0:= ρv.tight _ hAge _ hwL
    have hF' : Fires Af l₁:=hf.symm ▸ hΛ
    -- cannot rw [←hf] at *.
    obtain ⟨W',hW,K',hK,E',F',T',hX,hν'⟩:= enginesV P₀ A X B T Z V U W F hp hX E M₀ he Y C Ht O L1 hC gT (o (i+1)) q' (wr i) Q E₁ F₁ S₇ Φ hs hw ht hi (by rw [hL]; exact hpL) ((hO i).2.2) ((hO i).2.1) (hsP.price _ hj hq) hb hR0 hF' hJ hε hD hY ha hz hI (by rw [hi',hL,heQ]; exact hT) (Sv:=pK (i-j0)) (by rw [hi',hL,heQ]; exact hKQ) (by rw [hi',hL,heQ]; exact hK₁) (Vv:=Fp (i-j0)) (by rw [hi',hL,heQ]; exact hKH) (by rw [hi',hL,heQ]; exact hM) hjU (hJg.trans hJK) hR (ε':=Sp! (i-j0)) (by rw [hi',hL,heQ]; exact hx0)
    rw [hf] at hX; exact ⟨_,hW,_,hK,_,_,_,hX,hν'⟩
