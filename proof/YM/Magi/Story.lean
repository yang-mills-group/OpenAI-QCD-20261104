lemma windpipeV (j m:ℕ) (hk0:j≤ m)(hm:m ≤ n)(G:∀ i:ℕ,j≤ i→ i≤ m→ KineV P₀ A B (o i)) (hs:∀ i (hp:j ≤ i)(hv:i≤ m),Hk (G i hp hv))(hq:∀ i(hp:j ≤ i)(hx:i < m),Uv (G i hp hx.le) Q (lt_of_lt_of_le hx hm) (G (i+1) (hp.trans (Nat.le_succ i)) hx))(hv:1≤Sv) (ht:∀ i, j ≤ i→ i≤ m → 1 ≤ fan (A.spacing i) θ (clockQ P₀ A x i)) (hb:(↑((MassiveQCD.Sample.Quills.crest g).powerset):Set (Finset Iq))⊆ Q) :
     let p:=G m hk0 le_rfl; let s:= Hv m hm p.R p.K' g; ∀ i (hp:j≤ i)(he:i≤ m),let q:=G i hp he; titlesV P₀ A X B T V U W E M₀ ‹_› Y C Ht O L1 hC q' i (le_trans he hm) q.R q.K' g= give (gainV wr i m) qG • Voy s he:=by
        intro PS sa i hp hx
        induction hx using Nat.decreasingInduction with
        | self=>
             intro q; unfold q; have hs : give (gainV wr m m) qG=1:=by simp [give,gainV]
             rw [hs,one_smul,show Voy sa (le_refl m)=sa from Nat.decreasingInduction_self (motive:=fun i _=> Massive.Density (A.ring (B.n k) i) 6) (fun i _ D=> (Tx i) D) sa]
        | of_succ i hm' ih=>
             intro p; have hx:=hp.trans (Nat.le_succ i); have ht0:= (tracedV P₀ A X B T V U W F hX E M₀ he Y hh C Ht O L1 hC j0 n₀ ℓn b' c' lℓ mℓ kℓ v0 L o q' Vf wr p g (hm'.trans_le hm) (ht _ hp hm'.le) (ht _ hx hm') _ hv (hs _ hp hm'.le) (hs _ hx hm') (hq i hp hm') hb); have htI:= ih hx
             rw [ht0]
             rw [show Voy sa hm'.le = (Tx i) (Voy sa hm') from Nat.decreasingInduction_succ_left (motive:=fun i _=> Massive.Density (A.ring (B.n k) i) 6) (fun i _ D=> (Tx i) D) sa hm' hm'.le]; rw [htI,Rails.scalar_transfer, jumpV wr m hm',mul_smul]
