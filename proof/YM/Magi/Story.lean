     have h x:gainV wr i m x=wr i x*gainV wr (i+1) m x:=by
         have h: Finset.Ico i m=insert i (Finset.Ico (i+1) m):=by ext j; simp; omega
         simp [gainV,h] -- ordering
     unfold give; rw [← prod_mul_distrib]; exact prod_congr rfl (fun i' _=> by rw [h,Complex.ofReal_mul])
