lemma realmV (hi:i < n)(ho:i < n₀)(h:j0≤ i)(hx:Fires (o i) l₁)(hu: Af=o i)(ha:∀ q,|wr i q| ≤ ratioCostV qS sⁱ)(hz:∀ q, wr i q≠0)(X':Kv! (i+1))(hR: Hk X') : ∃ Y: Kv! i, Hk Y∧Uv Y Q hi X':=by
    haveI:Countable X'.IW:= X'.count; haveI : Countable X'.KW:= X'.counts
    obtain ⟨W,u,J,v,R,T,Fk,hA,hL⟩:= sphereV P₀ A X B T Z V U W F hp hX E M₀ he Y C Ht O L1 hC j0 n₀ ℓn b' c' lℓ mℓ kℓ l₁ l₂ v0 L Jv hpL ρv gT hQS hsP o q' Vf wr hAge hO ht h ho hi X'.pol X'.R X'.K' X'.seed hR hx hu hf hε hD hk ha hz -- argument order hAge
    exact ⟨⟨_,_,R,T,Fk,_,u,v⟩,hA,⟨hL,rfl⟩⟩
lemma packageV (j m:ℕ) (hm0:m ≤n₀) (hj0:j0 ≤j)(hk0:j ≤ m)(hM:m ≤ n) (hT:∀ i, j ≤ i→ i < m → Fires (o i) l₁ ∧ (o i)=((stepper P₀ A X B T i).visit K (A.next (B.n k) i)).ratio.parent∘o (i+1) ∧∀ v:Iq,|wr i v| ≤ ratioCostV (A.spacing i) (clockQ P₀ A x i)∧ wr i v ≠0)(X':Kv! m)(hX': Hk X'):
    ∃ G:∀ i:ℕ,j ≤ i→ i ≤ m→ KineV P₀ A B (o i),G m hk0 le_rfl=X' ∧ (∀ i (hp:j≤ i)(ho:i ≤ m), Hk (G i hp ho)) ∧ ∀ i (hp:j≤ i) (hi:i < m), Uv (G i hp hi.le) Q (lt_of_lt_of_le hi hM) (G (i+1) (hp.trans (Nat.le_succ i)) hi):=by
    let H (i:ℕ) := {q:KineV P₀ A B (o i) // Hk q}
    have hz(i:ℕ)(hi:i < m) (hj: j ≤ i)(Yv: H (i+1)) : ∃ Z: H i, Uv Z.val Q (hi.trans_le hM) Yv.val:=by
        obtain ⟨ha,hQ,ht0⟩:= hT _ hj hi
        obtain ⟨k,h,g⟩:= realmV P₀ A X B T Z V U W F hp hX E M₀ he Y C Ht O L1 hC j0 n₀ ℓn b' c' lℓ mℓ kℓ l₁ l₂ v0 L Jv hpL ρv gT hQS hsP o q' Vf wr hAge hO ht hf hε hD hk (hi.trans_le hM) (hi.trans_le hm0) (hj0.trans hj) ha hQ.symm (fun j=>(ht0 j).1) (fun j=>(ht0 j).2) Yv.val Yv.property
        exact ⟨⟨k,h⟩,g⟩
    -- Motive ∀ i allowed after proving membership. parent selected by True ratio. 
    let a: H m:=⟨X',hX'⟩
    let g(i:ℕ)(h:i < m)(x:j ≤ i+1→ H (i+1))(hx:j≤ i):H i:=(hz i h hx (x (hx.trans (Nat.le_succ i)))).choose
    let R(i:ℕ)(h:i ≤ m):j ≤ i → H i:=Nat.decreasingInduction (motive:=fun i _=>j≤ i→ H i) g (fun _=>a) h
    refine ⟨fun i h ht=>(R i ht h).val,(?_),fun i hi h=> (R i h hi).property,fun i hj hi=>?_⟩
    · dsimp only; rw [show R m _= fun _=>a from Nat.decreasingInduction_self (motive:=fun i _=>j≤ i→ H i) g _]
    dsimp only; rw [show R i _=g i hi (R (i+1) hi) from Nat.decreasingInduction_succ_left (motive:=fun i _=> j≤ i→ H i) g _ hi hi.le]; exact (hz i hi hj _).choose_spec
