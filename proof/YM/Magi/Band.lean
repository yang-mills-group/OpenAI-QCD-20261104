lemma screening (B:SparkMesh) (J:IntervalE P₀ A L x v0 j0 n₀) (hT: AtmosV L nχ b' c' v0)(hv:n₀-j0  ≤  distV L nχ v0)(h:entire P₀ A x Pt):∀ᶠ k:ℕ in atTop, LensBase P₀ A B j0 n₀ k (Pt:=Pt) (x:=x):=by
     have hz : ∀ i∈Finset.Ico j0 n₀,∀ᶠ k:ℕ in atTop, LitG (A.spacing i) θ (clockQ P₀ A x i) (run (A.spacing i) (clockQ P₀ A x i))⁻¹ (Pt i) (A.ring (B.n k) i) F₀:=by
            intro i hi; obtain ⟨hp,hq⟩:= mem_Ico.mp hi; refine (Track.ringing A B i).eventually (greedV P₀ A Pt h i _ (inv_pos.mpr (?_))); rw [J.starts i hp hq.le,J.spins i hp hq.le]; exact lt_of_lt_of_le zero_lt_one (hT.strong.trans (hT.lights (i-j0) (by omega)))
     filter_upwards [(Filter.eventually_all_finset _).2 hz] with k hk; exact ⟨fun i hq he=>hk i (mem_Ico.mpr ⟨hq,he⟩)⟩
