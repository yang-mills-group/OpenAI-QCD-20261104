      · rw [←hΩ]; exact hs.withA
      · rw [rungs]; exact hR ▸ hCk.spanV
      rw [rateKA P₀ A Hp.ν Hp.βA Hp.H p₀ Jv h1.le hi' h2.le h3, mul_comm _ (measureV _ (Dial.βA _) _)]; exact mul_le_mul_of_nonneg_right He.rail (pow_nonneg (χone ..).le _)
