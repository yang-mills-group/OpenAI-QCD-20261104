       obtain ⟨γ,τv,hV,hP⟩:= Z.bene L C θ hC hθ
       have hr:= Work.E01.radiusB_tendsto.comp (Work.E09.betaF_growth su L)
       have hE(d:ℕ):∀ᶠ y in atTop, max Z.r (Γ d).r+1 ≤ highR L y:= hr.eventually_ge_atTop _
       have hp:= X.pace; have hR(d:ℕ):= ropes (θ:=θ) L X.αE X.ν X.e d D X.H (mantleT Θ U Γ Ωs εL Z bq α d) (capitalT Θ U Γ d) (album lℓ) hL (by unfold Dial.αE; omega) (by unfold Dial.αE; omega) (by unfold Dial.αE; omega) X.height (le_max_left ..) (le_max_left ..)
       have hv(d:ℕ):= pegs L (Fi bq L) d (41/256+1) γ hV (hP.mono (fun x h=>h.1))
       refine ⟨γ,?_⟩; have hy₁:∀ᶠ x in atTop,(8≤ highR L x) := hr.eventually_ge_atTop _
       have hy:∀ᶠ x in atTop,(8≤ highR L x)∧∀ d≤D,max Z.r (Γ d).r+1≤ highR L x:=by filter_upwards [hy₁,eventually_all.mpr (fun d:Fin (D+1)=>hE d.val)] with x hx hk; exact ⟨hx,fun d hd=>hk (⟨d,Nat.lt_succ_of_le hd⟩:Fin _)⟩
       have ht:∀ᶠ x in atTop,Taxing.Tropic (Fi bq L) L x∧∀ d≤ D,Taxing.rateX (γ x) (highR L x) (Fi bq L) d (41/256+1)≤ MassiveQCD.Cape.ash L x:= by filter_upwards [Taxing.chaff (Fi bq L) (L:=L),eventually_all.mpr (fun i:Fin (D+1)=> hv i.val)] with x hx hk; exact ⟨hx,fun d hd=>hk (⟨d,Nat.lt_succ_of_le hd⟩:Fin _)⟩
       filter_upwards [aheadΩ L _ hP,gemRay L (X.ν+1),tapier (θ:=θ) L (X.ν+1) D X.H X.ν hL,aheadΩ L _ hy, aheadΩ L _ ht,eventually_all.mpr (fun i:Fin (D+1)=> hR i.val)] with x hx h hp he hv hB; exact ⟨hx,h,hp,he,hv,fun i hi d hd p hp t h1 he q hh=>hB (⟨d,Nat.lt_succ_of_le hd⟩) i hi p hp t h1 he q 4 hh⟩
