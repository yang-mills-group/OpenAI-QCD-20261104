      have hU:= itinerant P₀ A X B T Z V U W F hp hX hc E M₀ he Y hh C Ht O L1 hC Θ Uv i0 Gn ξ Ξ hTol hPz (fun j h _ => hK.viewQ j h) (hmK.trans hi.le) hi0 (fun j h _=> hK.vac j h) hGz hYt
      obtain ⟨p,h⟩:= vigilant P₀ A X B T V U W E M₀ he Y C Ht O L1 hC Θ Uv i0 Gn ξ Ξ v q 0 hAim sym hf Off.basic hv hx hU
      have heq:p i=pV:=by
           have hL:= hU.journey.furnished (0:Cover) (p i) q i hmK hi.le _ (show (being P₀ A X B T V U W E M₀ he Y C Ht O L1 hC Θ Uv i0 Gn ξ Ξ) i 0 (p i) q (Off.carrier Aim (Zs) (fun _=>0) i 0 v) from ⟨hi.le,h.priced i hmK hi.le _⟩)
           rw [← Off.point] at hW; exact Canvas.consensus Θ _ _ hL _ hW -- rw point?
      have hP:=Voyage.march_T P₀ A X B T Z V U W F hp hX E M₀ he Y hh C Ht O L1 hC Θ Uv i0 Gn ξ Ξ (fun _=>0) p v q (i:=i+1) hi hK.viewQ h Off.basic hTol hPz (fun i h hv=> hGz i h hv.le) hK.vac (m:=i) (Nat.le_succ _) hmK -- i implicit reorder
      rw [heq] at hP; exact ⟨p,h,heq,mul_le_mul_of_nonneg_left (hP.trans (mul_le_mul_of_nonneg_right hg (Real.exp_nonneg _))) (zero_le_one.trans (stem_h ..))⟩
