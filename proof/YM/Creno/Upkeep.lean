variable (b:ℕ→ Cover)(q0:ℕ)(L:List Axis)(f:Side)
-- `size local.Jx` via actual lattice
lemma comparable (L:List Axis)(x:Cover) : separation (wrap f (sawC b L q0+x)) (wrap f x)= separation (wrap f (b q0)) 0:=by
     rw [map_add, ← map_add (wrap f)] -- undo.Place.simp
     have hz(L:List Axis) : separation (wrap f (sawC b L q0)) 0= separation (wrap f (b q0)) 0:=by
         induction L with
         | nil=>rfl
         | cons a L ih=>
              unfold sawC; simp only [Function.comp_apply]; rw [← wrap_signed]; conv_lhs=> rhs; rw [← show (Signed.mirror a).act (0:Site f)=0 from Signed.act_zero ..]
              rw [separation_signed]; exact ih -- lemma name
     rw [map_add]; exact (show separation _ (wrap f x) = separation (wrap f (sawC b L q0)) 0 from (by simpa using Lattice.separation_translate (wrap f (sawC b L q0)) (0:Site f) (wrap f x))).trans (hz _)
