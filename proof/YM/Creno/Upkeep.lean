lemma vital (u v:I) (he:u≠v) (hq:ℓ ≤j): ratioTo (ladder P₀ A) j ℓ * ((Pt ℓ).B*((Pt ℓ).B)) ≤ separation (wrap (A.ring (B.n k) j) (pits P₀ A ℓ χb j u)) (wrap (A.ring (B.n k) j) (pits P₀ A ℓ χb j v)):=by
      have ht(x:I)(j:ℕ): pits P₀ A ℓ χb j x=lineC (ladder P₀ A) (fun _=>0) ℓ (χb x) j:=rfl; have hq':= ample P₀ A B (k:=k) hq (χb u) (χb v); have hx := hY u v he
      rw [ht,ht] at hx ⊢; have hZ(k:I): lineC (ladder P₀ A) (fun _=>0) ℓ (χb k) ℓ=χb k:=by unfold lineC; rw[centreN]; simp
      rw[hZ,hZ] at hx; exact (Nat.mul_le_mul_left _ hx).trans_eq hq'.symm
