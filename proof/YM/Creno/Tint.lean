lemma rents (l:List J₀) : (l.map (onto P₀ A B U0 Ψ w0)).prod= (((l.map w0).prod:ℝ):ℂ) • (((U0.twins l).map Ψ).prod):=by
      induction l with
      | nil=>simp[Bloc.twins]
      | cons j l ih=> simp only[List.map_cons, Bloc.twins,List.flatMap_cons,List.map_append,List.prod_cons,List.prod_append] at ih ⊢; rw[ih,Complex.ofReal_mul,mul_smul, onto,Algebra.smul_mul_assoc,mul_smul_comm]
lemma bill (τ:Iq→ℝ)(x:List J₀)(h:x.Nodup)(hW:∀ j:J₀,((U0.arm j).map τ).prod=w0 j): (x.map w0).prod= (∏ i∈U0.plant x.toFinset,τ i):=by
      induction x with
      | nil=>simp [Bloc.plant]
      | cons j l ih=>
        rw [List.nodup_cons] at h
        have ht: Disjoint ((U0.arm j).toFinset) (U0.plant l.toFinset):= disjoint_left.mpr fun i hv ht=>h.1 (List.mem_toFinset.mp (((U0.complete i j|>.1 (List.mem_toFinset.mp hv))) ▸ ((U0.belongs i l.toFinset).mp ht)))
        have hf (x:List Iq)(hx:x.Nodup): (x.map τ).prod=∏ i∈x.toFinset,τ i:=by
             induction x with|nil=>simp| cons i l ih=> simp only[List.map_cons,List.prod_cons,List.toFinset_cons,Finset.prod_insert (fun hz=> (List.nodup_cons.mp hx).1 (List.mem_toFinset.mp hz)),ih (List.nodup_cons.mp hx).2]
        simp only [List.map_cons,List.prod_cons,List.toFinset_cons,ih h.2, show ∀ s:Finset J₀,U0.plant (insert j s)=(U0.arm j).toFinset ∪ U0.plant s from (by intros; simp [Bloc.plant]),Finset.prod_union ht,← hf _ (U0.scoop _),hW]
lemma pearl (m:ℕ)(s':Fin m→J₀)(hs:Injective s')(hW:∀ j:J₀, ((U0.arm j).map (fun i=>ρ i*β i)).prod=w0 j): Farm.scarf U0 ρ (cN i) (Talent.scale β ((Gf Ψ) i)) m s'= (Gf (onto P₀ A B U0 Ψ w0)) i m s':=by
     let l:=List.ofFn s'; let u:= U0.twins l; have hL:l.Nodup:= List.nodup_ofFn_ofInjective hs; let θ: Fin u.length→ Iq:= u.get
     have hv :U0.plant (MassiveQCD.Sample.Quills.crest s')= u.toFinset :=by rw [show u.toFinset=U0.plant l.toFinset from U0.stowed l]; congr 1; ext; simp [MassiveQCD.Sample.Quills.crest,l]
     have he : soloK P₀ A B (onto P₀ A B U0 Ψ w0) m s'= ( ((l.map w0).prod:ℝ):ℂ) • soloK P₀ A B Ψ u.length θ:=by unfold soloK; rw [show (List.ofFn fun i=> Ψ (θ i))=u.map Ψ from ?_, show (List.ofFn fun i=> onto P₀ A B U0 Ψ w0 (s' i))= l.map (onto P₀ A B U0 Ψ w0) from (by unfold l; rw [List.map_ofFn]; rfl)]; exact rents ..; change List.ofFn (Ψ ∘ θ)=_; rw[← List.map_ofFn]; exact congr_arg (List.map Ψ) (List.ofFn_get _)
     unfold Farm.scarf Talent.scale; change Gain.uvBirth ρ (U0.plant (MassiveQCD.Sample.Quills.crest s')) • (Talent.realize β θ • pathK P₀ A B V U W M₀ Ψ i u.length θ)= _; rw [hv]; unfold pathK; rw [he,mul_smul_comm,map_smul]
     suffices h:Gain.uvBirth ρ u.toFinset * Talent.realize β θ=( ((l.map w0).prod:ℝ):ℂ) by
          rw [smul_smul,h]; symm; suffices h : ∀ (c f:Side)(h:c=f)(Y:Insertion c 6)(s:ℂ), transit h (⇑(s • Y))=s • transit h (⇑Y) by exact h _ _ _ _ _
          intro c f h; subst f; intro _ _; rfl
     let g(p:Iq):=ρ p*β p; have hz:(l.map w0).prod=∏ i∈u.toFinset,g i:=by rw[show u.toFinset=U0.plant l.toFinset from U0.stowed l]; exact bill U0 w0 g l hL hW -- sig
     unfold Gain.uvBirth Talent.realize; rw [hz]; push_cast; -- tweak.S.
     have hh: Finset.univ.image θ=u.toFinset:=by ext; simp [θ,List.mem_iff_get]
     rw[← hh]; simp_rw [g,Complex.ofReal_mul]; rw[prod_mul_distrib]; congr 1; rw [Finset.prod_image (List.nodup_iff_injective_get.mp (U0.tightened l hL)).injOn]
