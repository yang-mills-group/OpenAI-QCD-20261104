lemma growsΩ (D:ℕ)(j:ℕ): maturity P₀ A hXW j D ≤ j+2*D*(highR (A.spacing j) (clockQ P₀ A x j))^2:=by
    let U(i:ℕ):= (radiusB (A.scale x i))^2; have hu:(highR (A.spacing j) (clockQ P₀ A x j))^2=U j:=by unfold highR U; rw [show betaF su _ _= Track.scale A x j from augmented ..]
    have h(i:ℕ):(U (j+i)) ≤U j*2^i∧ 3^i ≤ stampR P₀ A j (j+i):=by
         induction i with
         |zero=> constructor; · simp
                 simp [stampR] -- Prop pos defeq
         | succ i ih=>
           have hh:j ≤ j+i:=(by omega); rw [←add_assoc, pow_succ,pow_succ, stamp_t P₀ A hh]; constructor; · exact ((Counter.evolves P₀ A hXW (j+i)).1).trans ((mul_le_mul_of_nonneg_left ih.1 (Nat.zero_le _)).trans_eq (by ring))
           exact Nat.mul_le_mul ih.2 ((A.flight (j+i)).coarse)
    let L:= D*U j; let w:=2*L; have hv:= h w; rw [hu]; have hQ (i:ℕ): i* (2^2)^i ≤ (3^2)^i:=by
         induction i with
         | zero=>simp
         | succ i ih=>
            rcases i with _|i; · norm_num
            rw [pow_succ (_^2) (i+1),pow_succ (_^2) (i+1)]; calc
              _ ≤ (i+1)*(2^2)^(i+1)*8:=by nlinarith only [Nat.zero_le i, Nat.zero_le ((2^2:ℕ)^(i+1)),Nat.zero_le (i*((2^2:ℕ)^(i+1)))]
              _ ≤ (3^2)^(i+1)*8:=Nat.mul_le_mul_right _ ih
              _ ≤ _ :=Nat.mul_le_mul_left _ (by norm_num)
    rw [mul_assoc]; refine Nat.find_min' (Counter.rises _ _ hXW _ _) ⟨by omega,?_⟩; change D*U (j+w) ≤ _; exact (mul_le_mul_of_nonneg_left hv.1 (Nat.zero_le _)).trans (((le_of_eq (show D*(U j*2^w)=L*(2^2)^L from (by unfold w; rw[pow_mul,← mul_assoc]))).trans ((hQ _).trans_eq (by rw [←pow_mul]))).trans hv.2)
