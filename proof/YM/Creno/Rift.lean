-- cross cost startup Fi at all. simple Fires via bound by 3* old hT & b-array.a
lemma contrast (hB:Fires (Bo (i+1)) mN) : Fires (wrap (A.ring (B.n k) (i+1)) ∘ azures xT b (i+1)) (mN*3):=by
      let p:=Ao (i+1); let q:= Bo (i+1); intro u
      let f(j:Fin 3)(x:Iz) := if j=1 then q x else p x; let v(j:Fin 3):= Finset.univ.filter (fun i:Iz=> f j i=u); let U(j:Fin 3):Finset Iu:= v j ×ˢ {j}; let X:= Ui (i+1)
      have he(x:Iu): X x=f x.2 x.1:=by change wrap _ (ite _ _ _)=_; unfold f; split <;> simp_all [p,q,X,azures]
      apply le_trans (Finset.card_le_card (show Finset.univ.filter (fun i=> X i=u) ⊆ Finset.univ.biUnion U from ?_)); swap
      · intro x hx; have h:= (mem_filter.mp hx).2; refine mem_biUnion.mpr ⟨x.2,mem_univ _,mem_product.mpr ⟨mem_filter.mpr ⟨mem_univ _,?_⟩,mem_singleton_self _⟩⟩; exact (he x).symm.trans h
      have h(j:Fin 3):(U j).card ≤ mN:=by
            unfold U; rw [card_product,card_singleton,mul_one]; unfold v f; by_cases he:j=1; · simp_rw[if_pos he]; exact hB _
            simp_rw [if_neg he]
            exact hg _
      exact (card_biUnion_le ..).trans ((sum_le_sum (fun i _=>h i)).trans_eq (by simp [Nat.mul_comm]))
omit hg
