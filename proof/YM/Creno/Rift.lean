include hK hA
lemma spacious (t v:Iu)(ht:t.1≠v.1): (δk) ≤ separation ((Ui (i+1)) t) ((Ui (i+1)) v):=by
       let F(x:Iz):= (Ao (i+1)) x; let G(u:Iu):= (Ui (i+1)) u; have hf(u:Iu): separation (F u.1) (G u)≤ν:=by
            unfold F G; simp_rw [Function.comp_apply]; unfold azures; split; · exact hK _
            rw [separation_self]; omega
       have hx:= hA t.1 v.1 ht; change (δk) ≤ separation (G t) (G v); have hz:= separation_triangle (F t.1) (G t) (F v.1); have hh:= separation_triangle (G t) (G v) (F v.1); have hv := hf v; rw [separation_comm] at hv; change (δk) +2*ν ≤ separation (F t.1) (F v.1) at hx; have hu:= hf t; omega
include hG
lemma appears (s:Finset Iu)(hS:s∈Su): Spaced (Ui (i+1)) s (Pt (i+1)).B:=by
       rintro ⟨u,a⟩ hu ⟨v,j⟩ hv h; by_cases ht:u=v; swap; · exact spacious P₀ A B xT b ν hK hA _ _ ht -- signature
       subst v; have he(hF:(u,2)∈s):False:=by apply h; have he1:a=2:=hS u hF _ hu rfl; have he2:j=2:=hS u hF _ hv rfl; rw[he1,he2]
       fin_cases a <;> fin_cases j
           <;> first| exact (h rfl).elim| exact (he hu).elim| exact (he hv).elim|exact hG u| rw [separation_comm]; exact hG u -- defin ite. not reduce if using Classical.prop ...
omit hG
lemma b_sparse (htL:1 ≤ (Pt (i+1)).B)(hp':1≤ mN): Fires (Bo (i+1)) mN:=by
       apply fires_of_inj _ _ _ hp'; intro u v h; by_contra hg
       have hS: (δk) ≤ separation ((Bo (i+1)) u) ((Bo (i+1)) v):= spacious P₀ A B xT b ν hK hA (u,1) (v,1) hg; rw [h,separation_self] at hS; exact not_le_of_gt (Nat.mul_pos htL htL) hS
-- all ornaments accrue Geometry. 
include hX hF hhA hG hm hi hhB
lemma arbor (hv:1 ≤ (Pt (i+1)).B)(hQ:1 ≤ Mi (i+1))(hp':∀ j,i+1 ≤ j → j ≤ n → Mi (i+1)*3 ≤ Fd j): Croft P₀ A B (azures xT b) Fd (freeQ Iz) (i+1) n (Pt:=Pt) (k:=k):=by
       apply takes P₀ A B hX hF _ _ (i+1) Fd ?_ (contrast P₀ A B xT b (Mi (i+1)) (hhA.lights (i+1) hm hi.le) (b_sparse P₀ A B xT b (Mi (i+1)) ν hK hA hv hQ)) hp' (appears P₀ A B xT b ν hK hG hA)
       intro x; obtain ⟨u,a⟩:= x; by_cases he:a=1; · convert hhB u using 1; ext1; simp [azures,he] -- unfold azures not δ notation
       intro j h hv'; unfold azures; simp only [he,↓reduceIte]; exact hhA.borders u j (hm.trans h) hv'
