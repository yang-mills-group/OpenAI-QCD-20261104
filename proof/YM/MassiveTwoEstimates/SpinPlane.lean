import YM.Massive.Target.Covers
import Mathlib.Analysis.SpecialFunctions.Trigonometric.Deriv

/-! A half rotation generated by the target's actual skew matrix is the
product of the two coordinate reflections. -/
set_option autoImplicit false
noncomputable section
namespace YM.MassiveTwoEstimates.SpinPlane
open NormedSpace Matrix
open scoped Matrix.Norms.Frobenius Topology

private def planePart (a b : Axis) : M4 := single a a 1 + single b b 1

private lemma products (a b : Axis) (h : a ≠ b) :
    (Ortho.plane a b).val * (Ortho.plane a b).val = -planePart a b ∧
    (Ortho.plane a b).val * planePart a b = (Ortho.plane a b).val := by
  unfold Ortho.plane planePart
  simp only [sub_mul,mul_sub,mul_add,Matrix.single_mul_single_of_ne _ _ _ _ h,
    Matrix.single_mul_single_of_ne _ _ _ _ h.symm,Matrix.single_mul_single_same,one_mul]
  constructor <;> abel

private def turn (a b : Axis) (t : ℝ) : M4 :=
  1 + Real.sin t • (Ortho.plane a b).val + (Real.cos t - 1) • planePart a b

private lemma derivTurn (a b : Axis) (h : a ≠ b) (t : ℝ) :
    HasDerivAt (turn a b) ((Ortho.plane a b).val * turn a b t) t := by
  obtain ⟨sq,part⟩ := products a b h
  have ht := ((Real.hasDerivAt_sin t).smul_const (Ortho.plane a b).val).const_add (1:M4)
  have hd := ht.add (((Real.hasDerivAt_cos t).sub_const 1).smul_const (planePart a b))
  apply hd.congr_deriv
  rw [turn,mul_add,mul_add,Matrix.mul_smul,Matrix.mul_smul,sq,part,mul_one]
  module

theorem expPlane (a b : Axis) (h : a ≠ b) (t : ℝ) :
    (Ortho.oneParameter (Ortho.plane a b) t).val = turn a b t := by
  let J := (Ortho.plane a b).val
  let V (s : ℝ) := exp (s • (-J)) * turn a b s
  have deriv (s : ℝ) : HasDerivAt V 0 s := by
    apply ((hasDerivAt_exp_smul_const (-J) s).mul (derivTurn a b h s)).congr_deriv
    change exp (s • -J) * -J * turn a b s + exp (s • -J) * (J * turn a b s) = 0
    simp only [mul_neg,neg_mul,Matrix.mul_assoc,neg_add_cancel]
  have c := is_const_of_deriv_eq_zero (fun s => (deriv s).differentiableAt) (fun s => (deriv s).deriv) t 0
  have inv : exp (t • J) * exp (t • (-J)) = 1 := by
    haveI : NormedAlgebra ℚ M4 := .restrictScalars ℚ ℝ _
    rw [smul_neg]
    calc _ = exp ((t • J) + -(t • J)) :=
           (exp_add_of_commute (Commute.refl (t • J)).neg_right).symm
         _ = 1 := by rw [add_neg_cancel,exp_zero]
  have v0 : V 0=1 := by simp [V,turn]
  rw [v0] at c
  change exp (t • J) = turn a b t
  calc
    _ = exp (t • J) * V t := by rw [c,mul_one]
    _ = _ := by change _ * (_ * _) = _; rw [←Matrix.mul_assoc,inv,one_mul]

theorem half (a b : Axis) (h : a ≠ b) :
    Ortho.oneParameter (Ortho.plane a b) Real.pi = Signed.reflect a * Signed.reflect b := by
  apply Subtype.ext
  rw [expPlane a b h]
  ext i j
  have coord := congrArg (fun v : E4 => v i)
    (Ortho.move_mul (Signed.reflect a) (Signed.reflect b) (basis j))
  change M4.move ((Signed.reflect a * Signed.reflect b):Ortho).val (basis j) i = _ at coord
  rw [M4.move_basis,Signed.mirrored,Signed.mirrored] at coord
  refine Eq.trans ?_ coord.symm
  clear coord
  simp only [turn,Real.sin_pi,Real.cos_pi,zero_smul,add_zero,planePart,Matrix.add_apply,
    Matrix.smul_apply,smul_eq_mul,Matrix.single,Matrix.of_apply,Matrix.one_apply,basis_eq]
  by_cases hij : i=j
  · subst j
    by_cases ha : i=a
    · subst a; norm_num [h,Ne.symm h]
    by_cases hb : i=b
    · subst b; norm_num [ha,Ne.symm ha]
    norm_num [ha,hb,Ne.symm ha,Ne.symm hb]
  · have ea : ¬(a=i ∧ a=j) := fun z => hij (z.1.symm.trans z.2)
    have eb : ¬(b=i ∧ b=j) := fun z => hij (z.1.symm.trans z.2)
    simp [hij,ea,eb]

theorem full (a b : Axis) (h : a ≠ b) :
    Ortho.oneParameter (Ortho.plane a b) (2*Real.pi) = 1 := by
  apply Subtype.ext
  rw [expPlane a b h]
  simp [turn,Real.sin_two_pi,Real.cos_two_pi]

theorem addParameter (w : Ortho.Skew) (s t : ℝ) :
    Ortho.oneParameter w (s+t) = Ortho.oneParameter w s * Ortho.oneParameter w t := by
  apply Subtype.ext
  haveI : NormedAlgebra ℚ M4 := .restrictScalars ℚ ℝ _
  change exp ((s+t) • w.val) = exp (s • w.val) * exp (t • w.val)
  rw [add_smul]
  exact exp_add_of_commute (((Commute.refl _).smul_left s).smul_right t)

end YM.MassiveTwoEstimates.SpinPlane
#print axioms YM.MassiveTwoEstimates.SpinPlane.half
#print axioms YM.MassiveTwoEstimates.SpinPlane.full
