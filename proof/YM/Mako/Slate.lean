import YM.Mako.Puma
import YM.Mako.Dutch
set_option maxHeartbeats 640000
set_option autoImplicit false
noncomputable section
namespace YM.Mako
open Function Filter Set
open Vern Module
open Ortho (plane Skew)
open Org
open scoped Topology BigOperators Classical Matrix Matrix.Norms.Frobenius
-- ℝ chiral sectors; real. F generated by Qs
abbrev Pinx:=Fin 3
noncomputable def retta : Pinx→ Skew:= (![plane 0 1,plane 0 2,plane 0 3])
noncomputable def groth : Pinx→ Skew:= (![-plane 2 3,-plane 3 1,-plane 1 2])
noncomputable def evoke (b:Bool)(i:Pinx): Skew:= (1/2:ℝ) • (groth i + if b then retta i else -retta i)
lemma coal(i:Pinx): bracket (retta i) (groth i)=0:=by fin_cases i<;> apply Subtype.ext<;> simp [bracket,retta,groth,plane,Matrix.star_eq_conjTranspose,mul_sub,sub_mul, Matrix.single_mul_single_of_ne]
lemma retta_retta(i:Pinx): bracket (retta i) (retta (i+1))= groth (i+2):=by
    fin_cases i
    · change bracket (plane 0 1) (plane 0 2)= -plane 1 2; apply Subtype.ext; simp [plane,bracket,mul_sub,sub_mul] <;> abel
    · change bracket (plane 0 2) (plane 0 3)= -plane 2 3; apply Subtype.ext; simp [plane,bracket,mul_sub,sub_mul] <;> abel
    · change bracket (plane 0 3) (plane 0 1)= -plane 3 1; apply Subtype.ext; simp [plane,bracket,mul_sub,sub_mul] <;> abel
lemma retta_groth(i:Pinx): bracket (retta i) (groth (i+1))= retta (i+2):=by
    fin_cases i
    · change bracket (plane 0 1) (-plane 3 1)= plane 0 3; apply Subtype.ext; simp [plane,bracket,mul_sub,sub_mul] <;> abel
    · change bracket (plane 0 2) (-plane 1 2)= plane 0 1; apply Subtype.ext; simp [plane,bracket,mul_sub,sub_mul] <;> abel
    · change bracket (plane 0 3) (-plane 2 3)= plane 0 2; apply Subtype.ext; simp [plane,bracket,mul_sub,sub_mul] <;> abel
lemma groth_retta(i:Pinx): bracket (groth i) (retta (i+1))= retta (i+2):=by
    fin_cases i
    · change bracket (-plane 2 3) (plane 0 2)= plane 0 3; apply Subtype.ext; simp [plane,bracket,mul_sub,sub_mul] <;> abel
    · change bracket (-plane 3 1) (plane 0 3)= plane 0 1; apply Subtype.ext; simp [plane,bracket,mul_sub,sub_mul] <;> abel
    · change bracket (-plane 1 2) (plane 0 1)= plane 0 2; apply Subtype.ext; simp [plane,bracket,mul_sub,sub_mul] <;> abel
lemma groth_groth(i:Pinx): bracket (groth i) (groth (i+1))= groth (i+2):=by
    fin_cases i
    · change bracket (-plane 2 3) (-plane 3 1)= -plane 1 2; apply Subtype.ext; simp [plane,bracket,mul_sub,sub_mul] <;> abel
    · change bracket (-plane 3 1) (-plane 1 2)= -plane 2 3; apply Subtype.ext; simp [plane,bracket,mul_sub,sub_mul] <;> abel
    · change bracket (-plane 1 2) (-plane 2 3)= -plane 3 1; apply Subtype.ext; simp [plane,bracket,mul_sub,sub_mul] <;> abel
lemma u_sR(x y:Skew)(r:ℝ): bracket x (r • y)= r • bracket x y:=by rw [revΛ,u_sΛ,revΛ y,smul_neg,neg_neg] -- fix
lemma u_nL(x y:Skew): bracket (-x) y= -bracket x y:=by rw [←neg_one_smul ℝ x,u_sΛ]; exact neg_one_smul ℝ (bracket x y)
lemma u_nR(x y:Skew):bracket x (-y)= -bracket x y:=by rw[← neg_one_smul ℝ y,u_sR]; exact neg_one_smul ℝ (bracket x y)
lemma u_addR(x y z:Skew):bracket x (y+z)=bracket x y+bracket x z:=Subtype.ext (by simp [bracket,mul_add, add_mul]; abel)
lemma u_zero(x:Skew): bracket x x=0:=Subtype.ext (sub_self _)
lemma pool(b:Bool)(i:Pinx): bracket (evoke b i) (evoke b (i+1))= evoke b (i+2):=by
     cases b <;> simp only [evoke,↓reduceIte,Bool.false_eq_true,u_sΛ,u_sR,u_addR,u_addΛ,u_nR,u_nL,groth_retta,groth_groth,retta_retta,retta_groth] <;> module
lemma c_plur(i:Pinx)(b:Bool): bracket (evoke b i) (evoke (!b) (i+1))=0:=by
     cases b <;> simp only[evoke,Bool.not_false,Bool.not_true,Bool.false_eq_true,↓reduceIte,u_sΛ,u_sR,u_addΛ,u_addR,u_nR,u_nL,retta_retta,retta_groth,groth_retta,groth_groth] <;> abel_nf <;> simp <;> abel
lemma stripe(i j:Pinx): bracket (evoke false i) (evoke true j)=0:=by
     rcases ((show ∀ i j:Pinx,i=j∨j=i+1∨i=j+1 by decide) i j) with rfl|rfl|rfl
     · have hp:= (revΛ (groth i) (retta i)); rw [coal,neg_zero] at hp; simp only[evoke,Bool.false_eq_true,↓reduceIte,u_sR,u_sΛ,u_addR,u_addΛ,u_nR,u_nL,coal,hp,u_zero,neg_zero,add_zero,smul_zero]
     · exact c_plur i false
     rw[revΛ,show bracket (evoke true j) (evoke false (j+1))=0 from c_plur j true,neg_zero]
variable {W:Type*}[AddCommGroup W][Module ℂ W][FiniteDimensional ℂ W]
local notation "M"=> Module.End ℂ W
variable (F:Skew →+ Module.End ℂ W) (hf:∀ x y,clip (F x) (F y)= F (bracket x y))
variable (ht: ∀ (r:ℝ)(p:Skew),F (r • p)=(r:ℂ) • (F p))(hS:∀ i j:Axis,(F (plane i j)).IsSemisimple)
noncomputable abbrev hCart(X:M):= (2*Complex.I:ℂ) • X
noncomputable abbrev themeH (g:Pinx→M):= hCart (g 0)
noncomputable abbrev themeE(g:Pinx→M):= g 1+Complex.I • g 2
noncomputable abbrev themeF(g:Pinx→M):= -(g 1-Complex.I • g 2)
lemma cl_plusL(u v w:M):clip (u+v) w=clip u w+clip v w:=by unfold clip; rw [mul_add,add_mul]; abel
lemma cl_plusR(u v w:M):clip u (v+w)=clip u v + clip u w:=by unfold clip; rw [mul_add,add_mul]; abel
lemma cl_negL(u v:M):clip (-u) v= -clip u v:=by unfold clip; rw [neg_mul,mul_neg]; abel
lemma cl_negR(u v:M):clip u (-v)= -clip u v:=by unfold clip; rw[mul_neg,neg_mul]; abel
lemma cl_sL (a:ℂ)(u v:M): clip (a • u) v=a • clip u v:=by simp [clip,smul_sub]
lemma cl_sR (a:ℂ)(u v:M): clip u (a • v)=a • clip u v:=by simp [clip,smul_sub]
lemma cl_self(x:M):clip x x=0:=sub_self _
lemma orate (g:Pinx→M) (h:∀ i:Pinx,clip (g i) (g (i+1))=g (i+2)): Links (themeH g) (themeE g) (themeF g):=by
     have h0:clip (g 0) (g 1)=g 2:= h 0
     have h1:clip (g 1) (g 2)=g 0:= h 1
     have h2:clip (g 2) (g 0)=g 1:= h 2
     constructor
     · change clip _ _= _; unfold themeH hCart themeE; rw [cl_sL,cl_plusR,h0,cl_sR,clipneg (g 0),h2]; -- module i2
       simp only [smul_add,smul_neg,smul_smul,mul_assoc,Complex.I_mul_I]; module
     · suffices he: clip (hCart (g 0)) (-(g 1+ -(Complex.I • g 2))) = (-2:ℂ) • themeF g by simpa only[sub_eq_add_neg,themeH,themeF,clip] using he
       unfold themeF hCart; rw[cl_sL,cl_negR,cl_plusR,h0,cl_negR,cl_sR, clipneg (g 0),h2]
       simp only[smul_neg,smul_add,smul_smul,mul_assoc,Complex.I_mul_I]; module
     suffices he: clip (themeE g) (-(g 1+ -(Complex.I • g 2)))=themeH g by simpa only [sub_eq_add_neg,themeE,themeF,clip] using he
     unfold themeE themeH hCart
     rw [cl_negR,cl_plusR,cl_plusL,cl_self,cl_sL,clipneg (g 2),h1,cl_negR,cl_plusL,cl_self,cl_sR,h1]; module
include hf ht hS
lemma co_semisi (b:Bool): (themeH (F ∘ evoke b)).IsSemisimple:=by
     apply End.IsSemisimple_smul; let A:= F (groth 0); let B:= F (retta 0); have hA:A.IsSemisimple:= by unfold A; change (F (-plane 2 3)).IsSemisimple; rw[map_neg]; exact End.isSemisimple_neg.mpr (hS 2 3) -- use map_neg
     have hB:B.IsSemisimple:= hS 0 1; have hg:Commute B A:= sub_eq_zero.mp (Eq.trans (hf _ _) (by rw [coal,map_zero])); unfold evoke; simp only [Function.comp_apply,ht]; apply End.IsSemisimple_smul; cases b
     · change (F (groth 0 + -retta 0)).IsSemisimple; rw [map_add,map_neg,←sub_eq_add_neg]; exact hA.sub_of_commute hg.symm hB
     change (F (groth 0+ retta 0)).IsSemisimple; rw[map_add]; exact hA.add_of_commute hg.symm hB
end YM.Mako
