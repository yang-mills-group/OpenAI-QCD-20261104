lemma shore (ht:(covering (n:=n) (k:=k) P₀ A B V U W M₀.tip s w).Actual)(hi:i≤n):∃ z:ℂ,z≠0 ∧ ∀ i':Grid ((ladder P₀ A).side (B.n k) i),Massive.PCAC.actor YY i i'=z • (BS i hi).density i':=by
    obtain ⟨z,hz,ht',h,hZ⟩:= senior P₀ A X B T V U W E M₀ he Y C Ht O L1 hC hi
    refine ⟨z,hz,?_⟩; have he': ⇑(Massive.PCAC.actor YY i)=_:= (Massive.PCAC.act YY ht hi).trans (exact_cov P₀ A X B T Z V U W F hp hX hc Y hh i M₀.tip s w hi) -- syntax
    intro U; rw [he']
    suffices H:∀ c':Side,∀ (d:(A.ring (B.n k) i)=c'),∀ U:Grid c', transit d (Cove.light _ ∘ family P₀ A B Y M₀.tip s i (w:ℂ)) U=z • (voyageD d (Bz i hi)).density U by exact H _ _ U
    intro c d; subst c; intro R; rw [h]; change Cove.light _ (z • Maternal (DL hi) (Pt i) (Bn i) (Sn i) Tt R)= _; rw [map_smul]; rfl
