lemma coastline (hi:i<n)(hs: SpanC (Bz i hi.le) (Bz (i+1) hi) Dⁱ (A.next (B.n k) i) K (W i) (V (i+1)) Z₁ (v! i) (v! (i+1)) Lx a b p d t): SpanC (D₀ i) (D₀ (i+1)) (A.flight i) ((ladder P₀ A).sides_next (B.n k) i) K (W i) (V (i+1)) Z₁ (v! i) (v! (i+1)) Lx a b p d t:=by
     unfold coast; rw [dif_pos hi.le,dif_pos (show i+1≤n from hi)]; suffices h:∀ c f: Side,∀ (h:f.val=c.val*(A.flight i).L.val)(h1: A.ring (B.n k) i=c)(h2:A.ring (B.n k) (i+1)=f), SpanC (voyageD h1 (Bz i hi.le)) (voyageD h2 (Bz (i+1) hi)) (A.flight i) h K (W i) (V (i+1)) Z₁ (v! i) (v! (i+1)) Lx a b p d t by exact h _ _ _ _ _
     intro c f d h h'; subst c f
     refine ⟨fun x y p hp=> ?_,hs.shapes,hs.pole,hs.shift_p,hs.readsU,hs.budget,hs.funded,hs.back,hs.power,hs.front,hs.warp,hs.height,hs.cover,hs.levy,hs.typeH,hs.score⟩
     obtain ⟨hx⟩:= hs.drive x y p hp
     constructor; intro I I' _ _ F hv he r hr; obtain ⟨I,E,hI,hE,Z,hS,h₁,h₂⟩:= hx I I' F hv he r hr
     exact ⟨I,E,hI,hE,Z,hS,h₁,⟨h₂.roll⟩⟩
end
structure Ship (x:ℝ)(p α y:ℝ)(i:ℕ):Prop where
    -- Financed per tag before-L.
    berth :2*arctic (A.spacing i) (rank (A.level (i+1))) + berthD (rank (A.level (i+1)))≤ highR (A.spacing i) (run (A.spacing i) (clockQ P₀ A x i))
    ticket : MarketCredit (P₀ (A.node i)) (X i) (clockQ P₀ A x i)
    sky: Wit (P₀ (A.node i)).guide (X i).o (A.spacing i) (rank (A.level (i+1))) θ (run (A.spacing i) (clockQ P₀ A x i))
    word : α ≤ Fleet.Glow.bTop (A.spacing i) (run (A.spacing i) (clockQ P₀ A x i))
    gains: 0 ≤ Comet.wishGain (run (A.spacing i) (clockQ P₀ A x i)) (A.spacing i)
    earns : ∀ w:ℝ, 1/2≤ w → TollG (escrow P₀ A X x α (i+1)) (A.spacing i) (rank (A.level (i+1))) w (Comet.wishGain (run (A.spacing i) (clockQ P₀ A x i)) (A.spacing i)) (Fleet.Glow.payFee (P₀ (A.node i)).guide (A.spacing i) θ (run (A.spacing i) (clockQ P₀ A x i))) (spareCut 1) (8*p) y p

include hc he hC hp hX hh
variable (u₀ y:ℝ)
local notation "xℓ"=>Ship P₀ A X
lemma shipping (ht:(covering (n:=n) (k:=k) P₀ A B V U W M₀.tip s w).Actual)(hS:∀ i<l,2*(A.flight i).patch.radius< (A.ring (B.n k) (i+1)).val)(hi:l≤n)(h:1≤ αH)(hy:∀ i<l,Ship P₀ A X x u₀ αH y i)(hTol: 2*tol+tol^2≤1/2)(hj:∀ i<l,rank (A.level (i+1))=j): Sworn YY l v! D₀ j (8*u₀) y u₀:=by
     refine ⟨hj,?_,fun i hz=>?_⟩
     · dsimp only [coast]; rw [dif_pos hi]; exact shore P₀ A X B T Z V U W F hp hX hc E M₀ he Y hh C Ht O L1 hC ht hi
     have hq:=hy i hz; obtain ⟨C',hC',hQ⟩:= estate P₀ A X B T Z V U W F hp E M₀ he Y C Ht O L1 hC hq.ticket αH hq.sky (hz.trans_le hi) h hq.word (hS i hz) hq.berth hTol hq.gains
     have hv:1/2≤ W i:=by have he':=(abs_le.mp (hp.relay i (hz.trans_le hi)).band).1; linarith only [he',hTol]
     exact ⟨C',hC',_,_,_,_,_,_, coastline P₀ A X B T V U W E M₀ Y C αH _ _ _ _ _ _ _ (hz.trans_le hi) hQ,hq.earns (W i) hv⟩
