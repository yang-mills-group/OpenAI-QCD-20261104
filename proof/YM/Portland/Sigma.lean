lemma tempoP : ((Aq).flight 0).patch= LX:=by
    let U:= (Aq).flight 0; let V:=(Q.fixed 0).flight; have h := MintV.dayLead P₀ Q eD PxPad 0 (spiceH P₀ Q eD PxPad); have hv(b b':ChangeQ)(C:Flight b.old b.new)(T:Flight b'.old b'.new)(hf:b=b')(h:HEq C T): C.patch=T.patch:=by subst b'; cases h; rfl
