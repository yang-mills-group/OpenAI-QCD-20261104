lemma dripK (r:ℝ)(hv:0<r)(σ:ℝ)(h:KeyL ((Q.fixed 0).flight.patch) (E.eps (Q.fixed 0).node) (E.D (Q.fixed 0).node) (P₀ (Q.fixed 0).node).κ σ):∀ᶠ x:ℝ in atTop,∀ p':ℕ→ℕ→ℕ, let A:=Q.track eD p'; let w:=A.node 0; let J:=(A.flight 0).patch; cupsB U' p (P₀ w).κ σ θ (dab P₀ A E 0) (fees P₀ A E 0) J (berthD ((Q.fixed 0).node.old)) x (clockQ P₀ A x 0)≤ r * Glint.Value (SeasonR P₀ A E σ x):=by
     let b:=(Q.fixed 0).node; let L:= L0; let J:=(Q.fixed 0).flight.patch; let g x:= fallback L x; have hF:Tendsto g atTop atTop:= tendsto_atTop_add_const_right _ (-(_ * _:ℝ)) tendsto_id
     filter_upwards [hF.eventually (mug U' p (P₀ b).κ (E.eps b) θ σ (E.D b) J (berthD b.old) (E.eps_pos _) h.room (P₀ b).lead r hv)] with x hx p' A' Jp Spd;
     unfold SeasonR endQ clockQ fees dab; unfold Spd Jp A'; rw [tempoP P₀ Q,tempoX P₀ Q,tempoL P₀ Q,Track.atBirth]; rw [show run J.L (g x)=x from Spire.Client.fall L x] at hx; exact hx
