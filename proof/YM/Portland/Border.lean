lemma pricedB (hP:Cr ≤ r*τV/2)(hX:T*U'=1)(hTX:U'*T=1)(hu:0<u0)(hT:∀ i j,‖T i j‖≤ p) : costB (Y.series P₀ (t!) Yq E LL νP) s₀ u0 (r*τV) T U':=by
       have h:=hY.ship; let V:=r*τV; have h0:0 < V := mul_pos hr h.mass_p.margin; have hα (b: Flavor 6):∀ᶠ i in atTop, ‖(((Tz).A i).massRead 0 b)-(s₀ b:ℂ)‖≤V/2:=by
             filter_upwards [Metric.tendsto_nhds.1 (h.mass_p.tendency b) (V/2) (by positivity)] with i hi; rw[dist_eq_norm] at hi; exact hi.le
       filter_upwards [eventually_all.mpr hα,beliefs P₀ E LL Θ Uv i0 ξ Q Mg eD PxPad νP Δ S U Y hTol costa s₀ hY hv ht p hp hx T U' u0 hq hK hs htL hu hT] with i hi hv; refine ⟨hv.1,fun a b hX' k=>?_⟩
       let X:= (Tz).A i; obtain ⟨M,hk,hP',hS⟩:=Massive.PCAC.deliver T a b X k (h.β_path.normalized i) hX' u0 hv.1; intro Yv E'; unfold E'; rw[hS _ (Nat.zero_le _), chord_sub, answering T U' a b X k hX hTX 0 (Nat.zero_le _) (h.β_path.normalized i)]
       let w:= if k then b else a; let v:= X.massRead 0 w; let g:= Massive.PCAC.chord U' a b X 0 (passenger (M 0)); let z:ℂ:=s₀ w; change ‖v-g-z‖≤ _; rw [show v-g-z=(v-z)-g from by ring]; exact (norm_sub_le ..).trans ((add_le_add (hi w) ((hv.2 a b hX' M hk hP').trans hP)).trans_eq (by unfold V; ring))
