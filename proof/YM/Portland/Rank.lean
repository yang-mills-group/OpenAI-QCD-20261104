noncomputable def vBill (b:ChangeQ) :ℝ:= 100*(Real.exp 1*Real.exp (((P₀ b).guide.relative+1)*Footprint.preCost 38))+(spareCut 1)⁻¹
lemma vBill_pos (b:ChangeQ):0< vBill P₀ b:=by unfold vBill; have h:= spareCutp; positivity
structure DepotT (C p:ℝ) (j n:ℕ) : Prop where
   lifts :∀ L:Side,n ≤ L.val→∀ (R:TokenP)(w D F r v:ℝ), 0<w → 0≤D → 0≤F → R.v ≤ C*D → R.s ≤ C*F → (1:ℝ)/2 ≤ r → 0≤v → 4*(Comet.strideL j L)*(8*p) ≤ w*v/2 → TollG R L j r w D F (8*p) v p
lemma solvable (p:ℝ)(hp:0≤p):∃ g:ChangeQ→ℕ,∀ b, DepotT (vBill P₀ b) p b.old (g b):=by
    choose g hg using fun b=> leasesR b.old (vBill P₀ b) p hp (vBill_pos P₀ _);
    exact ⟨g,fun i=>⟨hg i⟩⟩
noncomputable def enhancedB (x:ℝ):= x^(17/100:ℝ)
noncomputable def moldB (x:ℝ):= x^(-(9/25):ℝ)
-- curve Ships
abbrev NeedsR (p tol:ℝ): Calls P₀ tol:= fun b S _ _ _ _ T x=> Wit (P₀ b).guide T.o S.L b.old θ (run S.L x) ∧ 2*arctic S.L b.old+ berthD b.old ≤ highR S.L (run S.L x) ∧ Real.exp 1≤ betaF su (run S.L x) S.L ∧ 8*Comet.strideL b.old S.L*(8*p) ≤ wishGain (run S.L x) S.L * moldB (run S.L (run S.L x))
lemma payG (p:ℝ)(g:ChangeQ→ℕ):∀ b S zf σ Λ V (T:LedgerQ (P₀ b) tol S zf σ Λ V), g b ≤ S.L.val → S.patch.Branches K su → 0<σ→1≤zf→1≤Λ→ V.Rates (P.width b)→∀ᶠ x in atTop,NeedsR P₀ p tol b S zf σ Λ V T x:=by
   intro b S zf σ Λ V T _ _ _ _ _ _
   let pH:= S.L; let f:= run pH; have ht:Tendsto f atTop atTop:= E09.betaF_growth su _
   have hx:Tendsto (fun x=>wishGain x pH*moldB (run pH x)) atTop atTop:=by
       let k:ℝ:=3/8+-(9/25); refine ((tendsto_rpow_atTop (show 0<k by unfold k; norm_num)).comp ht).congr' ?_
       filter_upwards [ht.eventually_gt_atTop 0] with x hh; exact Real.rpow_add hh ..
   exact (ht.eventually (Comet.rendezvous (P₀ b).guide T.o b.old pH θ)).and ((ht.eventually (ht.eventually (Work.E07.radiusB_eventually _))).and (((ht.comp ht).eventually_ge_atTop (Real.exp 1)).and (ht.eventually (hx.eventually_ge_atTop _)))) -- namespace
-- tariff example.Tag.Across.L
lemma advanceK (x:ℝ) : Monotone (A.scale x):= fun i j hp=> add_le_add_right (mul_le_mul_of_nonneg_left (A.measure_strict.monotone hp) (Gauge.slopeConstant_pos simple).le) x -- add orientation
lemma pours (hx: Real.exp 1≤ A.scale x (i+1)): (escrow P₀ A X x αH (i+1)).v≤ (vBill P₀ (A.node i))*F0:=by
    let b:= A.node i; let Vw:= (P₀ b).guide; let x':=x⁺; let W:= Real.exp 1*Real.exp ((Vw.relative+1)*Footprint.preCost 38); have he:= augmented P₀ A (i+1) x; have hv:F0*W=fundsL qS θ x⁺:= (feePower _ _ _ _).2.1
    refine le_trans (mul_le_mul_of_nonneg_left ?_ (show (0:ℝ)≤ 100 from by norm_num)) ((le_of_eq (show 100*fundsL qS θ x⁺=(100*W)*F0 from ?_)).trans (mul_le_mul_of_nonneg_right ?_ (feePower _ _ _ _).1.le))
    · change (Vac.Numbers.P (_:ℝ))^(-θ) ≤ (Vac.Numbers.P (_:ℝ))^(-θ); rw [show betaF su (run (A.spacing (i+1)) (clockQ P₀ A x (i+1))) (A.spacing (i+1))=A.scale x (i+1+1) from (congr_arg (run (A.spacing (i+1))) he).trans (A.eras x (i+1)).symm,show betaF su (run qS ζi) qS=A.scale x (i+1) from (congr_arg (run (A.spacing i)) (augmented P₀ A i x)).trans (A.eras x i).symm]; let a:= A.scale x (i+1); let y:= A.scale x (i+1+1); have hk:0<a:= (Real.exp_pos ..).trans_le hx; have hm:1≤ Real.log a:=by rw[←Real.log_exp 1]; exact Real.strictMonoOn_log.monotoneOn (Real.exp_pos _) hk hx
      have hh: (Vac.Numbers.P a)≤ (Vac.Numbers.P y):= Real.exp_monotone (pow_le_pow_left₀ (Real.log_nonneg hm) (Real.log_le_log (by linarith only [hm]) (Real.log_le_log hk (advanceK P₀ A x (Nat.le_succ _)))) _)
      exact Real.rpow_le_rpow_of_nonpos (Real.exp_pos _) hh (neg_nonpos.mpr (P₀ b).lead.le) -- name
    · rw [←hv]; ring
    · exact le_add_of_nonneg_right (inv_nonneg.mpr spareCutp.le)
lemma cupsR : (escrow P₀ A X x αH (i+1)).s ≤ (vBill P₀ (A.node i))*spareCut 1:=by
     let t:= A.node i; have hp:= vBill_pos P₀ t
     refine (inv_le_one_of_one_le₀ (?_ :1≤ taxK _ _ 1)).trans (le_trans (le_of_eq (inv_mul_cancel₀ spareCutp.ne' |>.symm)) (mul_le_mul_of_nonneg_right (?_ : (spareCut 1)⁻¹≤ vBill P₀ t) spareCutp.le))
     · exact Real.one_le_exp (mul_nonneg zero_le_one (fan_pos ..).le)
     exact le_add_of_nonneg_left (mul_nonneg (by norm_num) (mul_pos (Real.exp_pos _) (Real.exp_pos _)).le)
