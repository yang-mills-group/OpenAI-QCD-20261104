lemma cityR (i:ℕ) : Ship P₀ A X x p (enhancedB x) (moldB x) i:= by
      obtain ⟨hW,hB,hM,hC⟩:=(hg i).2; let t:= clockQ P₀ A x i; let L:= A.spacing i; let X':= run L t -- :=
      have h0: run L (run L t)=A.scale x (i+1):=(congr_arg (run L) (augmented P₀ A i x)).trans (A.eras x i).symm
      have hm':Real.exp 1≤A.scale x (i+1):= h0 ▸ (show Real.exp 1 ≤ run L (run L t) from hM); have hm: x ≤ A.scale x (i+1):= (A.atBirth x).symm.le.trans (advanceK P₀ A x (Nat.zero_le _))
      let k':=rank (A.level (i+1)); let v:= A.node i; let D:= Fleet.Glow.payFee (P₀ (A.node i)).guide L θ (run L t); have he: enhancedB x ≤ Fleet.Glow.bTop L (run L t):= ((Real.rpow_le_rpow (zero_le_one.trans hx) (hm.trans_eq h0.symm) (by norm_num:0≤(17/100:ℝ)))).trans (Real.rpow_le_rpow_of_exponent_le (hx.trans (hm.trans_eq h0.symm)) (by norm_num))
      let Wq:= Comet.wishGain X' L; have hw: 0 < Wq:= Real.rpow_pos_of_pos ((lt_of_lt_of_le (Real.exp_pos _) (hm'.trans_eq h0.symm))) _
      have hpL:π v≤ L.val:= (hV _).trans (show gate (A.node i)≤ (A.spacing i).val from by rw [show A.spacing i=_ from A.length_eq i, ← A.node_at i]; exact A.room _)
      refine ⟨hB,h i,hW,he,hw.le,fun w hv=>?_⟩; have h': moldB X'≥0:=by -- not needed drop
            unfold moldB; apply Real.rpow_nonneg; unfold X'; rw [augmented]; exact zero_le_one.trans (hx.trans ((A.atBirth x).symm.le.trans (advanceK P₀ A x (Nat.zero_le _))))
      have hΓ:=heq v; have hs:0 ≤ moldB x:=Real.rpow_nonneg (zero_le_one.trans hx) _
      apply hΓ.lifts L hpL _ Wq D _ w (moldB x) hw (feePower _ _ _ _).1.le spareCutp.le (pours P₀ A X (enhancedB x) hm') (cupsR P₀ A X (enhancedB x)) hv hs
      have hx':0 < x:= by linarith
      have ht:moldB (run L X') ≤ moldB x := Real.rpow_le_rpow_of_nonpos hx' (hm.trans_eq h0.symm) (by norm_num)
      have hk:(8:ℝ)*Comet.strideL v.old L*(8*p)≤ Wq*moldB x:= hC.trans (mul_le_mul_of_nonneg_left ht hw.le) -- cast info.
      linarith only [hk]
