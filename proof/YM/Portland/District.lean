     apply shipping P₀ A X B T Z V U W F hp hX hc E M₀ he Y hh C Ht O L1 hC (enhancedB x) p (moldB x) ht (fun i hp=> ?_) hi (Real.one_le_rpow hx (by norm_num)) (fun i _ => cityR P₀ A X p heq hV (fun i=>(hv i).2.2.1) (fun i=>⟨(hv i).1,(hv i).2.1⟩) hx i) hTol hj -- parameter order
