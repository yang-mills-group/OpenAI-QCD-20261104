   intro b S zf σ Λ V T H1 H2 H3 H4 H5 H6
   exact (payG P₀ p g b S zf σ Λ V T H1 H2 H3 H4 H5 H6).and ((Work.E09.betaF_growth su _).eventually (Work.E07.radiusB_eventually _))
