    obtain ⟨f,hG,h₁⟩:= h.stocked; obtain ⟨g,hW,hQ⟩:= hb.stocked; rw [sub_eq_add_neg,sub_eq_add_neg]; have ha:1 ≤vT:=hv.2.2.season.2; have hY:1 ≤ taxK qS sⁱ 1:= Real.one_le_exp (mul_nonneg zero_le_one (fan_pos ..).le)
