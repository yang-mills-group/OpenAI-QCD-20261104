lemma currentPc (hp1:0<Xb)(hΨ: Wz i hi A₁ q' Fp (fun _=>Bs) Dg X!)(hB:Fires (wrap cp ∘ A₁) M)(hz:∀ k,Tt i (p k) ≤ Xb)(hF:Counter.Cave qS sⁱ θ)(f:Fin m→I)(hf:Injective f)(hL: MassiveQCD.Sample.Quills.crest f ∈ Dg) : (∏ i:Fin m,σ (f i))* ‖joint (G m f) / joint (Un i)‖ ≤ Real.exp (Ar * (Rails.Reference.Sharp.Rapture.fareUp L1 Kᶻ (A.flight i).patch θ M Kφ VV (Ht.cost i) Δ₀ (O.Y i) sⁱ)):=by
     have hs:0 < Wc i:= hF.shape.1; have hk : Wc i ≤1:= hF.shape.2.1; have hy(j:I):0<σ j:=div_pos hs hp1
     have hP:1 ≤ Φ₀:=stem_h ..; have hd:0 ≤ (Δ₀):=by have h:=ξ.award.funds; positivity
     have hΩ:= Lobby.Rapture.peers P₀ A X B T Z V U W F hp hX hc E M₀ he Y C Ht O L1 hC Θ Uv i0 Gn ξ Ξ hv hP1 q' Fp A₁ Dg (fun _=> Bs) (Talent.scale σ G) Kφ ht M Δ₀ hd hi hΨ (?_) hB f hf hL; swap
     · intro j; let t:= (Fp) j
       have hg:= hz j; have hG: Tt i t ≤ Wc i:=by unfold t FWealth; rw [Stair.wealth_scale,Conductor.normS _ (hy j).le]; exact (mul_le_mul_of_nonneg_left hg (hy j).le).trans_eq (div_mul_cancel₀ _ hp1.ne')
       change Real.exp _*ξ.b* Tt i t + _ ≤Δ₀; apply (add_le_add (mul_le_mul_of_nonneg_left hG (mul_nonneg (Real.exp_nonneg _) (zero_le_one.trans ξ.award.funds))) (le_mul_of_one_le_left hs.le hP)).trans; rw [← add_mul]; exact mul_le_of_le_one_right hd hk
     let a:=Talent.realize σ f; have hN(z:ℂ):joint (z • (G m f))= z * joint (G m f):=by
           unfold Massive.joint; rw [← integral_const_mul]; apply integral_congr_ae; filter_upwards with V; rw [Pi.smul_apply,map_smul,smul_eq_mul]
     have heq:‖a‖=∏ i:Fin m,σ (f i):=by unfold a Talent.realize; rw [norm_prod]; exact Finset.prod_congr rfl (fun i _=> normS _ (hy (f i)|>.le))
     refine le_trans ?_ (hΩ.trans_eq (congr_arg Real.exp ?_)); swap
     · unfold Rails.Reference.Sharp.Rapture.fareUp Rails.Reference.Sharp.Rapture.legendF; have hK:(Pt i).B= highR qS sⁱ:=(waking P₀ A (hX i)).ball; rw [hK]; rfl -- P.B eq
     rw [←heq,show joint (Talent.scale σ G m f)= _ from hN a]
     rw [mul_div_assoc,norm_mul]
