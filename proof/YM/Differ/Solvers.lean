lemma poseR (hx:30*((D').r+1)≤(cp).val)(hF:Fires (wrap cp ∘ A₁) (price P₀ A Mc i))(hY:Vι i hi A₁ q' Fp (fun _=>Wc i) Dg X!)(hPz:0<Xb)(hz:∀ j, χₛ i (p j) ≤ Xb)(t:Fin m→I)(ht: Injective t)(hS:Quills.crest t∈Dg)(hB : Fintype.card (Site cp) ≤ m*packN qS sⁱ K0^4): ‖joint (G m t) / joint (uPulse P₀ A B M₀ Y s w i)‖ ≤ (((Wc i)⁻¹*Xb)* Real.exp ((Track.scale A x i)^(1/2:ℝ)))^m:=by
    let hC':= (hm.force i).cave
    let D:=(Wc i)⁻¹*Xb; let γ:=Real.exp ((χᴳ i)^(1/2:ℝ)); let U₀:=hm.worth.head; let Q:= σ; let y:=∏ i,Q (t i); have hQ(j): 0<Q j:= div_pos hC'.shape.1 hPz; have htL:= (hm.said i).2 Gn hL
    have H:=currentPc P₀ A X B T Z V U W F hp U₀.funded U₀.calm E M₀ he Y C Ht O L1 hC Θ Uv i0 Gn D' Ξ' htL hx q' p A₁ Dg G (Fι i) hi (hm.digit i) Xb hPz hY hF hz hC' t ht hS
    have hzQ(j): (Q j)⁻¹ ≤ D:=by unfold Q D; rw [inv_div,div_eq_mul_inv,mul_comm]

    let J':=twist (P:=P) (A.node i); let z:= fareUp L1 J' (A.flight i).patch θ (Fι i) (W' i) (outK (dab P₀ A E i) (fees P₀ A E i)) (Ht.cost i) Δ₀' (O.Y i) sⁱ
    let V₀:ℝ:=Fintype.card (Site cp); let ψ:=(χᴳ i)^(1/2:ℝ); let u:=G m t
    have hε:= (hm.force i).press Gn hL; let p':ℝ:= (packN qS sⁱ K0:ℕ); have hS:p'^4*|z| ≤ ψ:=by rw [← abs_of_nonneg (show 0 ≤ p'^4 by unfold p'; positivity),←abs_mul]; exact hε.trans_eq (congr_arg (fun t:ℝ=> t ^ (1/2:ℝ)) (augmented P₀ A i x))
    have hP:Real.exp (V₀*z) ≤ γ^m:=by
        unfold γ; rw [←Real.exp_nat_mul]; apply Real.exp_monotone; apply le_trans (mul_le_mul_of_nonneg_left (le_abs_self _) (by unfold V₀; positivity)); apply le_trans (mul_le_mul_of_nonneg_right (show V₀ ≤ (m:ℝ)*p'^4 by unfold V₀ p'; exact_mod_cast hB) (abs_nonneg _)); rw [mul_assoc]; exact mul_le_mul_of_nonneg_left hS (Nat.cast_nonneg _)
    have he :0 < y := prod_pos fun i _=> hQ (t i); have hD': y⁻¹ ≤ D^m:=by unfold y; rw [← Finset.prod_inv_distrib]; exact (prod_le_prod (fun i _=> (inv_pos.mpr (hQ (t i))).le) (fun i _=> hzQ (t i))).trans_eq (by simp)
    let p':=uPulse P₀ A B M₀ Y s w i
    have hC₁:y*‖joint u / joint p'‖≤ Real.exp (V₀*z):=H; rw [mul_pow]; apply le_trans _ (mul_le_mul_of_nonneg_right hD' (pow_nonneg (Real.exp_nonneg _) m)); apply le_trans _ (mul_le_mul_of_nonneg_left (hC₁.trans hP) (inv_pos.mpr he).le); exact le_of_eq (inv_mul_cancel_left₀ he.ne' _).symm
