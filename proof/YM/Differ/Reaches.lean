lemma recovery (Yp:Massive.UV.Label Gn)(hc:0<Xc)(hx:Wt n Lx ≤Xc)(hv:Wt n (Lx-Yp)≤ Bounce.ε Ay*(Xc + (Ωℓ n Yp))) : Wt n Yp ≤ 2*Xc∧ Wt n (Lx-Yp)≤ (1/(2*Ay))*Xc ∧ Xc+(Ωℓ n Yp)≤ (1+2*Ay)*Xc:=by
    let y:= Wt n Yp; let k:= Ay; let ε:=Bounce.ε k; have hp:= hP.honors (A.node n); have hr:1≤k:=hp.tall; have hR:0 < k:=zero_lt_one.trans_le hr; have he:0 <ε:= inv_pos.mpr (by positivity); have hε: 8*k^2*ε=1:= mul_inv_cancel₀ (by positivity)
    let d:=Wt n (Lx-Yp); have hx':d ≤ ε*(Xc+k*y):= hv.trans (mul_le_mul_of_nonneg_left (add_le_add_right (mul_le_mul_of_nonneg_right hp.base (wealth_ge ..)) _) he.le)
    have ht : y ≤Xc+d:= by
        let Q:= Lx-Yp; have h:= costW_sub P₀ A Θ Uv Gn ξ (Pt:=Pt) Lx Q (i:=n) (x:=x); rw [show Lx-Q=Yp from sub_sub_cancel ..] at h; exact h.trans (add_le_add_left hx _)
    have hn:0≤ y:= wealth_ge ..
    have hE₁:ε≤ 1/8:= by unfold ε Bounce.ε; rw [← one_div]; gcongr; nlinarith only [hr]
    have hE₂:k*ε ≤ 1/8:=by unfold ε Bounce.ε; rw [← div_eq_mul_inv]; field_simp; nlinarith only [hr]
    have hY : y ≤ 2*Xc:= by nlinarith only [hx',ht, mul_le_mul_of_nonneg_right hE₂ hn, mul_le_mul_of_nonneg_right hE₁ hc.le, hc]
    refine ⟨hY,?_ ,?_⟩
    · apply le_trans hx'; rw [div_mul_eq_mul_div]; apply (le_div_iff₀ (by positivity)).mpr; nlinarith only [congr_arg (fun e:ℝ=> e*y) hε,congr_arg (fun e:ℝ=> e*Xc) hε,hY, mul_le_mul_of_nonneg_right hE₂ hc.le,hc]
    let V:=Ωℓ n Yp; have h:V ≤ k*y:= mul_le_mul_of_nonneg_right hp.base hn; linarith only [h,mul_le_mul_of_nonneg_left hY hR.le] -- defeq p.
