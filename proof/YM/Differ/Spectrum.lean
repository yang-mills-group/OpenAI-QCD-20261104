        change β₁*(eμ* (u*T)+_ ) ≤ u*(c*(T+Fs^(Gn+1)*Xb)); apply le_trans (mul_le_mul_of_nonneg_left (add_le_add_right (add_le_add_right hP₁ ((Fs^(Gn+1)*Ωξ)*UPC)) _) hβ) -- `add_le_add_right ...` orientation mathlib prepend; yes inspect
        nlinarith only [congr_arg (fun Q:ℝ=> c*Fs^(Gn+1)*Q) hu0, mul_le_mul_of_nonneg_right hTη (mul_nonneg hu.le hg), mul_le_mul_of_nonneg_right hl (mul_nonneg (pow_nonneg hf.le (Gn+1)) hvf.le)]
    let f(k:To' r j):= |s k.val j| * (eμ * toted Fs (P' k.val) O₁ vT₁ + ((Fs^(Gn+1)*Ωξ)*UPC+Ωv))
    change β₁*(∑ k,f k) ≤ UC; rw [Finset.mul_sum]
    refine (sum_le_sum (fun k _=> (?_):∀ k:To' r j, k∈univ→β₁*f k ≤ (g k.val j)*UC)).trans_eq ?_
    · have hzV:= mul_le_mul_of_nonneg_left (hQ0 k.val k.property) (abs_nonneg (s k.val j)); unfold f; rw [mul_left_comm]; exact hzV.trans_eq (by rw [hxQ _ _ k.property]; unfold v; field_simp) -- k ∈?
    rw [← sum_mul,hw,one_mul]
