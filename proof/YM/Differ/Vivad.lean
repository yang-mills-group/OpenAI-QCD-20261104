   obtain ⟨pF',Γq,Bp,Tv',h1,h2,ht,hX,hRT⟩:= E.ready; have hBV:R₁.B= highR S.L (run S.L x):=hxP.symm.trans E.hr.ball
   obtain ⟨k,hk₀,hν,hr₀,hA₀,hY₀,hΨ₀,hM₀,hM₁⟩:= harvestUp (A₁:=A₁) (f:=f) τ.t Aμ Bα' Q.halo Θ hn' hk' hQP hBu hi hGx hS0 hT' hP0 hBV hJ' hE -- syntax
   let E0 : ℂ:=(k:ℂ); have he:‖E0‖=k:=Conductor.normS _ hk₀.le; have hF:0<‖E0‖:= he.symm ▸ hk₀; have hz:E0≠0:= norm_pos_iff.mp hF
   let Vx:= byG X₀ E0; let ℓ:= E0 • Lx; have hA : wealth ℓ.val R₁.threshold zᴮ=k*Fi:= by unfold ℓ; rw [wealth_scale,he]
   have h₀: toted stepQr ℓ R₁ zᴮ=k*Xr:=by unfold ℓ; rw [toted_g,he]
   have hφ : Published Vx Θ Dx nL μ⁰ (taxK S.L (run S.L x) 1) (k*M₁) (k*M₂):= he ▸ byGP X₀ hv E0
   let J':=Carrier.resident Y φ π φ (Puff.roll 6 (ritual Vx)) Vx.spine -- arg order.Y
   have hu: (seed_w (μ⁰*coverNumber R₁.B (Carte.Hem.pot (r'+1) f A₁))*Bα')*wealth ℓ.val R₁.threshold zᴮ +k*M₁ ≤ spareCut (Jets.Touch.chip S.L xᵃ):=by rw [hA, mul_left_comm _ k]; exact hν
   let ξ:=τ.alpha+1-μ⁰-μ⁰; have hξ : τ.alpha+1=ξ+μ⁰+μ⁰:=by unfold ξ; ring
   have hvq : 1 ≤ (frostQ Q.halo:ℝ):=by
      unfold frostQ; have h:1 ≤ (((Q.halo+1)+1)+((Q.halo+1)+1)+1):=by omega
      exact_mod_cast (show 1 ≤ _^4 from Nat.one_le_pow _ _ h)
   have hθ : (αL+2)* frostQ Q.halo ≤ ξ+μ⁰:=by have hj:=hMi.archives; rw [hzP] at hj; linarith only [hj,hξ,hvq]
   have hYq : Real.exp ((αI-μ⁰)*R₁.B)*(Aμ*(Kit.slope S.L^(Gn+1)*pre)) ≤ Hike.FeeH S.L S.L Gn Aμ pre xᵃ:= by rw [hBV]
   have hXA : Φ₀+Bα'*(Aμ*(Ωv* toted stepQr ℓ R₁ zᴮ+((stepQr^(Gn+1)*pre)*(k*M₁)+ΔD))) ≤ 1:=by rw [h₀]; exact hA₀
   obtain ⟨C,y,Yv,Iq,hYv,hIq,Zq,hZq,hB,hZx⟩:= harvestR T P₀ P₂ i₀ B Tv' Y φ Z0 E hSt hβ hb' hf pF' Γq Bp h1 h2 Θ hp hΩ hxP hxT hyP hyT hzT hn hn' hk hk' hΓp hzQ hMi π hQP A₁ Vx J' hπ hφ hs hK' hBu.lens.2 hTy hBu.costs A₂ hΛ hBu.lens.1 hβσ hθ hξ hΨ hα hZ hW hyD (hBu.halo c f (St).ratio rfl) hYq z₀ hZ0 hbX hX hRT hVc (hBV.symm ▸ hBu.ahead) (hBV.symm ▸ hBu.era) (zero_le_one.trans hi) hL hL' hvF hvK hu hr₀ hXA
   let Qz:= byG Zq E0⁻¹
   have hϝ:TypeBeta stepQr t₀ Ws (Ws*v) (Aμ*Ωv) (Δε*stepQr^(Gn+1)) (Δε*stepQr^(Gn+1)*(k*Xb)) R₁ R₂ ℓ y:=climb _ _ hB hM₀ hM₁
   have hP:= scaleK _ _ hϝ E0⁻¹; unfold ℓ at hP; rw [inv_smul_smul₀ hz,norm_inv,he, show k⁻¹*(Δε*stepQr^(Gn+1)*(k*Xb))=Δε*stepQr^(Gn+1)*Xb from (by field_simp)] at hP
   have hW:Published Zq Θ Dx nL μ⁰ (taxK S.L x 1) ((1+Bα'*Aμ)*Ωv*(k*Xr)+ (1+Bα'*Aμ)*(pre+1)*(stepQr^(Gn+1)*(k*Xb))) (stepQr^(Gn+1)*(k*Xb)):= funds_hi _ hZq (by rw [h₀]; exact hY₀) hΨ₀
   have hS : Published Qz Θ Dx nL μ⁰ (taxK S.L x 1) ((1+Bα'*Aμ)*Ωv*Xr+ (1+Bα'*Aμ)*(pre+1)*(stepQr^(Gn+1)*Xb)) (stepQr^(Gn+1)*Xb):=by
       have hw:= byGP Zq hW E0⁻¹; rw [norm_inv,he, show k⁻¹*((1+Bα'*Aμ)*Ωv*(k*Xr)+(1+Bα'*Aμ)*(pre+1)*(stepQr^(Gn+1)*(k*Xb)))= (1+Bα'*Aμ)*Ωv*Xr+(1+Bα'*Aμ)*(pre+1)*(stepQr^(Gn+1)*Xb) from (by field_simp), show k⁻¹*(stepQr^(Gn+1)*(k*Xb))=stepQr^(Gn+1)*Xb from (by field_simp)] at hw; exact hw
   obtain ⟨_,hXp,_⟩:= E.capital
