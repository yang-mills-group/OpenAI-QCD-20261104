   have hr : Tx (Ps) = C • (Ux):= funext fun i=> (moveV (S:=S) (a:=β) (w:=v) _ i).trans (hZx i).2
   have hZS : reading Qz Xy Uv= E0⁻¹ • reading Zq Xy Uv:= funext fun j=> applying Zq j hW _ _ hQP hn' hk' hVc hS₁ hXp.count hYa heQ E0⁻¹ -- asm
