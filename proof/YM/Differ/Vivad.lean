   have hYa : 1≤taxK S.L x 1:=Real.one_le_exp (mul_nonneg zero_le_one (fan_pos ..).le); have hYb:1≤taxK S.L xᵃ 1:=Real.one_le_exp (mul_nonneg zero_le_one (fan_pos ..).le)
