         by_cases hh':v=0
         · have h: (Ωℓ n v)=0:=by unfold LifeT.egg LifeT.FWealth; rw [Stair.wealth_zero _ _ _ hh',mul_zero]
           have hZ:= endowedScale P₀ A X B T V U W hX E M₀ he Y C Ht O L1 hC Θ Uv i0 Gn ξ Ξ (hP.viewQ n hpM) (hPt n hpM le_rfl) (Fp n x) Lx Pz x Xc le_rfl (hF x) 0
           rw [norm_zero,zero_mul,zero_smul,zero_smul] at hZ
           rw [show ((Φχ P) n x)=0 from ?_,show ω'=0 from h,hh']; exact hZ
           unfold genial; rw [boarding,show P x=Zb _ x 0 from congr_arg (Zb _ x) hh',map_zero,mul_zero,show (⇑(0:Insertion ((qv).side (B.n k) n) 6)) = (0: Massive.Density _ 6) from rfl,transit_zeroT]
         let Bs:= being P₀ A X B T V U W E M₀ he Y C Ht O L1 hC Θ Uv i0 Gn ξ Ξ; have hΨ:= itinerant P₀ A X B T Z V U W F hp hX hc E M₀ he Y hh C Ht O L1 hC Θ Uv i0 Gn ξ Ξ hTol hPt (fun m h _=>hP.viewQ m h) hpM hM₀ (fun m h _=>hP.vac m h) hPk hYt -- hpM:t ≤ n
         have h':= hΨ.journey.boot x v Pz hv hh'; obtain ⟨ht,H₀⟩:=h'; unfold genial; rw [boarding]; rw [hAq.start] at H₀
         exact H₀
    have hQP (b:Cover):VK n le_rfl b (Lx-Q' Jp y) (Xc+ω') (Xc+ω') Pz ((Φχ Δφ) n b):=by
