    obtain ⟨Zp,wz,H⟩:= aboveR P₀ A X B T Z V U W F hp hX hc E M₀ he Y hh C Ht O L1 hC Θ Uv i0 Gn ξ Ξ Lx Pz a φx Jp t γ Xc hAq hq hM₀ hP hPt hPk hTol hU hδ hx hW hF
    let y:= Zp m; let v:= Q' Jp y; have hpM:= hU.trans hδ; have hs:= H.poses m le_rfl hδ; have hy:Tally Θ 0 y ((Aim).density m) ((Tr) m 0):= exam P₀ A X B T Z V U W F hp hX hc E M₀ he Y hh C Ht O L1 hC Θ Uv i0 Gn ξ Ξ (hP.viewQ _ hU) (hPt m hU hδ) Pz φx Jp y hδ _ _ (hs 0); have hym : moored y.val Pz:= endowed _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ (hs 0) -- shorten
    have hv: moored (Q' Jp y).val Pz:= mooredMix Θ sym y Pz Zb (Aim) m hQ hym Jp
    let P:= Ps y; let Δφ:= φx-P; have hG(b c:Cover): Massive.Patria.march c ⇑(Δφ b) = ⇑(Δφ (b+c)):= postcard φx P hq (fun _ _=>Massive.Patria.Canvas.stylus ..) b c -- args probe
    let ω' := Ωℓ n v; have hω: 0≤ ω':= mul_nonneg (zero_le_one.trans (stem_h ..)) (wealth_ge ..); let Yv:= Xc+ω'; have hqκ:0< Yv:= add_pos_of_pos_of_nonneg hx hω
    have hp':Wt n (Lx-v) ≤ Xc+ω':= (costW_sub P₀ A Θ Uv Gn ξ Lx v).trans (add_le_add hW (le_mul_of_one_le_left (wealth_ge ..) (stem_h ..))) -- args i implicit.
    -- need Marquee candidate at n. use pilgrim or across. Construct Itinerary for W.Boot with hP. Wager derives, no Step if m=n.
