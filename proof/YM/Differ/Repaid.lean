lemma racing (h:t≤ m)(hT:Ψ v' S m)(hX:v' m=0): Bounce.Tracer Gn (fun i=> a (A.node i)) (fun i=>Kit.slope (A.spacing i)) Vx S Yq m n:=by
    let hΦ(i)(hi:m≤ i):= (hP.gapQ i (h.trans hi)).earns (A.node (i+1)) rfl
    refine ⟨(fun i hi hp=>hΦ i hi),(fun i hi hp=>(hT.alive _ hi hp).le), ?_,fun i hi hp=> ?_,fun i hi ht=> ?_, fun i hi ht=> hT.proceeds i hi ht⟩
    · change Wt m (v' m)=0; exact Stair.wealth_zero (v' m) _ _ hX
    ·
      apply Stair.lowerS (v' (i+1)) (hΦ _ hi).moves.le (hΦ _ hi).bounded -- exact def
    have hz := inverse_l P₀ A X B T Z V U W F hp E M₀ he Y hh C Ht O L1 hC Θ Uv i0 Gn ξ Ξ Lx Pz a φx Jp t γ Xc v' S hP hTol ht h hi hT -- sig
    change Wp _ _ ≤ _; apply hz.trans; let hhF:= hP.keeps i (h.trans hi); let q:=Kit.slope (A.spacing i); let v:=q^(Gn+1); have hx:(γ i)*v ≤ v:= mul_le_of_le_one_left (pow_nonneg (Kit.slope_pos _).le _) hhF.2; apply mul_le_mul_of_nonneg_left _ (show 0≤ a (A.node i) from zero_le_one.trans (hΦ _ hi).starts); exact add_le_add_right (mul_le_mul_of_nonneg_right hx (hT.alive _ (Nat.le_step hi) ht).le) _ -- orientation
