lemma sobering (h:t≤ m)(hT:Ψ v' S m)(hX:v' m=0) (Yz:ℝ)(hΨ:Xc ≤ Yz)(ht₁:m≤ i)(ht₂:i≤ n): S i ≤ Hymn.damping P₀ A Gn n i* Yz∧ Wt i (v' i) ≤ Bounce.ε (a (A.node i))*S i ∧ (i<n→ Bounce.wages (fun i=> a (A.node i)) (fun i=> Kit.slope (A.spacing i)) Gn i (Wp i (v' (i+1))) (Vφ (i+1) Yz) ≤ Vφ i Yz):=by
    let Fx:=Vx; let y:= Yq; let Q₀:= fun j:ℕ=> a (A.node j); let T':=fun j:ℕ=> Kit.slope (A.spacing j); let Q j := Θs n j*Yz
    have hm':= racing P₀ A X B T Z V U W F hp E M₀ he Y hh C Ht O L1 hC Θ Uv i0 Gn ξ Ξ Lx Pz a φx Jp t γ Xc v' S hP hTol h hT hX -- F shadow
    have hF: S n ≤ Q n:=by unfold Q; rw [hT.stature,Hymn.zeroF,one_mul]; exact hΨ
    have hx:1≤ Q₀ m:= (hP.honors _).tall
    have heq j:Q j = Bounce.planU Gn (T' j)*Q (j+1):=by unfold Q; rw [Counter.Hymn.pace P₀ A (i:=j),mul_assoc] -- sig
    have hQ(t:ℕ)(h1:m ≤ t)(h2:t ≤ n):=Bounce.budgetR Gn Q₀ T' Fx S y hm' Q hF (fun i _ _=> heq i) h1 h2 hx
    have hY := Bounce.lowR Gn Q₀ T' Fx S y hm' ht₁ ht₂ hx; refine ⟨hQ i ht₁ ht₂,hY,fun hi=>?_⟩; have hh:= Bounce.release_fee Gn (hm'.up i ht₁ hi) (hm'.tall (i+1) (Nat.le_step ht₁) hi) (hm'.learns i ht₁ hi) (hm'.promises i ht₁ hi) (hm'.tall _ ht₁ ht₂) hY (hQ (i+1) (Nat.le_step ht₁) hi)
    let V₁:=Q i; have hc: (1/2:ℝ)*Bounce.planU Gn (T' i)*Q (i+1)=(1/2:ℝ)*Q i:=by rw [mul_assoc,← heq]
    have hr:0 ≤ Q i:= (hm'.tall i ht₁ ht₂).trans (hQ _ ht₁ ht₂); have hx:0 ≤ Wt i (v' i):= wealth_ge ..; exact le_trans (le_add_of_nonneg_right hx) (le_trans hh (le_trans hc.le (by linarith only [hr]))) -- metavars
