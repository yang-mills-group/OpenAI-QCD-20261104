lemma blurt (h:∀ i, Ls (A₁ i) (p i) (q' i) Xb Cψ (Fv i))(hQ:∀ i j,i∈Dg→j⊆i→j∈Dg)(hf:Fires (wrap cn∘ A₁) M)(hs:∀ i∈Dg,Spaced (wrap cn ∘ A₁) i (Pt n).B) : Wz n le_rfl A₁ q' p (fun _=>Xb) Dg (tools Fv (Un n)) :=by
     choose J₁ hJp G Hp hC' hB using fun i=>(h i).fronts
     let φ:= π₂ n; let v := βT; let f := A.ring (B.n k) n; let Ux:= C.Λ n (Nat.zero_le _) le_rfl; have ht:‖w‖≤1:=by obtain ⟨h1,h2⟩:= hC.weight; rw [Real.norm_of_nonneg (by linarith)]; exact h2
     have heq:φ= (φ.re:ℂ):=by unfold φ voyage; rw [Melt.classicR,← Complex.ofReal_inv,← Complex.ofReal_mul]; rw [Complex.ofReal_re]
     have hq:|φ.re|<1:=by have hg:‖φ‖<1:= indoors P₀ A X E he w ht _; rw [heq, Complex.norm_real,Real.norm_eq_abs] at hg; exact hg
     obtain ⟨t,hI,Ft,hW,hT⟩:= hYt.shines.dawn _ hq; let W':= Ux.EvalK φ; have htV: Correspond Ft W':=by unfold W'; rw [heq]; exact hT
     have hx':=waking P₀ A (hX n); let K':= (Bn n); let G₁ V:=heartS (Ux.EvalE φ) (Pt n).threshold K' (Sn n) V; let A0:= momentT q' A₁ Uv p ξ.r (up (Pt n)) J₁ G W' G₁
     refine ⟨A0,struck q' A₁ Θ Uv p ξ.m ξ.s ξ.r (up (Pt n)) ξ.award hn J₁ G Xb Cψ hC' Ft Dg hQ M hf Lℓ νD hW Ux φ K' (Sn n) θ rfl htV hV hx'.ball hs rfl Hp,fun l f h hv=>?_⟩ -- struck shadow `Struck` namespace
     rw [(montera P₀ A X B T V U W E M₀ he Y C Ht O L1 hC n le_rfl).2.1]; funext v0; rw [Pi.smul_apply, Function.comp_apply,show _= _ from (show numbered q' (Keys _ 6) f (A0 v0)= _ from (flying q' A₁ Uv p ξ.r v J₁ G W' G₁ v0 f h))] -- Fintype
     have hT(j:I):spineV Uv (A₁ j) (p j) (q' j) v (G j)=Fv j:= hB j; simp_rw [hT]
     change ((Ωᴮ n le_rfl) • (Cove.light _ (exp (G₁ v0)*Kites.heartK W' v.threshold v0))) * _= _; rw [smul_mul_assoc]
