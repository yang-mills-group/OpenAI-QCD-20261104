    induction Zs using Finset.induction_on with
    | empty=>refine ⟨1,zero_lt_one, Eventually.of_forall fun r=>⟨0,1,le_rfl,fun L A θ _ _=>⟨(fun _ :ℝ=>(1:ℝ)),0, Rate.const 1,Eventually.of_forall fun x=>by simp⟩⟩⟩
    | insert a s h ih=>
         have hQ:∃ (w:ℝ),0<w ∧∀ᶠ r:ℕ in atTop,∃ (N:ℕ)(C:ℝ),1 ≤ C∧∀ (L:Side)(A θ:ℝ),0 ≤ A→0 < θ→ ∃ (p:ℝ→ℝ)(v:ℝ),Rate su L v p∧∀ᶠ x:ℝ in atTop,0 ≤ p x∧(a.material≠0→CutPrice L D Θ B a (Γ a.width) ε w C (p x) A N r x (θ:=θ)):=by
             by_cases hp:a.material=0
             · exact ⟨_,zero_lt_one,Eventually.of_forall fun r=>⟨0,1,le_rfl,fun L A θ h h1=>⟨fun _=>1,0,Rate.const 1,Eventually.of_forall fun x=> ⟨zero_le_one, fun hz=>(hz hp).elim⟩⟩⟩⟩
             obtain ⟨v,hv,hV⟩:= pressV D Θ B hV a (Γ _) ε he hp; refine ⟨v,hv,hV.mono fun x ⟨r,TkP,hτ,hL⟩=>⟨r,TkP,hτ,fun L A θ ha hh=>?_⟩⟩; obtain ⟨f,v0,hF,hG⟩:=hL L A θ ha hh; exact ⟨f,v0,hF,hG.mono fun i h=> ⟨h.1,fun _=> ⟨h.2⟩⟩⟩
         obtain ⟨y,hy,hX⟩:= hQ; obtain ⟨w,hW,hY⟩:= ih; refine ⟨min y w,lt_min hy hW,?_⟩; filter_upwards[hX,hY] with x hx hV; obtain ⟨i,Z,hZ,hS⟩:= hx; obtain ⟨j,W,hP,hT⟩:=hV; refine ⟨max i j,max Z W,hZ.trans (le_max_left ..),fun L A θ hz ht=>?_⟩; obtain ⟨f,v,H,hF⟩:= hS L A θ hz ht; obtain ⟨g,d,G,hG⟩:= hT L A θ hz ht; refine ⟨fun x=>f x+g x,max v d,(H.weaken (le_max_left ..)).add (G.weaken (le_max_right ..)),?_⟩; filter_upwards[hF,hG] with x hx hQ; refine ⟨add_nonneg hx.1 hQ.1,fun i hi ht=>?_⟩; obtain rfl|hT:=Finset.mem_insert.mp hi; exact chops L D Θ B i (Γ _) ε (hx.2 ht) (min_le_left ..) (le_max_left ..) (le_add_of_nonneg_right hQ.1) (le_max_left ..); exact chops L D Θ B i (Γ _) ε (hQ.2 _ hT ht) (min_le_right ..) (le_max_right ..) (le_add_of_nonneg_left hx.1) (le_max_right ..)
