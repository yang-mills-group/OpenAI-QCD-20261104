    let Xq j:=(yƒ:ℂ) • L₀ j; let Yt j:=(↑(-yƒ):ℂ) • p j; let w' j:= yƒ* Wv j; let Y0:= Talent.scale ψ₀ (nurture cp q' R Ψκ)
    have hz :0 < yƒ:= div_pos hw hX₀; have hκ: yƒ ≤1:= (div_le_one hX₀).mpr hx'; have hZ : ‖(yƒ:ℂ)‖=yƒ:= (Complex.norm_real ..).trans (Real.norm_of_nonneg hz.le)
    let Fq(j:I):= (yƒ:ℂ) • R j; let K:=Talent.scale Ψ₀ G; let Z:= nurture cp q' Fq K
    have hp':∀ j:I, Stamp.Tight Θ Uv (O₂) (A₁ j) ξ.r (Fq j) (Xq j) ξ.m ξ.s (q' j) (1/8) (Ft) vT (w' j) 0 Γ:=by
         intro j; have ht:= Stamp.Tight.bendsQ Θ Uv (A₁ j) (L₀ j) _ (O₂) (hF j) (yƒ:ℂ) -- order from variable
         rw [mul_zero,hZ] at ht
         exact Stamp.Tight.rentsQ Θ Uv (A₁ j) (Xq j) _ (O₂) ht (w' j) Γ le_rfl (mul_le_of_le_one_left ha hκ)
    have h0:= prospectT P₀ A X B T V U W hX E M₀ he Y C Ht O L1 hC Θ Uv Gn ξ hP1 q' Yt A₁ Dg M₀h K Fq hi Xq w' Γ ha hvy hB hpK hf hS hp' hs' H
    have hA(j:I): M₀h j + w' j ≤ V₀:=by
         let y:= FWealth P₀ A Θ Uv Gn ξ (Pt:=Pt) (x:=x) i (p j); let Y:=V₀; let b:= ΓC; let P:=Wv j; have hh:0<y:=hy j
         change |Y/M| / (Y/y) * (b*Y)+(Y/M)*P ≤ Y; rw [abs_of_pos hz, show Y / M / (Y / y) * (b * Y)+Y/M*P=Y/M*(b*y+P) from by field_simp]; exact (mul_le_mul_of_nonneg_left (hU _) hz.le).trans_eq (div_mul_cancel₀ Y hX₀.ne')
    have hK : K=Talent.scale ψ₀ Ψκ:=funext fun t=> funext fun f=>by
         change Talent.realize Ψ₀ f • _=Talent.realize ψ₀ f • (Talent.realize _ f • _); rw [smul_smul]; apply congr_arg (· • G t f); unfold Talent.realize; rw [←prod_mul_distrib]; exact prod_congr rfl (fun _ _=> by rw [Complex.ofReal_neg]; simp)
    have hZp(t:ℕ)(f:Fin t→I)(hf:Injective f): Y0 t f= Z t f:=by unfold Z; rw [show Y0 t f = _ from tonnage q' R Ψκ ψ₀ f hf,hK]
    have h:= raises P₀ A X B T V U W E M₀ he Y C Ht O L1 hC Θ Uv Gn ξ q' (Yt+Xq) A₁ Dg _ Z hi h0 (fun _=>V₀) hA
    have ht:Yt+Xq=fun j=> (yƒ:ℂ) • (L₀ j-p j):=funext fun j=>by change Yt j+Xq j=_; unfold Yt Xq; rw [Complex.ofReal_neg,neg_smul, smul_sub,add_comm,sub_eq_add_neg]
    rw [←ht]; obtain ⟨Z,hZ,H⟩:=h.cost; exact ⟨Z,hZ, fun t f hf ht=>(hZp _ f hf).trans (H _ f hf ht)⟩
