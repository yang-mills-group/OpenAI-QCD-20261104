     obtain ⟨S,g,P,U,Y,h,H⟩:= hX.coil; refine ⟨?_,?_,H.partT,H.leafT,H.current,H.near,H.lean⟩ <;> ( obtain ⟨v,w,F,Qb,_,z,Z,h,-,-,-,-,-,rfl,-⟩:= H.studio ) -- Sigma parse last _ use
     · exact h.finish.1
     intro m hm; let j:= n-m; have hj : j≤n:=Nat.sub_le ..;
     refine ⟨h.beta j hj,((h.costs j hj).1.2).trans_eq ?_,Reference.toll _ _ _ _ h heJ m hm⟩ -- bullet
     unfold hatG delay; rw [show n-j=m from by omega]
