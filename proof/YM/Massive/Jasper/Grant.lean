    filter_upwards [h,demand F₀ Y J.L (passportM J.J J.order_cut) hj hκ hH.primary,valve (T':=T') (J:=J) (N:=N) hr hk.gives.wedge hk.gives.fuel] with x hX hm hv; obtain ⟨B₀,B,hB,Hc,hP,h4,hθ,hk0,hv₀,hg,hX⟩:= hX; refine ⟨B, Hc,hB, ⟨B₀,hP⟩, h4,hθ,hv₀,hk0,hg,?_⟩; intro n hs; obtain ⟨S,g,U,E,P,hA1,hP,hX⟩:= hX n hs; refine ⟨S,g,U,E,P,⟨hA1,hP⟩, ?_⟩; intro v hv' r hh; apply countD _ _ _ _ _ hk hB heJ hA1 hv (hm r hh) hv' hp hL hh hY.1 hr hs; filter_upwards [hX] with k hx; obtain ⟨v,u,w,F,hP,hS,H,hI,hT⟩:= hx (1/2) (by norm_num); exact ⟨v,u,w,F,hP,hS,H,hT⟩ -- R projections implicit priorities
