lemma costTransit (hQ: Cargo D₁ Y₁ QY Fv K₀ K₁ W P (fan L t x) v' d D u' r ψ)(hs: Advances Z₁ (dues (P:=P) D₁ Y₁) D0 U₁ V D' O U σ₀ v' αL m₁ P)(h:Seed U₁ P (taxK L x 6) (7*(1/32)) δf Xp)(hX:Switch (N:=N) P L x t H ε Asc)(hz: 7*(1/32)+1≤ψ)(hv: ψ+2≤d)(hf:∀ v,Summable (letters D0.P P.threshold v))(hh:r+Weft.branchCost P N D ψ+(r+Weft.reFare P u' ψ) ≤1) [Countable I][Countable J0]: -- hdues implicit P
     ∃ (I' : Type)(_ : Countable I')(X:ℂ→ℂ→ Patron.Rail c N I'),Seed X P (taxK L x 4) (3/16) δf Xp ∧ ∀ (z s:ℂ)(U':Grid c), ‖z‖≤1 → ‖s‖≤1 → wearK c N v' (Z₁ z s U')= σ₀ • (Complex.exp (Weft.moneyL W QY Fv z s) • (scoreV (payWarp D0 QY Fv W z s) (X z s) P.threshold (scent V.Z.page P D' O αL 0 N) (U+m₁ • 1) U')):=by
     have hN := hX.count; have ht:0 ≤ ψ:= by linarith
     let V' (z s:ℂ):= wet Mξ (serving Kζ z s)
     have hB := Weft.cashable K₀ ψ Y₁ W D₁ u' D QY Fv K₁ hQ ht hN hv; have hU := hB.funds
     let T₀:= fan L t x; let b:=P.threshold
     have hF (i:Weft.Lit J0):= paceA W hQ.digest i
     have hp : Arch V':=sourA _ _ (fun i=>(hF i).1)
     let Y:=graffiti U₁ V' b; have hω := climbed U₁ (Mξ) hX _ hU (fun i=>(hF i).1) (fun i=>(hF i).2) hh hz h
     refine ⟨_,countT U₁ V',Y,hω,fun z s U' ha hm=>?_⟩
     rw [hs.shape z s U' ha hm]; apply congr_arg; -- expected smul
     let B:=Pith.rentGem (c:=c) (Pith.gaugeMass QY); let p:=Struck.pigment Struck.Library.Carrier.pegE z s; let G:= payWarp D0 QY Fv W z s; let φ:= scent (c:=c) V.Z.page P D' O αL 0 N; let X:=U+m₁•1; let H:=heartS D0.P b φ X U'; let v:= p • (Patron.total B b U'+Patron.total (Pith.dusting QY) b U')+Patron.total (Library.wind (Weft.shone Fv) (serving W z s)) b U'; let u0:=Calm.netT (V' z s) U'; let δ:=Weft.moneyL W QY Fv z s
     have he:= completeS K₀ ψ Y₁ W D₁ U' u' D QY Fv K₁ hQ ht hN hv z s ha hm
     refine fireCost (wearK c N v' (dues (P:=P) D₁ Y₁ z s U')) (heartK (U₁ z s) b U') H v u0 (heartK (Y z s) b U') (heartS G b φ X U') δ ?_ ?_ (heartEarned U₁ V' h.prag hp (wetted _ _ hU.tree) (wetCost _ (serving Kζ z s) (fun i=>upperPaint _ _ _ ha hm) hU.budget) hN ht ((h.scene z s ha hm).awake U'))
     · rw [show wearK c N v' (dues (P:=P) D₁ Y₁ z s U')= _ from he]; unfold v δ u0 V'; abel
     unfold H heartS; refine (congr_arg (_+·) (show Patron.total G _ U'=Patron.total D0.P _ U'+v from ?_)).trans (add_assoc ..).symm; have he:0 ≤ d:=by linarith
     have h0:T₀>0:= zero_lt_one.trans_le hN; have hv:= Library.spar (Pith.dusting QY) p U' (permits _ hB.low.law h0 he U'); let T:= Library.wind (Weft.shone Fv) (serving W z s); have hp:(Summable (letters T b U')) := permits T (Library.frozen _ _ (fun i=>upperPaint _ _ _ ha hm) hB.high.law) h0 he U'; unfold v; rw [smul_add,add_assoc (p • Patron.total _ _ _)]; exact (Library.weaved _ _ _ (hf U').hasSum (Library.weaved _ _ _ (Library.spar B p U' Summable.of_finite) (Library.weaved _ _ _ hv hp.hasSum))).tsum_eq

