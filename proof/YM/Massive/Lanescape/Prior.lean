private lemma key_town {N:ℕ}(I1 I2:Type) [Countable I1][Countable I2] (G G':Gem f N I1)(F F':Patron.Rail f N I2)(z:G.addr=G'.addr) (he:F.addr=F'.addr): coreR (A:=⟨_,_, G,F⟩) G'.view F'.warp = (⟨I1,I2,G',F'⟩:Voice f N):=by unfold coreR; dsimp only; rw [z,he]
lemma townEq (z s:ℂ): frozenV (sensor φ Y) z s = town φ Y z s:=key_town _ _ _ _ _ _ (supportsE ..).symm (supportsK ..).symm
lemma caneDeck (z s:ℂ): deckH (town φ Y z s)=Cane Y φ z s:=rfl
-- when transporting across DeckH (frozenV), cannot `rw[townEq]` in type involving projections of Voice. property parametric. Or congr on `EvalRise`.
lemma caneRole (z s:ℂ): deckH (frozenV (sensor φ Y) z s)=Cane Y φ z s:= buttress ..
include hy ht hh hk
lemma noble : Able (town φ Y 1 1) (sensor φ Y) R:=by
    obtain ⟨he₁,he₂⟩:= Carrier.cords Y hh; refine ⟨he₁,he₂,fun z s hz hs i U=>?_,fun z s hx ht i U=>observeK ..⟩; rw [show ((deckH (frozenV (sensor φ Y) z s)).reading ..)=_ from (show _=_ from congr_arg (fun V:Rise f N (EIndex Y) (KIndex Y) => V.reading R.threshold U i) (caneRole Y φ z s))]; exact Carrier.passport Y φ z s (by norm_num) ht hk hy hz hs U i -- campus
