lemma victory : WinterR T P₀ (town φ Y 1 1) (sensor φ Y) B p Γ:=by
    obtain ⟨h1,h2⟩:=olympic T P₀ i₀ B hp Y φ p1 r1 f0 g k₀ k₁ hy hh hpM hk hL hR ht 1 1 (by simp) (by simp)
    refine ⟨noble i₀ Y φ p1 r1 hy hh hk ht,h1,fun z s hz hs=>?_ , supportP T P₀ i₀ B Y φ hh hΓ hg, h2⟩
