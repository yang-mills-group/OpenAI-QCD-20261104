lemma germ (sx:1≤y)(hL:1<J.L.val)(hw:w∈Set.Icc (1/2:ℝ) 1): 0 < mud (F' w 1):= by
    let ψ:= φ y; have hS:2<ψ:=(Rotary.spring J.L hL y sx).1; let X(t:ℝ):= mud (F' (t:ℂ) 1); let F(t:ℝ):=(X t).re; have hV(t:ℝ):X t=(F t:ℂ):=coin _ (hT t); change 0< X w;
    rw [hV]; apply Complex.zero_lt_real.mpr; by_contra hn; have hv : X 0=mud (F' 0 1):=by simp only [X,Complex.ofReal_zero]
    have hh: 0< F 0:= Complex.zero_lt_real.mp (lt_of_lt_of_le (show 0< X 0 from hv.symm ▸ h0) (hV 0).le); have hk : Continuous F:= Complex.continuous_re.comp ((clay c N).continuous.comp hf); have hp : 0∈Set.Icc (F w) (F 0):=⟨le_of_not_gt hn,hh.le⟩; obtain ⟨x,hx,E⟩:= intermediate_value_Icc' (by linarith only [hw.1] : 0≤w) hk.continuousOn hp; let μ₁:= x/ψ; have hs :0< ψ:= by linarith
    have hM: ‖(μ₁:ℂ)‖<1:=by rw [normS μ₁ (div_nonneg hx.1 hs.le)]; exact (div_lt_one hs).2 (by linarith only [hx.2,hw.2,hS]);
    apply bodyne F₀ M₀ L1 F' D' hdT _ hM; change mud (grow ψ F' μ₁ 1)=0; rw [show grow ψ F' μ₁= F' (x:ℂ) from (by unfold grow μ₁; push_cast; field_simp), show mud (F' (x:ℂ) 1)=_ from hV x, E]; rfl
include hk
lemma member (hB:P.B=highR J.L y)(hx:0 < Jets.Touch.chip J.L y)(he:Jets.Touch.chip J.L y ≤1)(hx':1≤y)(hL:1<J.L.val)(hw:w∈Set.Icc (1/2:ℝ) 1)(hA:TicketW N P (fan J.L σ y) (Requests (N:=N) D0 ε J y) a d Λ W r T'.top.clip Ω (passportM J.J J.order_cut) c)(hv:D'.Bounds T'.top.clip a d Λ)(hz:|α|≤ W): Massive.Stiffness.Window (Cove.light _ ∘ F' w) α r:=by
    let q:= attendance y w; let E:Voice c N:= ⟨_,_,Vt.EvalE q, Vt.EvalK q⟩; have hh:= germ F₀ M₀ L1 F' D' hdT hT h0 hf hx' hL hw; have hℓ:2< φ y:= (Rotary.spring J.L hL y hx').1; have ht:=inside y hx' hL hw; have hq : ‖(q:ℂ)‖<1:=by rw [normS q (by linarith only [(show 1/8≤ q from ht.1)])]; linarith only [(show q≤1/2 from ht.2)]
    let X:= Maternal Vt P (zq) (hedge (J:=J) Ω U i c y+μ • 1) q; let K:=Vt.EvalE q; let K0:= passportM J.J J.order_cut; obtain ⟨C,-,-,-,-,hc⟩:= hdT.glaciers.wing.launch; have hC : grow (φ y) F' q=F' w:=by unfold grow q attendance; push_cast; field_simp [(by linarith only [hℓ] : (φ y:ℝ)≠0)]; -- test
    have hf : F' w = C q • X:= hC.symm.trans (hc q hq).2; have he : X= red E.P E.K U K0 (tile J i) P D' T'.top.clip (haloK J.L y) α μ 0 :=rfl;
    have hr := IV.blockPhase F₀ Vt hdT.glaciers.desk q; have hg:=gent F₀ M₀ L1 F' D' hk hdT hx.le ‹Jets.Touch.chip J.L y ≤1› hB q hq
    let g:= mud (F' w 1); let f:=mud (X 1); let M:=C q; have hO:g=M*f:=by unfold g; rw [hf,Pi.smul_apply]; exact map_smul (clay c N) _ _ -- rfl
    have hu:=Filter.Eventually.self_of_nhds (arm_m (u:=1) (P:=P) K0 E X U (tile J i) D' T'.top.clip hr (fan_pos ..) hg (he.trans (one_smul _ _).symm) zero_lt_one)
    have ha:0<f:= hu; have hm:0<M:= (by rw [show M=g/f from ((eq_div_iff _).2 hO.symm)]; exact div_pos hh ha; exact ha.ne')
    have hm' :(M.re:ℂ)=M:= Complex.ext rfl (Complex.lt_def.mp hm).2
    refine hA.confirm D' U (tile J i) E (haloK J.L y) M.re μ 0 α hr hg hv hz (Complex.lt_def.mp hm).1 _ ?_; change _= M.re • _; rw [hf,← he]; exact Eq.symm (congr_arg (· • X) hm')
omit hk hdT hT h0 hf
include hC hP hp ht hk

lemma assured_m (hL:1<J.L.val) (hi:i≤n)(hI:(g.path i).Bounds T'.top.clip a d Λ)(hQ:TicketW N (Pt i) (fan J.L τ.t (delay J n i x)) (Requests (N:=N) D0 ε J (delay J n i x)) a d Λ (2*hatG J n i x) r T'.top.clip Ω (passportM J.J J.order_cut) (towerQ J B n i k)): Massive.Stiffness.Window (Cove.light _ ∘ ShapeX B Y M₀.tip v i w) (V1 i) r:=by
    obtain ⟨P,T,X,H⟩:=ht.2 i hi; obtain ⟨-,hB,hX,hx,hS⟩:= hC.pos (delay J n i x) (matters ..); have hz:|V1 i|≤2*hatG J n i x:=by rw [abs_of_nonneg (zero_le_one.trans (hP.beta i hi))]; exact (hP.costs i hi).1.2
    refine member F₀ M₀ L1 (sY i) (g.path i) hk H (fun t=> rulesX F₀ M₀ B g L1 Y hP hp t hi _) ?_ ?_ (hP.clock i).ball hX hx hB hL ht.1 hQ hI hz; swap; -- cont
    · let A':= (towerQ J B n 0 k); let B:= ingredient A' M₀.tip; let G:= Kin.wind (Y i) 1; change Continuous fun t:ℝ=> G (exp (((v:ℂ)*(t:ℂ)) • B)); apply G.continuous.comp; exact NormedSpace.exp_continuous.comp (by fun_prop)
    rw [show sY i 0= Q1 i from ping B hj Y hp hi _ v]; obtain ⟨s,z,hz,hE,hH,hx⟩:= hP.leg i hi; have h:=window_real (u:=z) (L:=J.L) (passportM J.J J.order_cut) F₀ s (Q1 i) (E i) (tile J i) (g.path i) T'.top.clip hE hH hz; exact h.self_of_nhds
