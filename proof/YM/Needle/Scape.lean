    refine ⟨fun k X p h hp=>?_⟩; let PV:= P'; filter_upwards [eventually_ge_atTop (base t)] with j hj
    obtain ⟨ℓ,he,V,hv,hF⟩:= seedsW P₀ Tι ΣB E LL Θ Uv i0 ξ Fu νP Δ hTol Y hpG.ramp hpT sy M Ue hb W' hpG.mentor.1 hk t base P' (fun i j h=> (hpG.levels.1 i j).1 h) hpG.levels.2 (fun i=>hMκ _ _) (fun i=>hNκ _ _) k X p hp h j hj he
    refine ⟨ℓ,he,V,hv,?_⟩; filter_upwards [hF] with i hi; intro hm hR R x y b hb
    obtain ⟨hY,hV,hp⟩:= hi hm hR x y b hb; exact Massive.Needle.Gold.mono (Massive.Needle.coin hY ⟨_,hV⟩) hp -- ⚠ dot.L.
