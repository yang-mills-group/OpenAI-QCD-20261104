    obtain ⟨V,hx⟩:= GaugeP.gained (P:=Pnᴮ) (JX t) r μ hp (zero_le_one.trans h) (hY.mono (fun i hh=>by
          obtain ⟨g,h,hY,hh⟩:=hh; exact ⟨g,h,hY,fun x hx j v=>(hh x hx j v).trans (show (JX t).ε*3/4 ≤ (JX t).ε from (by linarith only [(JX t).light]))⟩)); exact ⟨V⟩
