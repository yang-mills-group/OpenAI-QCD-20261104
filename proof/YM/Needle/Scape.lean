lemma stakesR(t:ℕ): ∃ (K:Hub.Invest (Uv.display (Cθ) Θ sy P' base) t)(D:Massive.Needle.Rack K), D.κ=(fun i:ℕ=> Real.exp (((t:ℝ)/2+1/16)*Track.measure (Q.track eD PxPad) (Y.mark i))) ∧ D.w=(fun (i:ℕ)(q:Massive.UV.Label t)=>LifeT.FWealth P₀ (Q.track eD PxPad) Θ Uv t (ξ t) (x:=x) (Pt:=Pt) (Y.mark i) (P' t none i q))∧ Massive.Needle.Wealthy D:=by
     obtain ⟨K,h⟩:= fort P₀ E LL Θ Uv i0 ξ Fu Q Mg eD PxPad νP Δ S U msg W' Y sy M Ue α π hb hTol P' base d cost LX BK εL ε φ Ω Zv clock u m op w_ Nh hK hV hMκ hpT hk hN Fν hpG t -- order tune
     obtain ⟨B,hb,H⟩:=pilferG P₀ Tι ΣB E LL Θ Uv i0 ξ Fu νP Δ hTol Y hpG.ramp hpT sy M Ue hb W' hpG.mentor.1 t base P' (fun i j h=> (hpG.levels.1 i j).1 h) hpG.levels.2
     let w(i:ℕ)(q:Massive.UV.Label t):= (Λdᴮ t) (Y.mark i) (P' t none i q); let p(i:ℕ):= Real.exp (((t:ℝ)/2+1/16)*Track.measure (Q.track eD PxPad) (Y.mark i)); have he(i:ℕ)(z:ℂ)(x:Massive.UV.Label t): w i (z • x)=‖z‖*w i x:=by unfold w; rw [map_smul]; exact Stair.wealth_scale _ _
     have ht:∀ᶠ i in atTop,∀ x y : Massive.UV.Label t, w i (x-y) ≤ w i x+w i y:= Eventually.of_forall (fun i x y=>by
         rw[sub_eq_add_neg,← neg_one_smul ℂ y]; have ht:= he i (-1) y; rw [norm_neg,norm_one,one_mul] at ht; rw [←ht]; unfold w; rw [map_add]; exact Stair.wealth_plus ..)
     refine ⟨K,⟨w,p,fun i=>Real.exp_pos _,ht,he,⟨B,zero_le_one.trans hb,H.mono fun _ hi x=>hi none x⟩,h⟩,rfl,rfl,⟨?_⟩⟩ -- parse
     refine ⟨B,hb,H.mono fun i hi u x hx=>?_⟩; change (Λdᴮ t) (Y.mark i) (P' t none i ((P' t none i).symm (P' t u i x))) ≤ _; rw [LinearEquiv.apply_symm_apply]; exact hi u x hx
