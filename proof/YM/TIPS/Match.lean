    obtain ⟨z,w,H₁⟩:= aboveV P₀ A X B T Z V U W F hp hX hc E M₀ he Y hh C Ht O L1 hC Θ Uv i0 Gn ξ Ξ (Lx-L) Pz a Jp t γ (Xc+ω') Δφ hCw hAq hM₀ hP hPt hPk hTol hG hU hδ hqκ hp' hQP
    refine ⟨y,hym,hv,hy,L,hvL,hWV,hw,z,w,H₁,?_⟩; have hT:= examV P₀ A X B T Z V U W F hp hX hc E M₀ he Y hh C Ht O L1 hC Θ Uv i0 Gn ξ Ξ (hP.viewQ _ hU) (hPt m hU (hδ.trans hCw)) Pz Δφ (z m) (hδ.trans hCw) _ _ (H₁.poses m le_rfl hδ 0)
