    obtain ⟨Zp,wz,H⟩:= aboveV P₀ A X B T Z V U W F hp hX hc E M₀ he Y hh C Ht O L1 hC Θ Uv i0 Gn ξ Ξ Lx Pz a Jp t γ Xc Gν hCw hAq hM₀ hP hPt hPk hTol hTk hU hδ hx hW hF
    let y:= Zp m; let v:= Q' Jp y; have hpM:= hU.trans hδ; have hs:= H.poses m le_rfl hδ; have hy:Tally Θ 0 y ((Aim).density m) ((Gν) m 0):= examV P₀ A X B T Z V U W F hp hX hc E M₀ he Y hh C Ht O L1 hC Θ Uv i0 Gn ξ Ξ (hP.viewQ _ hU) (hPt m hU (hδ.trans hCw)) Pz Gν y (hδ.trans hCw) _ _ (hs 0); have hym : moored y.val Pz:= endowed _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ (hs 0) -- shorten
    have hv: moored (Q' Jp y).val Pz:= mooredMix Θ sym y Pz Zb (Aim) m hQ hym Jp
    let P:= Ps y; let Pc:= trolley (Aim) P Jp; let Δφ:= Gν-Pc; have hG :TideT (Aim) Jp nY Δφ:= tideDiff (Aim) Jp Gν Pc hTk (wingG (Aim) hAq Jp P hCw (fun a b=> Massive.Patria.Canvas.stylus ..)) -- order.canvas
    have hM :∃ Lt:Massive.UV.Label Gn,moored Lt.val Pz ∧∀ b:Cover,VK nY hCw b Lt (Ωℓ nY Lt) (Ωℓ nY Lt) Pz ((Φχ P) nY b):=by
         by_cases he': v=0
         · refine ⟨0,(by rw [← he']; exact hv),fun x=> ?_⟩
           have h: (Ωℓ nY 0)=0:=by unfold LifeT.egg LifeT.FWealth; rw [Stair.wealth_zero _ _ _ rfl,mul_zero] -- hp
           rw [h]; have hhx:Xc=Xc:=rfl
           have hZ:= endowedScale P₀ A X B T V U W hX E M₀ he Y C Ht O L1 hC Θ Uv i0 Gn ξ Ξ (hP.viewQ nY hpM) (hPt nY hpM hCw) (FPC P₀ A B Gν nY x) Lx Pz x Xc hCw (hF x) 0
           rw [norm_zero,zero_mul,zero_smul,zero_smul] at hZ
           unfold genial; have hx: trolley (Aim) P Jp nY x=0:=by
               have ht :P=0:= by funext x; change Zb ((qv).side R₂ n) x v=0; rw [he', map_zero]
               unfold trolley; rw [show visitor qv n nY Jp x P=0 from ?_,mul_zero,map_zero]
               unfold Depth.visitor; rw [ht,Rolls.roles]; -- lemma training
               let L:=Massive.Patria.Rolls.rolls (X:=Insertion ((qv).side R₂ n) 6) 1 (ratioTo qv n nY) (Rolls.menu Jp); have hL:=Rolls.training (k:=1) (M:=ratioTo qv n nY) (Rolls.menu Jp) (0:Cover → Insertion ((qv).side R₂ n) 6) 0; rw [add_zero] at hL; have hp:L 0=0:= (add_left_cancel (a:=L 0) (by rw [add_zero]; exact hL.symm)) -- check
               exact congr_fun hp (ratioTo qv n nY • x)
           rw [hx, show ⇑(0:Insertion ((qv).side R₂ nY) 6)= (0: Massive.Density _ 6) from rfl, transit_zeroT]; exact hZ
         have hΨ:= itinerant P₀ A X B T Z V U W F hp hX hc E M₀ he Y hh C Ht O L1 hC Θ Uv i0 Gn ξ Ξ hTol hPt (fun m h _=>hP.viewQ m h) (hpM.trans hCw) hM₀ (fun m h _=>hP.vac m h) hPk hYt
         let Bs:= being P₀ A X B T V U W E M₀ he Y C Ht O L1 hC Θ Uv i0 Gn ξ Ξ
         obtain ⟨Yv,hV,hY⟩:= abundance (Aim) Θ (fun b x=> Zb ((qv).side R₂ n) b x) Jp hAq Bs hΨ.journey v hv he' hCw hpM
         have hx(b):VK nY hCw b Yv (Ωℓ nY Yv) (Ωℓ nY Yv) Pz (FPC P₀ A B Pc nY b):= by obtain ⟨hi,h⟩:=hY b; exact h
         exact ⟨Yv,endowed _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ (hx 0),hx⟩
    obtain ⟨L,hvL,hw⟩:= hM
    let ω' := Ωℓ nY L; have hω: 0≤ ω':= mul_nonneg (zero_le_one.trans (stem_h ..)) (wealth_ge ..); let Yv:= Xc+ω'; have hqκ:0< Yv:= add_pos_of_pos_of_nonneg hx hω
    have hWV:Wt nY L ≤ω':= le_mul_of_one_le_left (wealth_ge ..) (stem_h ..)
    have hp':Wt nY (Lx-L) ≤ Xc+ω':= (costW_sub P₀ A Θ Uv Gn ξ Lx L).trans (add_le_add hW hWV)
    have hQP (b:Cover):VK nY hCw b (Lx-L) (Xc+ω') (Xc+ω') Pz (FPC P₀ A B Δφ nY b):=by
