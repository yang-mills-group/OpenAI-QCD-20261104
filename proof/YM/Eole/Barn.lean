   have hZ:1≤ vT:= hv.2.2.season.2
   obtain ⟨Vq,hV,hg⟩:= hG.cost
   let m' :=Keys cp 6; let δ':= D'.plant; let PP := Bloc.sparC m' q' D'
   obtain ⟨y,hY,hQ⟩:= Session.culling Θ Uv A₁ q' A₂ D' q₀ hq (DL hi) ht' _ _ qS _ _ _ _ _ _ _ hZ ξ.award hV hF hP hP1 hB rfl hW h0 hk hν htq he0 hα htB hΓ hΓp hz hu hD -- ht' notation? ht'=π₂ i
   refine ⟨y,hY,fun U=> (PP) (MassiveQCD.Cupola.scaler m' α (Vq U)),hQ,?_ , fun l s' hi' he=>?_⟩
   · have hp':(∅:Finset I)∈ Dg:= hz _ hx0 _ (empty_subset _)
     funext Wv; have hv(Q:Patio (Keys cp 6⊕Spine I)) := (Bloc.amounts m' D' q' α Q [] (by simp)); have hφ(Ux:Grid cp):Summable fun j=> ‖((DL hi).EvalK ht').warp j Ux‖:= fogsI P₀ A X B T V U W hX E M₀ he Y C Ht O L1 hC hi hZ Ux -- name conflict
     have hl:=PayLayer.vacuumR Θ Uv A₁ q' U₀ (DL hi) ht' (Bn i) (Sn i) p W₀ Vq Dg (PayRes.remits _ _ _ _ _ _ _ _ _ _ _ _ _ hV (zero_lt_one.trans_le hZ)) hZ rfl (show 1 ≤ FH sⁱ from Real.one_le_exp (mul_nonneg zero_le_one (fan_pos ..).le)) hφ ξ.award hP1 _ hp' Wv
     change pluck m' ∅ _= _; have he':= hv (Vq Wv); rw [show D'.plant ([].toFinset)=∅ from by simp[Bloc.plant],show Gain.uvBirth α ∅= 1 from prod_empty,one_smul,show D'.twins []= [] from rfl, emptyN (Keys cp 6) (D'.flag q'), emptyN (Keys cp 6) q'] at he' -- order
     exact he'.trans hl -- hl type Pn
   let l':=List.ofFn s'; let u:= D'.twins l'; have hu:hq=hq:=rfl; have h:l'.Nodup:=List.nodup_ofFn_ofInjective hi'; have hqX:=D'.tightened _ h; have hxX : Quills.crest u.get = D'.plant (Quills.crest s'):= by rw[← Eole.decal]; unfold u; rw [D'.stowed]; apply congr_arg; ext; simp [l',Quills.crest]
   let g:=G _ u.get; rw [show scarf D' α _ G l s'= Gain.uvBirth α (D'.plant (Quills.crest s')) • g from rfl]; unfold g
   rw [hg _ u.get (List.nodup_iff_injective_get.mp hqX) (hxX.symm ▸ hz _ he _ (Subset.refl _))]; rw [smul_comm]; apply congr_arg; funext Xv
   rw [← Massive.Lyre.verses q₀ s']; change _= numbered q₀ m' l'.get _; have he :D'.plant (Quills.crest s')=D'.plant l'.toFinset:=hxX.symm.trans ((YM.MassiveQCD.Sample.Eole.decal _).symm.trans (D'.stowed l')) -- edit
