        change Gold _ _ _ (α • WB) _; rw[hx,smul_zero]; exact Gold.mono Gold.nil hδ
      let C':=Real.exp (FieryQ.capsB P₀ E L1 (Ht.cost j) (O.Y j) Cq (A.node j)); let KP:=KtQ*Pτ
      have hPay:=trellis P₀ A X B T Z V U W F hp hX hc E M₀ he Y hh C Ht O L1 hC Θ Uv i0 Gn ξ Ξ hAim Zα Uν Fi Ue t sym Qα L Cq z j₀ n₀ a b ℓ M Cap f1 hΦ h0 u p0 xv zh hj hk txT hmR Qz Mn At TΞ wΦ θE H0 Mw M₁ M₂ hSt hEm hIc hU ht hi hg y hs.ink hy hz hP₁
