lemma budding (hP:30*(ξ.r+1) ≤ (A.ring (B.n k) n).val)(hF: Works.Pours Lℓ Uv ξ.r Gn M θ D νD)(hQ:∀ i j,i∈Dg→j⊆i→j∈Dg)(hf:Fires (wrap (A.ring (B.n k) n) ∘ A₁) M)(hB:∀ i∈ Dg, Spaced (wrap (A.ring (B.n k) n)∘ A₁) i (Pt n).B)(hw:∀ i,wealth (p i).val (up (Pt n)).threshold Xτ ≤ D) : Wz n le_rfl A₁ q' p (fun _=>0) Dg (spikes Uv Gn p A₁ (A.ring (B.n k) n) (Un n)):=by
     let φ:= π₂ n; let v := βT; let f := A.ring (B.n k) n; let Ux:= C.Λ n (Nat.zero_le _) le_rfl; have ht:‖w‖≤1:=by obtain ⟨h1,h2⟩:= hC.weight; rw [Real.norm_of_nonneg (by linarith)]; exact h2
     have heq:φ= (φ.re:ℂ):=by unfold φ voyage; rw [Melt.classicR,← Complex.ofReal_inv,← Complex.ofReal_mul]; rw [Complex.ofReal_re]
     have hq:|φ.re|<1:=by have hg:‖φ‖<1:= indoors P₀ A X E he w ht _; rw [heq, Complex.norm_real,Real.norm_eq_abs] at hg; exact hg
     obtain ⟨t,hI,Ft,hW,hT⟩:= hYt.shines.dawn _ hq; let W':= Ux.EvalK φ; have htV: Correspond Ft W':=by unfold W'; rw [heq]; exact hT
     have hx':=waking P₀ A (hX n); let K':= (Bn n); let G V:=heartS (Ux.EvalE φ) (Pt n).threshold K' (Sn n) V; let A0:= Pavilion.rainScan q' A₁ Uv p hx (v.threshold) W' G
     refine ⟨A0,Pavilion.dewed q' A₁ Θ Uv p hx ξ.m ξ.s ξ.r (up (Pt n)) ξ.award hP Ft Dg hQ Lℓ νD hW M hf Ux φ K' (Sn n) D htV hF hx'.ball hx'.baseG hw hB rfl,fun l f h hp=>?_⟩
     rw [(montera P₀ A X B T V U W E M₀ he Y C Ht O L1 hC n le_rfl).2.1]; funext Rv; rw [Pi.smul_apply, Function.comp_apply,show _= _ from (show numbered q' (Keys _ 6) f (A0 Rv)= _ from Pavilion.shootT q' A₁ Uv p hx (v.threshold) W' G f h Rv)] -- name `Ωᴮ` captures V grid let V.Co.?
     change ((Ωᴮ n le_rfl) • (Cove.light _ (exp (G Rv)*Kites.heartK W' v.threshold Rv))) * _= _; rw [smul_mul_assoc]
