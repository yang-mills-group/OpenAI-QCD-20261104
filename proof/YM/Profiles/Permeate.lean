lemma peers (htV:∀ j,Real.exp ((1/8:ℝ)*81)*ξ.b * wealth (p j).val (O₂).threshold vT + W₀ j≤Ψ)(hp1:Fires (wrap cp ∘ A₁) M)(sF: Fin m→I)(hF: Injective sF)(hK: MassiveQCD.Sample.Quills.crest sF∈Dg): ‖joint (G m sF) / joint (Un i)‖ ≤ Real.exp ( (Fintype.card (Site cp):ℝ)*(EP+Aₚ)) :=by
    obtain ⟨ha,ht,-⟩:= (senior P₀ A X B T V U W E M₀ he Y C Ht O L1 hC hi).choose_spec; have hvt : joint (Un i)=Fv:=rfl; let v' := Fv; have hx': (0:ℂ)<v':=ht; obtain ⟨hh,hψ⟩:= Complex.lt_def.mp hx'; have hXt:v'.re>0:=hh; have hU:v'= (v'.re:ℂ):=Complex.ext (by simp) hψ.symm; have hr:‖Fv‖=v'.re:=(congr_arg Norm.norm hU).trans (normS _ hXt.le)
    let Up:= Globe.expo Sₓ cp; let μ(v:Grid cp):= Grass.ber _ ((G m sF) v); have hz(v: Grid cp): ‖μ v‖ ≤ v'.re*Up:=(Grass.price _).trans (gira P₀ A X B T Z V U W F hp hX hc E M₀ he Y C Ht O L1 hC Θ Uv i0 Gn ξ Ξ hv hP1 q' p A₁ Dg W₀ G Cq hw M Ψ h₀ hi hD htV hp1 _ hF hK v) -- shadow
    rw [norm_div,hvt,hr]; let μ':= prior su cp; haveI : IsProbabilityMeasure μ':= by unfold μ'; infer_instance
    have hf : ‖joint (G m sF)‖ ≤ v'.re* Up:=by
       change ‖∫ y:Grid cp,μ y ∂μ'‖ ≤ _; simpa using norm_integral_le_of_norm_le_const (ae_of_all μ' hz)
    refine (div_le_iff₀ hXt).mpr (hf.trans (?_)); rw [show Real.exp _= Up from ?_]; rw [mul_comm]; unfold Up Globe.expo; rw [neg_mul_neg]
