lemma ripe (hc:0 <UC)(hk:0 < UPC)(hY:pT ≤2*Πr * KVe) (hC: Fs*(Ωξ*KD)≤1)(hK: Ωv ≤ D⁰*UPC): (1+ξ.b*ξ.a)*(φy/φμ*((eμ* toted Fs (glad P₀ A Θ Uv Gn ξ x Pt (i+1) Lx) O₁ vT₁ + ((Fs ^(Gn+1)*Ωξ)*(κℓ (A.node (i+1))*UPC) + Ωv)))) ≤ κℓ (A.node i)*UC:=by
     let A0:= Tt (i+1) S'; let P':= toted Fs S' O₁ vT₁; have hf0 : A0= UPC:= gusto P₀ A Θ Uv Gn ξ Lx htL hk -- uses T variables.Domo
     have hf:0<Fs:= Kit.slope_pos _; have hXp:1 ≤Ωξ:=Ξ.funds _; let s:= Fs; have ht:s≤1:=(inv_le_one₀ (Real.sqrt_pos.mpr (by positivity : 0 < ((A.spacing i).val:ℝ)))).2 (Real.sqrt_one ▸ Real.sqrt_le_sqrt (show (1:ℝ)≤(A.spacing i).val from Nat.one_le_cast.mpr (A.spacing i).property))
     have hm : D⁰*UPC ≤ P' :=by rw [←hf0]; unfold A0 FWealth; rw [(footing (i:=i) (x:=x) P₀ A).2]; exact Stair.lowerS S' hf.le ht
     have hB: s*(Ωξ* (EP (i+1)))≤ 1:=by
         apply le_trans _ hC; refine mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left (next_pay Θ Uv i0 Gn P₀ (A.node i) ξ Ξ _ rfl) (zero_le_one.trans hXp)) hf.le -- match `s`
     have hh: s^(Gn+1)*Ωξ*((EP (i+1))*UPC) ≤ s^Gn * UPC:=by
         rw [show _=_ from (show s^(Gn+1)*Ωξ*((EP (i+1))*UPC) = s*(Ωξ*(EP (i+1)))*(s^Gn *UPC) by rw [pow_succ]; ring)] -- binder EP nonparent.C.
         exact mul_le_of_le_one_left (by positivity) hB
     have hν: 0 < 1+ξ.b*ξ.a:= by have ht:=ξ.award.light; have he:=ξ.award.funds; positivity
     have h:P' = φμ*pT:= (toted_g ..).trans (by rw [normS φμ (lure P₀ A Θ Uv Gn ξ Lx htL hk|>.le)]) -- explicit output
     have hp:0< φy:=lure P₀ A Θ Uv Gn ξ y hty hc; have hψ:0< φμ:= lure P₀ A Θ Uv Gn ξ Lx htL hk; have hy:0<KVe:=health P₀ A Θ Uv Gn ξ y hty; have hu : (eμ* toted Fs (glad P₀ A Θ Uv Gn ξ x Pt (i+1) Lx) O₁ vT₁ + ((Fs ^(Gn+1)*Ωξ)*(κℓ (A.node (i+1))*UPC) + Ωv)) ≤ (eμ+2)*P':=by rw [add_mul]; change eμ*P'+ _ ≤ eμ*P'+_; linarith only [hh,hK,hm]
     let c:=1+ξ.b*ξ.a; let k:=eμ+2; let u:=2*Πr; have ht :0 ≤k:=by have h:=guardT Θ Uv i0 Gn P₀ (A.node i) ξ Ξ; change 0 ≤ eμ+2; change 0< eμ at h; linarith only [h] -- defeq.Nonwrapper
     calc
       (1+ξ.b*ξ.a)*(φy/φμ*((eμ* toted Fs (glad P₀ A Θ Uv Gn ξ x Pt (i+1) Lx) O₁ vT₁ + ((Fs ^(Gn+1)*Ωξ)*(κℓ (A.node (i+1))*UPC) + Ωv)))) ≤ c*(φy/φμ*(k*P')):=mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hu (div_nonneg hp.le hψ.le)) hν.le
       _ = c*k*φy*pT:= by rw [h]; field_simp
       _ ≤ c*k*φy*(u*KVe):= mul_le_mul_of_nonneg_left hY (show 0≤ c*k*φy from by positivity)
       _ = _:= by change c*k*(UC/ KVe)*(u*KVe)= u*(c*k)*UC; field_simp
