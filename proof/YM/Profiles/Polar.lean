lemma podium (hc:0 <UC)(hk:0 < UPC)(hS: UC ≤4*UPC)(hY:pT ≤2*Πr * KVe) : νL i y /νL (i+1) Lx ≤ C_P:=by
   have hwᵢ:= (footing (i:=i) P₀ A (x:=x)).2; let g:= FWealth P₀ A Θ Uv Gn ξ (Pt:=Pt) (x:=x); let μ:= g (i+1) Lx; let p:= pT; let f:= Fs; let a:=2*Πr
   have he:0<f:= Kit.slope_pos _; have ht:f≤1:=(inv_le_one₀ (Real.sqrt_pos.mpr (by positivity : 0<((A.spacing i).val:ℝ)))).2 (Real.sqrt_one ▸ Real.sqrt_le_sqrt (show (1:ℝ)≤(A.spacing i).val from Nat.one_le_cast.mpr (A.spacing i).property))
   have hφ:f^Gn*μ ≤ p:= by unfold μ g FWealth; rw [hwᵢ]; exact Stair.lowerS Lx he.le ht
   have hy:0 < KVe := health P₀ A Θ Uv Gn ξ y hty; have hX:0 < μ:=health P₀ A Θ Uv Gn ξ Lx htL;
   apply (div_le_iff₀ (div_pos hk hX)).mpr; apply (div_le_iff₀ hy).mpr; let W:=Tt i y; let g:= UPC; let F':= UC
   change F'≤4*a/f^Gn * (g/μ)*W; have hF:0< f^Gn:=pow_pos he _; rw [show 4*a/f^Gn*(g/μ)*W=(4*g)*(a*W)/(f^Gn*μ) from (by field_simp)]
   exact hS.trans ((le_div_iff₀ (mul_pos hF hX)).2 (mul_le_mul_of_nonneg_left (hφ.trans hY) (by positivity)))
