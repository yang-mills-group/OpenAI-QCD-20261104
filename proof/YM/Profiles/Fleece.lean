     have htC:= astound (Pt:=Pt) P₀ A Θ Uv i0 Gn ξ Ξ p r g y hz hΦx hΦy Q hEnt hg1 hg2 hY; obtain ⟨hq,hκ,hBq,H⟩:=hz; let f:=Vp₁; let v':=Vp₀; let u':=Talent.boosted g f v'; let d0 := C_P; have hu : 0< UC:= H.warm; have hvf:0< UPC:=(footing P₀ A|>.1).symm ▸ H.high; let pμ (j:J₀):=νL (i+1) (Q j)
