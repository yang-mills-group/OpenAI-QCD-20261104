lemma weldS (hi:i≤n)(P : Density cp 6): ℒ i P = Massive.Lyre.sig (Aim) i (transit (RH i).symm P):=by
    unfold Massive.Lyre.sig; rw[exact_cov _ _ _ _ _ Z _ _ _ F hp hX hc _ hh _ _ _ _ hi,transit_equal,transit_equal]
omit hp hh hX hc
