lemma improv (u:ℂ)(P:Density cp 6) : leaseP P₀ A B M₀ Y i (u • P) (s:=s) (w:=w)= u *ℒ i P:=by unfold leaseP; rw[Massive.Lyre.stampB,mul_div_assoc]
lemma alter {c f:Side}(h:c=f)(Y:Density c 6): Stays Y ↔ Stays (transit h Y):=by subst c; rfl
lemma connect {c f:Side}(h:c=f)(Y:Density c 6) : transit h.symm (transit h Y)=Y:=by subst c; rfl
include ha
lemma paintsK (hi:i<n)(P:Density fp 6)(hp0:Tide.Stays P) : Tide.Stays ((Tx i) P):=by
   apply Tide.stays; exact Massive.Lyre.won (A.flight i) d'T ((ladder P₀ A).admissible i) hp0 -- syntax
include hp hh hX hc
lemma sunrays (hi:i<n)(P:Density fp 6)(hp0:Stays P): ℒ i ((Tx i) P)= ℒ (i+1) P:=by
    let Qp:= transit (RH (i+1)).symm P
    rw [weldS _ _ _ _ _ Z _ _ _ _ hp hX hc M₀ Y hh hi.le,weldS _ _ _ _ _ Z _ _ _ _ hp hX hc M₀ Y hh hi]
    rw [show transit (RH i).symm ((Tx i) P)=(Aim).block i Qp from transit_shift ..]
    exact Massive.Lyre.escalated (Aim) ha _ hi ((alter _ _).1 hp0)
-- transfer from actual.W Clock.Q β weight.No assumptions normalization branch.Actor.
lemma wonIt (hj:j ≤ m)(hv:m≤ n)(P: Density (A.ring (B.n k) m) 6)(hp0:Stays P): Stays (LeaseV.voyageW P₀ A B V W P hj) ∧ ℒ j (Hx P hj)=ℒ m P:=by
    induction hj using Nat.decreasingInduction with
    | self=> rw [show Hx P (le_refl m)=P from Nat.decreasingInduction_self (motive:=fun i _=> Massive.Density (A.ring (B.n k) i) 6) (fun i _ D=>(Tx i) D) P]; exact ⟨hp0,rfl⟩
    | of_succ i h ih=>
        rw [show Hx P h.le=(Tx i) (Hx P h) from Nat.decreasingInduction_succ_left (motive:=fun i _=> Massive.Density (A.ring (B.n k) i) 6) (fun i _ D=> (Tx i) D) P h h.le]; exact ⟨paintsK _ _ _ _ _ _ M₀ ha (h.trans_le hv) _ ih.1,(sunrays P₀ A X B T Z V U W F hp hX hc M₀ Y hh ha (h.trans_le hv) _ ih.1).trans ih.2⟩ -- argument leading?
