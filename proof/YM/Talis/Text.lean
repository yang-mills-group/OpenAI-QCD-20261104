lemma century(f : Fin m→Iq)(h:Injective f): let F':= interP (RH j).symm (LeaseV.getLamp P₀ A X B T V U W E M₀ Y C w j (hi.trans hm) Q₀.R Q₀.K'); let YQ:= numbered q' (Keys (cx j) 6) f ∘ F'; Stays YQ ∧ Vp j (hi.trans hm)* Massive.Lyre.sig Aim j YQ = give r' (MassiveQCD.Sample.Quills.crest f) * Massive.Lyre.sig Aim i ((covering (n:=n) (k:=k) P₀ A B V U W M₀.tip s w).density i * (List.ofFn fun k=>transit (rungs P₀ A _ _).symm (Yv (f k))).prod) :=by
   intro Xp Qv; let s':=MassiveQCD.Sample.Quills.crest f; let v:=give (gV wr j i) s'; let t:=Vp j (hi.trans hm); let XYZ:= (List.ofFn fun k=>Yv (f k)).prod
   have hp0 :(Aim).density i=transit (RH i).symm (Un i):=exact_cov P₀ A X B T Z V U W F hp hX hc Y hh i M₀.tip s w hm -- X shadow!
   let Qp:= numbered q' _ f ∘ Ep!
   have ht:Stays (Un i):= (alter (RH i).symm _).mpr (hp0 ▸ stays (Massive.Lyre.scriptures _ ha hm))
   have hY': Stays XYZ:= flockZ _ f (fun k _=> hx k)
   let V':=give r0 s' • (Un i*XYZ); have hP':=wonIt P₀ A X B T Z V U W F hp hX hc M₀ Y hh ha hi hm V' (Massive.Lyre.stockC _ _ (ht.mult hY'))
   have h₀: Ω i hm P'.R P'.K' f=V':= h₀ m f h
   have hB := hBp m f; rw [h₀] at hB; change t • Qp=v • Hx V' hi at hB; have hΓ:Tide.Stays (t • Qp):= hB.symm ▸ Massive.Lyre.stockC _ _ hP'.1
   rw [show Qv=transit (RH j).symm Qp from (interB ..)]
   have hδ:t≠0:= (montera P₀ A X B T V U W E M₀ he Y C Ht O L1 hC j (hi.trans hm)).1
   refine ⟨(alter _ _).1 (show Tide.Stays Qp from ?_),?_⟩; · rw [←inv_smul_smul₀ hδ Qp]; exact Massive.Lyre.stockC _ _ hΓ
   have hv: give r' s'=v*give r0 s':=by simp [s',v,give,Finset.prod_mul_distrib] -- names
   have hp1:(Aim).density i * (List.ofFn fun k=>transit (rungs P₀ A _ _).symm (Yv (f k))).prod=transit (rungs P₀ A (B.n k) i).symm (Un i * XYZ):=by rw [hp0]; unfold XYZ; rw[boomP]; -- xyz unfold?
   rw [hp1,← weldS _ _ _ _ _ Z _ _ _ F hp hX hc M₀ Y hh hm, ← weldS _ _ _ _ _ Z _ _ _ F hp hX hc M₀ Y hh (hi.trans hm), ← improv P₀ A B M₀ Y, hB,improv _ _ _ _ _,hP'.2,show ℒ i V'= _ from improv P₀ A B M₀ Y (give r0 s') (Un i * XYZ)]
   change v*(give r0 s'*_) = give r' s' *_; rw [hv,mul_assoc]
