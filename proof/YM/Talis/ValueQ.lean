noncomputable def capsB (a b C:ℝ)(h:ChangeQ):ℝ:= manaV L1 (twist (P:=P) h) a b C (1+(outK (E.D h) (E.eps h)+1))+1
lemma bloomsΩ (hg: logsP (A.spacing i) (clockQ P₀ A x i) ≤ Fintype.card (Site cp)) (hP:budgetV qS sⁱ ≤1) : (Ps Cq)+logsP (A.spacing i) (clockQ P₀ A x i) ≤ Fintype.card (Site cp)*capsB P₀ E L1 (Ht.cost i) (O.Y i) Cq (A.node i):=by
      let k:= logsP (A.spacing i) (clockQ P₀ A x i)
      conv_rhs => rw [capsB,mul_add,mul_one]
      apply add_le_add _ hg; apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _); unfold fuelG manaV
      have h0: (taxK qS sⁱ (1/64))⁻¹ ≤ 1:= inv_le_one_of_one_le₀ (Real.one_le_exp (mul_nonneg (by norm_num:(0:ℝ)≤1/64) (fan_pos ..).le))
      have hx : tollG P₀ A E i Cq (x:=x) ≤ 1+(outK (E.D (A.node i)) (E.eps (A.node i))+1):= add_le_add hP (add_le_add_right h0 _)
      linarith only [hx]
