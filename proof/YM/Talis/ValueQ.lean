lemma wallets (hi:i ≤ j)(hj : j≤ n)(hx:1<(cp).val)(b:ℕ)(P_Y:LeaseV.YawQ P₀ A B q' (o j) (x:=x) (Pt:=Pt))(hTol:2*tol+tol^2≤1/2)
   (hF:∀ l,i ≤ l→ l < j→ Fires (o l) b ∧ (o l)=((stepper P₀ A X B T l).visit K (A.next (B.n k) l)).ratio.parent ∘ o (l+1) ∧ ShelfY (A.spacing l) θ (clockQ P₀ A x l) b)
   (hW:∀ l, i ≤ l → l ≤ j → 1 ≤ fan (A.spacing l) θ (clockQ P₀ A x l))
   (f: Fin m→ Iq)(hf:Injective f) (hpℓ : Stays (LeaseV.titlesV P₀ A X B T V U W E M₀ he Y C Ht O L1 hC q' j hj P_Y.R P_Y.K' f)) : ‖give (gV WU i j) (MassiveQCD.Sample.Quills.crest f)‖* ‖leaseP P₀ A B M₀ Y j (LeaseV.titlesV P₀ A X B T V U W E M₀ he Y C Ht O L1 hC q' j hj P_Y.R P_Y.K' f) (w:=w) (s:=s)‖≤ Real.exp ((Fintype.card (Site cp):ℝ)*fuelG P₀ A X E Ht O L1 i Cq+logsP (A.spacing i) (clockQ P₀ A x i)):=by
        obtain ⟨Q,hQ⟩:= LeaseV.routingV P₀ A X B T Z V U W F hp hX E M₀ he Y hh C Ht O L1 hC b o q' hDY hTol i j hj Set.univ hi P_Y hF hW
        have hx':=wagesP P₀ A X B T Z V U W F hp hX hc E M₀ he Y C Ht O L1 hC o q' Cq hV Q (hi.trans hj) hx f hf (hW _ le_rfl hi)
        rw [hQ m f (by exact Set.subset_univ _), improv P₀ A B M₀ Y, (wonIt P₀ A X B T Z V U W F hp hX hc M₀ Y hh ha hi hj _ hpℓ).2,norm_mul] at hx'; exact hx'
