lemma mantle (hV:(Uv.display (Y.series P₀ A X E LL ν) Θ sym PV base).System) : Nonempty (Hub.Invest ZP d):=by
    choose YZ h₁ h₂ using fun W:Venus d=> pumps P₀ A X E LL Θ Uv i0 ξ Fu ν Δ hθ Y hp hτ sym M N₀ K0 W' hm hM hN hK Gℓ π hVec d Zr hPil hGℓ hF base PV hL hOrder W
    obtain ⟨D₁,hD,hΨ⟩ := pigments P₀ A X E LL Θ Uv i0 ξ Fu ν Δ hθ Y hp hτ sym M N₀ K0 W' hm d base PV hL hOrder -- signature
    let L:= Y.mark; let D:= Zr.K *(Zr.J * D₁); have hK:1≤ D:=one_le_mul_of_one_le_of_one_le Zr.help (one_le_mul_of_one_le_of_one_le Zr.up hD); let K : Venus d→ℕ→ℕ→ℝ:=fun W j i=> αq (cK (j+1)) (L i) ((Zr.T₁ W).D)
    let v i :ℝ:= uθ (L i); have hg : ∀ᶠ i:ℕ in atTop,∀ p:Venus d→ ℂ, ‖p‖ ≤ Zr.K * ‖(At (L i)) (PV d none i (∑ k,p k • YZ k i))‖:=by
          filter_upwards [eventually_all.mpr h₁] with i h p; rw [map_sum,map_sum]; simp_rw [map_smul]; exact Zr.high _ (fun k=> (h k).2) p
    have hP : ∀ᶠ i:ℕ in atTop,LinearIndependent ℂ (fun k:Venus d=> YZ k i):= hg.mono fun i h=> Fintype.linearIndependent_iff.mpr (fun p hp k=>by specialize h p; rw [hp,map_zero,map_zero,norm_zero,mul_zero] at h; rw [norm_le_zero_iff.mp h]; rfl)
    refine ⟨fun i k=> YZ k i,fun i=>D*v i,K,(fun i=> mul_nonneg (zero_le_one.trans hK) (Real.exp_nonneg _)),?_,hP,?_⟩
    · filter_upwards [hg,hΨ] with i hi hh u hu; let p:= ∑ j,u j • YZ j i;
      apply (hi u).trans; apply le_trans (mul_le_mul_of_nonneg_left (Zr.tall (PV d none i p) (Fg (L i)).threshold (LifeT.νP P₀ A (x:=x) (L i))) (zero_le_one.trans Zr.help)); unfold D v; rw [mul_assoc, mul_assoc]; exact mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left (hh p hu) (zero_le_one.trans Zr.up)) (zero_le_one.trans Zr.help)
    intro W; filter_upwards [eventually_ge_atTop (base d)] with j h
    let z:= cK (j+1); have hs:= sneaks P₀ A X E LL Θ Uv i0 ξ Fu ν Δ Y hp M N₀ Gℓ π hVec d Zr base hL W z
    constructor
    · have hz := hs.const_mul D; rw [mul_zero] at hz; exact hz.congr (fun i=> (mul_assoc D (v i) (K W j i)).symm)
    have hNN(i:ℕ): 0≤ K W j i:= by
          have ht:= (Zr.T₁ W).day; let Z:= (Gℓ d (A.node (L i))); have hZ:1 ≤ Z := (hPil d (A.node (L i))).tall
          exact mul_nonneg (mul_nonneg (inv_pos.mpr (hm.force z).cave.shape.1).le (mul_nonneg (Real.exp_nonneg _) (mul_nonneg (show 0≤1+2*Z from by linarith only [hZ]) (zero_le_one.trans ht)))) (Real.exp_nonneg _)
    filter_upwards [h₁ W,h₂ W (j+1) (by omega) z rfl,hP, Hub.expanse (C:=Cq) Θ Uv sym base PV hV hp.ship.β_path j d] with i h hi hx ht; have h':YZ W i≠0:= hx.ne_zero W; exact ⟨ht _ _ h.1 h' _ (hNN _) (hi h'), hNN _⟩
