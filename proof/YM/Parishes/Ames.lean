        have hε:0< Fs:= Kit.slope_pos _; have hβ: Fs ≤1:=(inv_le_one₀ (Real.sqrt_pos.mpr (by positivity : 0 < ((A.spacing i).val:ℝ)))).2 (Real.sqrt_one ▸ Real.sqrt_le_sqrt (show (1:ℝ)≤(A.spacing i).val from Nat.one_le_cast.mpr (A.spacing i).property)); have hwG:0< vT:= fan_pos ..
