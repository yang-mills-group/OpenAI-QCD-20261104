private lemma monoTE {A V: Type}[Fintype A][Fintype V]: (∀ i j:A, (Tone.monoT A V).P i j ≠0→j=i) ∧ (∀ i j:V,(Tone.monoT A V).M i j≠0→j=i):= ⟨fun i j h=> Eq.symm (by_contra (fun hz=>h (Matrix.one_apply_ne hz))), fun i j h=> Eq.symm (by_contra (fun hz=>h (Matrix.one_apply_ne hz)))⟩
private lemma unitReachV : ReachV P₀ A B o lℓ Pt (j:=j) (m:=j) (Tone.monoT (Kh (A.ring (B.n k) j)) (Dh (A.ring (B.n k) j) 6 Iq)):=by
    constructor
    · intro i p q h hp; rw [monoTE.1 _ _ hp]; exact h
    intro i p q h hp; rw [monoTE.2 _ _ hp]; exact h
lemma jumpP (Z: Finset Iq)(hk:j ≤ m): give (gainV wr j (m+1)) Z= give (gainV wr j m) Z * give (wr m) Z:=by
     have h i:gainV wr j (m+1) i=gainV wr j m i*wr m i:= by
           have h:Finset.Ico j (m+1)=insert m (Finset.Ico j m):=by ext; simp; omega
           unfold gainV; rw [h,Finset.prod_insert (by simp),mul_comm]
     unfold give; simp_rw [h]; push_cast; rw [Finset.prod_mul_distrib]
