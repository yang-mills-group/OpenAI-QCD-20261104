lemma marches {j0:ℕ}(hs:1 ≤ s)(hr:0 ≤ r) (hj:j ≤ m)(hn:m ≤n)
     (hJ:∀ i,j ≤ i → i ≤ m →A.level i=j0) (hD:∀ i,j≤ i →i < m → (stepper P₀ A X B T i).patch=Q)
     (hp:∀ i:ℕ,∀ (h:j ≤ i) (h':i < m), epochV P₀ A X B T (h'.trans_le hn) (G0 (i+1) (le_trans h (Nat.le_succ i)) h') (wr i)=G0 i h h'.le)
     (hF: ∀ i,j ≤ i →∀ h:i < m,(Po i (h.trans_le hn)).Rich s ∧ (Pv i (h.trans_le hn)).Rich s∧ (Po i (h.trans_le hn)).Gale (Pv i (h.trans_le hn)) r ∧ ReachV P₀ A B o lℓ Pt (Pv i (h.trans_le hn)) ) (hK:j < m): -- notice h0 unnecessary
     ∃ R S : Tone (Kh (A.ring (B.n k) m)) (Dh (A.ring (B.n k) m) 6 Iq) (Kh (A.ring (B.n k) j)) (Dh (A.ring (B.n k) j) 6 Iq),∃ g:Ratio (A.ring (B.n k) j) (A.ring (B.n k) m), Canon Q.J (rank j0) (T.W.state m).bed (T.W.state j).bed (tuneP P₀ A X B T m (hJ m hj le_rfl)) (tuneP P₀ A X B T j (hJ j le_rfl hj)) R g ∧ R.Rich (Tone.amount s^(m-j)) ∧S.Rich (Tone.amount s^(m-j)) ∧ R.Gale S (r*Tone.amount s^(m-j)) ∧ ReachV P₀ A B o lℓ Pt S ∧ G0 j le_rfl hj=Tuck.tilt S (gainV wr j m) (G0 m hj le_rfl):=by
     have hpX (i:ℕ)(hi:i < m)(hk:j ≤ i): G0 i hk hi.le=Tuck.tilt (Pv i (hi.trans_le hn)) (wr i) (G0 (i+1) (le_trans hk (Nat.le_succ _)) hi):= Eq.symm (hp i hk hi)
     let m1(kv:ℕ)(hi:kv ≤ m):Prop := ∀ h:j ≤ kv, ∃ R S : Tone (Kh (A.ring (B.n k) kv)) (Dh (A.ring (B.n k) kv) 6 Iq) (Kh (A.ring (B.n k) j)) (Dh (A.ring (B.n k) j) 6 Iq),∃ g:Ratio (A.ring (B.n k) j) (A.ring (B.n k) kv), Canon Q.J (rank j0) (T.W.state kv).bed (T.W.state j).bed (tuneP P₀ A X B T kv (hJ kv h hi)) (tuneP P₀ A X B T j (hJ j le_rfl hj)) R g ∧ R.Rich (Tone.amount s^(kv-j)) ∧ S.Rich (Tone.amount s^(kv-j)) ∧ R.Gale S (r*Tone.amount s^(kv-j)) ∧ ReachV P₀ A B o lℓ Pt S ∧ ∀ Z, Chamber.parties (G0 j le_rfl hj) Z= give (gainV wr j kv) Z • S.read (Chamber.parties (G0 kv h hi) Z)
     have ht kv (hi:kv ≤ m) (hk:j ≤ kv):m1 kv hi:=by
        induction kv, hk using Nat.le_induction with
        | base=>
           let P:=Tone.monoT (Kh (Pc j)) (Dh (Pc j) 6 Iq)
           have he:Tone.amount s^(j-j)=1:=by simp only [tsub_self,pow_zero]
           have hx: P.Rich (Tone.amount s^(j-j)):= Tone.richMono he.symm.le
           intro h
           refine ⟨P,P,YM.Bank.idle _,Canon.unit,hx,hx,Tone.calmGale (show 0≤r*Tone.amount s^(j-j) from (he ▸ by simpa)),unitReachV P₀ A B o lℓ Pt,fun Z=>?_⟩
           unfold P; rw [Tone.monoid]; simp [give,gainV]
        | succ kv hk ih=>
           let ip:= (show kv < n from lt_of_lt_of_le hi hn)
           obtain ⟨R,S,G,hc,ht,hS,hG,hE,hY⟩:= ih (Nat.le_of_succ_le hi) hk
           have hU:= roteP (k:=k) (Iq:=Iq) P₀ A X B T Q ip (hJ kv hk (Nat.le_of_succ_le hi)) (hJ (kv+1) (Nat.le_succ_of_le hk) hi) (hD kv hk hi)
           obtain ⟨ha,hx,hq,hw⟩:= hF kv hk hi
           have hT:Tone.amount s^(kv+1-j)=Tone.amount s *Tone.amount s^(kv-j):=by rw [show kv+1-j=kv-j+1 from by omega,pow_succ']
           intro hy; refine ⟨(Po kv ip).after R,(Pv kv ip).after S,_,Canon.series hU hc,hT.symm ▸ Tone.refreshRich ha ht,hT.symm ▸ Tone.refreshRich hx hS,hT.symm ▸ Tone.growGale ha hx ht hS hr hq hG,reachesV P₀ A B o lℓ Pt hw hE,fun Z=>?_⟩
           have hh:= hY Z; rw [hpX kv hi hk] at hh -- define hpX for tilt
           rw [Tuck.tilted] at hh; rw [hh,(Pv kv ip).spoke,map_smul,smul_smul,jumpP wr Z hk]
     obtain ⟨R,S,G,hc,hR,hS,hD,hE,hY⟩:= ht m le_rfl hj hj
     refine ⟨R,S,G,hc,hR,hS,hD,hE,?_⟩
     funext Z
     let g:= Tuck.tilt S (gainV wr j m) (G0 m hj le_rfl); let f Z:= Chamber.parties g Z
     have hz: g Z= Chamber.cetacea f Z:= Chamber.only f g Z (fun _ _=>rfl) (Tuck.born ..) _ (Subset.refl Z)
     change _=g Z
     rw [hz]; refine Chamber.only f (G0 j le_rfl hj) Z (fun i _=> ?_) (by rw [hpX j hK le_rfl, Tuck.born]) _ (Subset.refl Z)
     unfold f g; rw [Tuck.tilted,hY]
