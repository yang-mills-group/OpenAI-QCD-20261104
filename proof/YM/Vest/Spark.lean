     reachG : ∀ i (p:Kh (A.ring (B.n k) m)) (q:Kh (A.ring (B.n k) j)), p∈ can (o m) (Mª m) i → Y.P p q ≠0 → q∈ can (o j) (Mª j) i
     reachM : ∀ i (p:Dh (A.ring (B.n k) m) 6 Iq)(q:Dh (A.ring (B.n k) j) 6 Iq), p∈spineP (o m) 6 (Mª m) i →Y.M p q ≠0 →q∈ spineP (o j) 6 (Mª j) i
lemma reachesV {j m n:ℕ} {R: Tone (Kh (A.ring (B.n k) m)) (Dh (A.ring (B.n k) m) 6 Iq) (Kh (A.ring (B.n k) j)) (Dh (A.ring (B.n k) j) 6 Iq)}{S: Tone (Kh (A.ring (B.n k) n)) (Dh (A.ring (B.n k) n) 6 Iq) (Kh (A.ring (B.n k) m)) (Dh (A.ring (B.n k) m) 6 Iq)}(hV:ReachV P₀ A B o lℓ Pt S)(hp:ReachV P₀ A B o lℓ Pt R): ReachV P₀ A B o lℓ Pt (S.after R):=by
    constructor
    · intro i p q h hQ; unfold Tone.after at hQ; dsimp only at hQ; rw [Matrix.mul_apply] at hQ; obtain ⟨a,ha,hp'⟩:= Finset.exists_ne_zero_of_sum_ne_zero hQ; exact hp.reachG _ a _ (hV.reachG _ _ a h (left_ne_zero_of_mul hp')) (right_ne_zero_of_mul hp')
    intro i p q h hQ; unfold Tone.after at hQ; dsimp only at hQ; rw [Matrix.mul_apply] at hQ; obtain ⟨a,ha,hp'⟩:= Finset.exists_ne_zero_of_sum_ne_zero hQ; exact hp.reachM _ a _ (hV.reachM _ _ a h (left_ne_zero_of_mul hp')) (right_ne_zero_of_mul hp')
