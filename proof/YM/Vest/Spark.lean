lemma roteP (hi:i<n)(he:A.level i=j0)(he':A.level (i+1)=j0)(hz:(Dⁱ).patch=Q):Canon Q.J (rank j0) (P# (i+1)).bed (P# i).bed (tuneP P₀ A X B T (i+1) he') (tuneP P₀ A X B T i he) (T! hi) (sliceL Dⁱ d'T):=by
    let h₀:=T.W.steps i hi
    have h1 : HEq (Dⁱ).land (tuneP P₀ A X B T i he):= by
        rw [show (Dⁱ).land=_ from h₀.landed]; subst j0; rfl
    have h2: HEq (Dⁱ).wing (tuneP P₀ A X B T (i+1) he'):=by subst he'; rfl
    have ht {j j':ℕ}{c f:Side}(F:Flight j j') (hu:f.val=c.val*F.L.val)(d:Towers F.patch.L)(E H:Bed)(Tg S:Train (rank j0))(b:Clip)(η ξ: ℝ)(h0: (Hypnos.Fruit.curtain su (F.visit K hu) E H d).IsSymm)(hq:F.patch=Q)(hf:j=rank j0)(hg:j'=rank j0)(hw:HEq F.wing Tg)(hv:HEq F.land S)(hp:Floor E b f η ξ)(hz:Towers.Diagonal (F.visit K hu) E H d): Canon Q.J (rank j0) E H Tg S (noteU F hu K E H d h0 Iq 6) (sliceL F hu):=by
        subst j j'; obtain rfl:=eq_of_heq hw; obtain rfl:=eq_of_heq hv; rw [← hq]; exact Canon.made K _ _ F hu d _ hp hz
    exact ht Dⁱ d'T _ _ _ _ _ _ _ _ (serenity P₀ A X B T hi) hz (congr_arg _ he') (congr_arg _ he) h2 h1 (h₀.throughoutIn.trace fp) (h₀.delta.crosses (A.next (B.n k) i)) -- use implicit sides f c
