    rw [hwq i he' hi]; unfold marchP; let p:=Tq i; let g(j:Queue p f):= beans p (wΓ i) f j; let q(j:Queue p f):=wm (i+1) m (attends p f j); let y(j:Queue p f):= g j • Tx (q j); have h: Lr i (∑ j:Queue p f,y j)=∑ j:Queue p f,Lr i (y j):=by unfold FieryQ.leaseP; rw [Massive.Lyre.stampM,sum_div]; intro j _; let P:= hQw i he' hi; exact Massive.Lyre.stockC _ _ (paintsK _ _ _ _ _ _ M₀ hAim (hi.trans_le hk) _ (tenorR P₀ A B V U W M₀ D DP δ Tq wΓ ℓ hAim a' wm hwq hWK hQw hk hi (Nat.le_step he') m _ (attends_well _ _ _ _ _ P f j hx hs) (P.was _ _ (usher _ _ _ _ _ P f j hx hs))))
    refine h.trans (sum_congr rfl fun j _=>?_); unfold y; rw [improv]; congr 1; let P:= hQw i he' hi; exact sunrays P₀ A X B T Z V U W F hp hX hc M₀ Y hh hAim (hi.trans_le hk) _ (tenorR P₀ A B V U W M₀ D DP δ Tq wΓ ℓ hAim a' wm hwq hWK hQw hk hi (Nat.le_step he') m _ (attends_well _ _ _ _ _ P f j hx hs) (P.was _ _ (usher _ _ _ _ _ P f j hx hs))) -- check formula. namespace
