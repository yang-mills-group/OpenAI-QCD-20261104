    obtain ⟨W',Yv,KFp,h1',h1l,h2',hΦ,hV,hA⟩:= read_vivid ξ★ Re Fi JQ R h1 (hr.ball.symm ▸ (Fill.cheap _ _ _ _ h2 h1.non (Real.exp_pos _).le (Real.exp_monotone (mul_le_mul_of_nonneg_right (show (7/8:ℝ) ≤ 1 from by norm_num) (fan_pos ..).le)))) w₀ (chipV S.L xᵃ) (lantern S.L xᵃ) hw hPorch.haze hO hVlt hJ hE (fan_pos ..)
    have hv:= fillF h1 h2 (by norm_num: 1/32≤ (1/16:ℝ)) (by norm_num)
    exact registered S h K B.Pq B.D pF Γ V★ κo t₁ τ.t Yv (giveWave ξ★ Re Fi JQ κo κq hW hτ hO.book hI) A⊙ hPorch h1 hv hW hτ h1' hΦ (gaunt_ge ξ★ Re Fi JQ w₀ hw _ hPorch.haze) h1l (by rw [hr.ball] at h2'; exact h2') hA hV hΓ hEta
