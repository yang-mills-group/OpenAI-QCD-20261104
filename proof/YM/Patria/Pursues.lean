    refine ⟨le_rfl,?_⟩; have h:= across P₀ A X B T V U W hX E M₀ he Y C Ht O L1 hC Θ Uv i0 Gn ξ Ξ b u2 q hYt (hPt n hδ le_rfl) (hVr n hδ le_rfl) hx hv
    have hu:(Aim).density n=transit fz.symm (Un n):= exact_cov P₀ A X B T Z V U W F hp hX hc Y hh n M₀.tip s w le_rfl
    have hy : ∀ c:Side,∀ h:c=A.ring (B.n k) n,transit h (transit h.symm (Un n)*⇑(Zs c b u2))=(Un n)*Orientation.graphs Gn Uv b u2:=by intro c h; subst c; rfl
