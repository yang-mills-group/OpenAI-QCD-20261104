lemma pilferG :∃ B:ℝ, 1 ≤ B ∧ ∀ᶠ i:ℕ in atTop,∀ (u: Massive.Averaging)(X' : Massive.UV.Label d), ‖X'‖ ≤ 1 → Ψ (Y.mark i) (PV d u i X') ≤ B*Real.exp (((d:ℝ)/2+1/16)*(Track.measure A (Y.mark i))):=by
     obtain ⟨F⟩:= hp.kept.2; obtain ⟨K,hK,hP⟩:= minster (Pt:=Pt) (x:=x) P₀ A Θ Uv ξ sym d (base d) -- binder
     have hs:∀ᶠ i:ℕ in atTop, Blazar.Wins P₀ Θ Uv i0 d (ξ d) (Fu d) (A.node i) (A.spacing i):= (eventually_ge_atTop (base d)).mono fun i hi=> ((hm.asked i).2 d (hL d i hi)).2
     have h: Tendsto Y.mark atTop atTop:= hp.ship.β_path.uv.tendsto_atTop
     refine ⟨K,hK,?_⟩; filter_upwards [h.eventually_ge_atTop (base d), h.eventually (Blazar.ahead P₀ A Θ Uv i0 d (ξ d) (Fu d) (1/16:ℝ) (by norm_num) hs)] with i hi hh u' X' Hx
     let EM:=Y.snap i; let B:=accord (Y.mesh i); let T':= F i; let p:=Y.listed i
     have hj(m)(hx:base d≤ m)(he:m≤ Y.mark i):= hp.books i m he d (hL d m hx)
     have he := Brisk.severe P₀ A X B p EM.arrange.V EM.spin EM.mu EM.weight EM.base EM.history E fork hm.worth.views EM.Y EM.stead T'.Y₁ Ht O LL T'.hY Θ Uv i0 d (hp.ship.β_path.normalized i) (base d) W' ν ξ Fu M N₀ K0 hm (base d) (hL d) T'.hv (fun r=>PV d r i) sym (hOrder d i hi) (fun m h hh=>Nat.le_trans (Nat.le_add_left _ _) (hj m h hh)) (fun m h hh=>Nat.le_trans (Nat.le_add_right _ _) (hj m h hh)) hθ hτ u' rfl hi X'
     exact he.trans (mul_le_mul (hP X' Hx) (Real.exp_le_exp.mpr (by linarith only [hh])) (Real.exp_nonneg _) (zero_le_one.trans hK))
set_option maxHeartbeats 550000 in
lemma taperBound (j:ℕ)(ht:base d ≤ j):∃ K:ℝ,0≤ K ∧ ∀ᶠ i:ℕ in atTop,∀ (u₀:Massive.Averaging)(p:Bool)(H y : Massive.UV.Label d), moored (PV d u₀ i H).val p → Fuel ((Y.series P₀ A X E LL ν).A i) Θ (Depth.Bloom Uv d) j u₀ (PV d u₀ i H) y→ ‖H‖ ≤ K*‖Massive.Poised.Sieve.dimming (Pt j).threshold (LifeT.νP P₀ A (x:=x) j) d y‖:=by
     obtain ⟨F⟩:=hp.kept.2; let R:= inflate Θ Uv d (ξ d); let V m:= LifeT.νP P₀ A (x:=x) m; let B0:=base d
     obtain ⟨W,hW,hB⟩:= Stair.Cabin.normBound (R (Pt B0)) (V B0) (fan_pos ..) d
     obtain ⟨C,K,hC,hK,hU⟩:= Stair.Cabin.wNorm d
     let Mz:=∏ m∈ Ico (base d) j, cutS P₀ A Θ Uv i0 d (ξ d) (Fu d) m
     have hM:0≤Mz:=prod_nonneg fun _ _=>cutS_light ..
     refine ⟨W*(Mz*K),mul_nonneg (zero_le_one.trans hW) (mul_nonneg hM (zero_le_one.trans hK)),?_⟩
     filter_upwards [hp.ship.β_path.uv.tendsto_atTop.eventually_ge_atTop j] with i h' u₀ p H y hℓ hT
     have hj' : j≤ Y.mark i:=h'; have hi:= ht.trans hj'
     have hp': moored H.val p:=by
          have hm: sym.parity d (PV d u₀ i H)=PV d u₀ i (sym.parity d H):=(hOrder d i hi).parityO u₀ H
          apply (moored_iff sym _ p).2 -- args
          apply (PV d u₀ i).injective; rw [map_smul,← hm,(moored_iff sym _ p).1 hℓ]
     let EM:=Y.snap i; let B:=accord (Y.mesh i); let T':= F i; let p':=Y.listed i
     have hj(m)(hx:base d≤ m)(he:m≤ Y.mark i):= hp.books i m he d (hL d m hx)
     have he := Brisk.meetsF P₀ A X B p' EM.arrange.V EM.spin EM.mu EM.weight EM.base EM.history E fork hm.worth.views EM.Y EM.stead T'.Y₁ Ht O LL T'.hY Θ Uv i0 d (hp.ship.β_path.normalized i) (base d) W' ν ξ Fu M N₀ K0 hm (base d) (hL d) T'.hv (fun r=>PV d r i) sym (hOrder d i hi) (fun m h hh=>Nat.le_trans (Nat.le_add_left _ _) (hj m h hh)) (fun m h hh=>Nat.le_trans (Nat.le_add_right _ _) (hj m h hh)) hθ hτ rfl hi H y p hp' j ht hj' u₀ hT
     apply (hB H).trans; rw [mul_assoc,mul_assoc]; refine mul_le_mul_of_nonneg_left (he.trans (mul_le_mul_of_nonneg_left ?_ hM)) (zero_le_one.trans hW); exact (hU (Pt j).threshold (LifeT.νP P₀ A (x:=x) j) _).2

