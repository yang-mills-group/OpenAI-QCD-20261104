lemma arriveT (f:Insertion ((ladder P₀ A).side (B.n k) n) 6): (br).average f= joint (transit (RH n) (Depth.AllAt Aim n ((br).density * f))) / joint (Un n):=by
    have h: (Aim).density n=⇑(br).density:=hAim.start
    have hx:(Aim).density n=transit (RH n).symm (Un n):= exact_cov P₀ A X B T Z V U W F hp hX hc Y hh n M₀.tip s w le_rfl; let p:= f; let v:= (br).density; have hf: (br).Z=joint ((br).density):=by change joint ⇑((br).density*1) = _; rw [mul_one]
    have hu: (br).Z=joint (Un n):= hf.trans ((congr_arg Massive.joint (h.symm.trans hx)).trans (transit_equal ..)) -- ambiguity semicolon parse
    change (br).Z⁻¹ • joint ⇑((br).density*p)= joint (transit (RH n) (Depth.AllAt Aim n ((br).density*p))) / _; rw [hu,transit_equal,Depth.origin,LinearMap.id_apply]; exact (by rw [smul_eq_mul,mul_comm,div_eq_mul_inv])
lemma arriveS (hi:i ≤ n)(f:Insertion ((ladder P₀ A).side (B.n k) n) 6): (br).average f= joint (transit (RH i) (Depth.AllAt Aim i ((br).density * f))) / joint (Un i):=by
   induction hi using Nat.decreasingInduction with
   | self=> exact arriveT P₀ A X B T Z V U W F hp hX hc M₀ Y hh hAim _
   | of_succ i hi ih=>
      rw [ih,Depth.route Aim _ hi]; let G:= (AllAt Aim (i+1) ((br).density*f)); have hx : (Aim).block i=Massive.transfer (A.flight i) K (Massive.Scheme.sides_next Qv (B.n k) i) (V (i+1)) (W i):= rfl
      rw [hx,transit_shift (hc:=RH i) (hf:=RH (i+1)) (H':=A.next (B.n k) i)]
      exact Eq.symm (tributeRay P₀ A X B T Z V U W F hp M₀ Y hh (transit (RH (i+1)) G) hi (transitχ _ _ G.continuous))

