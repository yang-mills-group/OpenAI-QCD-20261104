lemma westboundS (p:ℕ→Massive.UV.Label Gn) (i:ℕ)(hB:b₀ ≤ i)(hf:∀ m,b₀ ≤ m→ m < i → Wt m (p m) ≤ Kzv m * Wt (m+1) (p (m+1))): Wt b₀ (p b₀) ≤ (∏ m∈ Finset.Ico b₀ i, Kzv m)*Wt i (p i):=by
    induction i, hB using Nat.le_induction with
    | base=> simp
    | succ i hi ih=>
       rw [Finset.prod_Ico_succ_top hi,mul_assoc]; apply le_trans (ih (fun i' h he=> hf i' h (by omega))); apply mul_le_mul_of_nonneg_left (hf _ hi (by omega)); exact prod_nonneg fun _ _=>cutS_light ..
include hm hQ hPt hPk hTol hYt hL' hAim hpΘ hp he hh hC
lemma tabulateF {u : Massive.Averaging} (hx:m'=b₀)(hb:b₀ ≤ n)(X':Massive.UV.Label Gn)(p:Bool)(h:moored X'.val p): Wt n (Q' u X') ≤ Wt b₀ X'* ΕΓ n:=by
    subst m'; by_cases he':X'=0; · rw [he', map_zero, show Wt b₀ 0=0 from Stair.wealth_zero _ _ _ rfl, show Wt n 0=0 from Stair.wealth_zero _ _ _ rfl, zero_mul] 
    have hz:= actSound P₀ A X E Ht O L1 Θ Uv i0 Gn W' θu ξa F' M N' K0 hm b₀ hL'; let pH:= hm.worth.head
    obtain ⟨h,p,hP,h1,h2,hY,hQ⟩:= harvestAvg (u:=u) P₀ A X B T Z V U W F hp pH.funded pH.calm E M₀ he Y hh C Ht O L1 hC Θ Uv i0 Gn (ξa Gn) (F' Gn) X' p b₀ sym Q' _ _ hAim hz hQ hTol hPt hb hpΘ hPk hYt h he'
    rw [← hP]; exact Blazar.voyage_l P₀ A Θ Uv i0 Gn (ξa Gn) (F' Gn) p b₀ n (wealth_ge ..) hb (le_of_eq (congr_arg _ h1)) (fun j h hi=> slight _ _ _ _ _ _ _ _ j _ _ (hQ j h hi).1)
lemma severe (u:Massive.Averaging) (hx:m'=b₀)(hb:b₀ ≤ n)(Vg:Massive.UV.Label Gn): Wt n (Q' u Vg) ≤ (Wt b₀ (facing sym true Vg)+ Wt b₀ (facing sym false Vg))*ΕΓ n:=by
    nth_rw 1 [Depth.revelation sym Vg]; rw [map_add,add_mul]; exact (Stair.wealth_plus ..).trans (add_le_add (tabulateF P₀ A X B T Z V U W F hp E M₀ he Y hh C Ht O L1 hC Θ Uv i0 Gn hAim b₀ W' θu ξa F' M N' K0 hm m' hL' hYt Q' sym hQ hPt hPk hTol hpΘ hx hb _ true (fronting sym _ true)) (tabulateF P₀ A X B T Z V U W F hp E M₀ he Y hh C Ht O L1 hC Θ Uv i0 Gn hAim b₀ W' θu ξa F' M N' K0 hm m' hL' hYt Q' sym hQ hPt hPk hTol hpΘ hx hb _ false (fronting sym _ false)))
lemma meetsF (hx:m'=b₀)(hb:b₀ ≤ n)(X' y:Massive.UV.Label Gn)(p:Bool)(h:moored X'.val p)(i:ℕ)(ht:b₀ ≤ i)(hq:i ≤ n)(u: Massive.Averaging) (hY:Fuel (covering (n:=n) (k:=k) P₀ A B V U W M₀.tip s w) Θ (Bloom Uv Gn) i u (Q' u X') y): Wt b₀ X' ≤ (∏ m∈ Finset.Ico b₀ i, Kzv m)*Wt i y:=by
    subst m'; by_cases he':X'=0; · rw [he',show Wt b₀ 0=0 from Stair.wealth_zero _ _ _ rfl]; exact mul_nonneg (prod_nonneg fun m _=>cutS_light ..) (wealth_ge ..)
    have hz:= actSound P₀ A X E Ht O L1 Θ Uv i0 Gn W' θu ξa F' M N' K0 hm b₀ hL'; let pH:= hm.worth.head
    obtain ⟨h,pT,hP,h1,h2,HpV,hQ⟩:= harvestAvg (u:=u) P₀ A X B T Z V U W F hp pH.funded pH.calm E M₀ he Y hh C Ht O L1 hC Θ Uv i0 Gn (ξa Gn) (F' Gn) X' p b₀ sym Q' _ _ hAim hz hQ hTol hPt hb hpΘ hPk hYt h he'

    have hF:hAim=hAim:= rfl
    -- use stadium in original

    rw [← h1]; have he :y=pT i:=Canvas.consensus Θ 0 _ hY _ ?hw; rotate_left
    · exact existT P₀ A X B T Z V U W F hp pH.funded pH.calm E M₀ he Y hh C Ht O L1 hC Θ Uv i0 Gn (ξa Gn) (F' Gn) (hz.paid i ht) (hPt i ht hq) (pT i) hq _ 0 p ⟨hq,HpV i ht hq 0⟩
    rw [he]; apply westboundS P₀ A Θ Uv i0 Gn b₀ ξa F' pT i ht; exact fun m hm hv=> (hQ m hm (hv.trans_le hq)).2

omit hm hQ hPt hPk hTol hYt hL' hAim hpΘ hp he hh hC
